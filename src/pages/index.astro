---

import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Adsterra728x90 from "@/components/adsterra728x90.astro";
import Pagination from "@/components/Pagination.astro";
import { projects } from "@/data/projects";

const postModules = import.meta.glob("./posts/*.astro", { eager: true });
const posts = Object.values(postModules)
  .map((mod: any) => mod.post)
  .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const featured = posts[0];
const restPosts = posts.slice(1);

const pageSize = 9;
const totalPages = Math.ceil(restPosts.length / pageSize);
const currentPage = 1;
const pagePosts = restPosts.slice(0, pageSize);

const latestProjects = projects.slice(-3).reverse();

type CategoryItem = {
  name: string;
  faClass: string;
  href: string;
};

const categories: CategoryItem[] = [
  { name: "أندرويد", faClass: "fa-brands fa-android", href: "/category/أندرويد/" },
  { name: "برمجة", faClass: "fa-solid fa-code", href: "/category/برمجة/" },
  { name: "بيئة سطح المكتب", faClass: "fa-solid fa-desktop", href: "/category/بيئة سطح المكتب/" },
  { name: "ذكاء اصطناعي", faClass: "fa-solid fa-robot", href: "/category/ذكاء اصطناعي/" },
  { name: "برامج", faClass: "fa-solid fa-cubes", href: "/category/برامج/" },
  { name: "لينكس", faClass: "fa-brands fa-linux", href: "/category/لينكس/" },
  { name: "ألعاب وترفيه", faClass: "fa-solid fa-gamepad", href: "/category/ألعاب وترفيه/" },
  { name: "مقالات", faClass: "fa-solid fa-newspaper", href: "/category/مقالات/" },
];
---

<BaseLayout
  title="منصة أخبار المشاريع المفتوحة المصدر"
  description="مصدر إكس هي منصتك العربية الأولى لأخبار المشاريع مفتوحة المصدر والتقنيات الحديثة. تابع أحدث الأخبار، التحليلات، والمراجعات في عالم المصادر المفتوحة."
  keywords={[
    "مصدر إكس",
    "أخبار المصادر المفتوحة",
    "تقنيات حديثة",
    "برمجيات مفتوحة المصدر",
    "تكنولوجيا المعلومات",
    "تطوير البرمجيات",
    "لينكس",
    "برمجة",
    "المشاريع المفتوحة المصدر",
  ]}
  canonical="/"
  ogType="website"
  preloadImage={featured?.thumbnail}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "NewsMediaOrganization",
      name: "مصدر إكس",
      url: "https://www.masdarx.com",
      logo: "https://www.masdarx.com/favicon.svg",
      description:
        "منصة عربية متخصصة في أخبار البرمجيات مفتوحة المصدر والتقنيات الحديثة",
      inLanguage: "ar",
      areaServed: {
        "@type": "Country",
        name: "العالم العربي",
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: "https://www.masdarx.com/search?q={search_term_string}",
        },
        "query-input": "required name=search_term_string",
      },
    })}
  />

  <section class="bg-gradient-to-br from-navy via-navy-600 to-navy-800 dark:from-zinc-900 dark:via-zinc-800 dark:to-[#0C0C0C] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="max-w-3xl mx-auto text-center">
        <span
          class="inline-block px-4 py-1.5 text-xs font-bold font-heading tracking-wider uppercase bg-accent/20 text-accent rounded-full mb-6 border border-accent/30"
        >
          مصدر إكس
        </span>
        <h1
          class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-6 leading-loose text-white" style="line-height: 1.5;"
        >
          أخبار المشاريع المفتوحة المصدر بالعربية
        </h1>
        <p
          class="font-body text-lg sm:text-xl text-white/70 max-w-xl mx-auto mb-8 leading-relaxed"
        >
          تابع آخر أخبار المشاريع مفتوحة المصدر، التوزيعات، والأدوات التقنية —
          كل ما تحتاجه في مكان واحد.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/about/"
            class="inline-flex items-center gap-2 px-6 py-3 font-body text-sm font-medium bg-accent text-navy dark:text-zinc-900 rounded-full hover:shadow-glow-accent transition-colors no-underline"
          >
            تعرّف علينا
          </a>
          <a
            href="#recent-articles"
            class="inline-flex items-center gap-2 px-6 py-3 font-body text-sm font-medium bg-white/10 text-white rounded-full border border-white/20 hover:bg-white/20 transition-colors no-underline"
          >
            تصفّح المقالات
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-navy-50 dark:bg-zinc-900 border-b border-navy-100 dark:border-zinc-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="flex items-center justify-center gap-3 px-6 py-5 bg-white dark:bg-[#0C0C0C] rounded-xl border border-navy-100 dark:border-zinc-700 hover:border-accent dark:hover:border-zinc-500 hover:shadow-glow transition-all no-underline group text-center"
          >
            <i class={`${cat.faClass} text-2xl text-navy dark:text-white`} />
            <span class="font-body text-lg font-semibold text-navy dark:text-white">{cat.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div id="homepage-ad-slot" class="hidden my-6 w-full justify-center px-4" aria-hidden="true">
    <Adsterra728x90 />
  </div>

  <script>
    const homepageAdSlot = document.getElementById("homepage-ad-slot");

    if (homepageAdSlot) {
      const revealHomepageAd = () => {
        if (!homepageAdSlot.querySelector("iframe")) return false;

        homepageAdSlot.classList.remove("hidden");
        homepageAdSlot.classList.add("flex");
        homepageAdSlot.removeAttribute("aria-hidden");
        return true;
      };

      if (!revealHomepageAd()) {
        const homepageAdObserver = new MutationObserver(() => {
          if (revealHomepageAd()) homepageAdObserver.disconnect();
        });
        homepageAdObserver.observe(homepageAdSlot, { childList: true, subtree: true });
      }
    }
  </script>

  {featured ? (
      <section class="bg-white dark:bg-[#0C0C0C] pb-10 sm:pb-14 pt-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          
          <div class="flex items-center gap-3 mb-8" id="recent-articles">
            <h2 class="font-heading text-2xl font-bold text-navy dark:text-white">أحدث المقالات</h2>
            <a
              href="/page/2/"
              class="mr-auto font-body text-sm text-navy-400 dark:text-zinc-500 hover:text-accent dark:hover:text-white transition-colors no-underline"
            >
              عرض الكل &larr;
            </a>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <a
              href={`/posts/${featured.slug}/`}
              class="block no-underline group"
            >
            {featured.thumbnail && (
              <div class="bg-navy-50 dark:bg-zinc-800 rounded-xl overflow-hidden">
                <img
                  src={featured.thumbnail}
                  alt={featured.title}
                  width="720"
                  height="405"
                  class="w-full h-auto"
                  fetchpriority="high"
                />
              </div>
            )}
            </a>
            <div>
              <div class="flex flex-wrap gap-2 mb-4">
                {(Array.isArray(featured.category) ? featured.category : [featured.category]).map((cat: string) => (
                  <a
                    href={`/category/${cat}/`}
                    class="inline-block px-3 py-1 text-xs font-bold font-heading text-white bg-navy rounded-full hover:bg-accent hover:text-navy dark:hover:bg-zinc-600 transition-colors no-underline"
                  >
                    {cat}
                  </a>
                ))}
              </div>
              <a
                href={`/posts/${featured.slug}/`}
                class="block no-underline group"
              >
                <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-extrabold text-navy dark:text-white mb-4 leading-tight group-hover:text-accent dark:group-hover:text-zinc-300 transition-colors">
                  {featured.title}
                </h2>
              </a>
              <p class="font-body text-base text-navy-600 dark:text-zinc-400 mb-4 leading-relaxed line-clamp-3">
                {featured.description}
              </p>
              <div class="flex items-center gap-2 text-sm text-navy-400 dark:text-zinc-500 font-body mb-4">
                <a href={`/author/${featured.author}/`} class="hover:text-accent dark:hover:text-white transition-colors no-underline">{featured.author}</a>
                <span>•</span>
                <span>{featured.date}</span>
              </div>
              {featured.tags && featured.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {featured.tags.map((tag: string) => (
                    <a
                      href={`/tags/${tag}/`}
                      class="inline-block px-3 py-1 text-xs font-body text-navy-600 dark:text-zinc-400 bg-navy-50 dark:bg-zinc-800 rounded-full hover:bg-accent/20 dark:hover:bg-zinc-700 transition-colors no-underline"
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    ) : null}

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        pagePosts.map((post) => (
          <ArticleCard
            title={post.title}
            description={post.description}
            category={post.category}
            author={post.author}
            date={post.date}
            tags={post.tags}
            slug={post.slug}
            thumbnail={post.thumbnail}
          />
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <Pagination currentPage={currentPage} totalPages={totalPages} />
      )
    }
  </section>

  <section class="bg-navy-50 dark:bg-zinc-900 border-t border-navy-100 dark:border-zinc-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center gap-3 mb-8">
        <h2 class="font-heading text-2xl font-bold text-navy dark:text-white">آخر المشاريع مفتوحة المصدر</h2>
        <a href="/projects/" class="mr-auto font-body text-sm text-navy-400 dark:text-zinc-500 hover:text-accent dark:hover:text-white transition-colors no-underline">عرض الكل &larr;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestProjects.map((project) => (
          <div class="bg-white dark:bg-[#0C0C0C] rounded-xl border border-navy-100 dark:border-zinc-800 shadow-sm overflow-hidden hover:shadow-glow hover:border-accent/50 transition-all">
            <a href={`/projects/${project.slug}/`} class="block no-underline">
              {project.thumbnail && (
                <div class="bg-navy-50 dark:bg-zinc-800 overflow-hidden">
                  <img
                    src={project.thumbnail}
                    alt={project.name}
                    width="400"
                    height="225"
                    class="w-full h-auto"
                    loading="lazy"
                  />
                </div>
              )}
            </a>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <a
                  href={`/projects/category/${Array.isArray(project.category) ? project.category[0] : project.category}/`}
                  class="px-2 py-1 text-xs font-bold font-heading text-white bg-navy rounded-full hover:bg-accent hover:text-navy dark:hover:bg-zinc-600 transition-colors no-underline"
                >
                  {Array.isArray(project.category) ? project.category[0] : project.category}
                </a>
                <span class="text-xs font-body text-navy-400 dark:text-zinc-500">{project.language}</span>
              </div>
              <a href={`/projects/${project.slug}/`} class="block no-underline">
                <h3 class="font-heading text-lg font-bold text-navy dark:text-white mb-2 hover:text-accent dark:hover:text-zinc-300 transition-colors">
                  {project.name}
                </h3>
              </a>
              <p class="font-body text-sm text-navy-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                {project.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
