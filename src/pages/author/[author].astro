---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../posts/*.astro", { eager: true });
  const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

  const authors = [...new Set(allPosts.map((p) => p.author))];
  return authors.map((author) => ({
    params: { author },
    props: { author, posts: allPosts },
  }));
}

export interface Props {
  author: string;
  posts: any[];
}

const { author, posts: allPosts } = Astro.props;
const pageSize = 9;
const filteredPosts = allPosts.filter((p) => p.author === author);
const totalPages = Math.ceil(filteredPosts.length / pageSize);
const pagePosts = filteredPosts.slice(0, pageSize);
const basePath = `/author/${author}/page`;

const authorInfo: Record<string, { bio: string; image: string; github: string; linkedin: string; twitter: string }> = {
  "طلال عمران": {
    bio: "مطور ومبرمج شغوف بالتكنولوجيا والمصادر المفتوحة. أحب مشاركة المعرفة وكتابة المقالات التقنية باللغة العربية.",
    image: "/images/talal.png",
    github: "https://github.com/talalemran",
    linkedin: "https://www.linkedin.com/in/talal-emran/",
    twitter: "https://twitter.com/talalemran",
  },
};

const info = authorInfo[author];
---

<BaseLayout
  title={author}
  description={`جميع مقالات ${author} على مصدر إكس`}
  keywords={[author, "كتّاب", "مصادر مفتوحة"]}
  canonical={`/author/${author}/`}
  ogType="website"
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="mb-6 text-sm font-body text-navy-400 dark:text-zinc-500">
      <a href="/" class="hover:text-accent dark:hover:text-white transition-colors no-underline">الرئيسية</a>
      <span class="mx-2">/</span>
      <span class="text-navy dark:text-white">{author}</span>
    </nav>

    {info && (
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 mb-10 p-6 bg-white dark:bg-zinc-800 border border-navy-100 dark:border-zinc-700 rounded-xl">
        <img
          src={info.image}
          alt={author}
          class="w-32 h-32 rounded-full object-cover border-4 border-navy dark:border-zinc-600"
          loading="eager"
        />
        <div class="text-center sm:text-right">
          <h1 class="font-heading text-3xl font-extrabold text-navy dark:text-white mb-2">{author}</h1>
          <p class="font-body text-navy-600 dark:text-zinc-300 leading-relaxed mb-4">{info.bio}</p>
          <p class="font-body text-sm text-navy-400 dark:text-zinc-500 mb-4">{filteredPosts.length} مقال</p>
          <div class="flex justify-center sm:justify-start gap-4">
            <a href={info.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-navy-50 dark:bg-zinc-700 rounded-lg transition-colors no-underline text-navy dark:text-white text-sm font-body">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
            <a href={info.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-navy-50 dark:bg-zinc-700 rounded-lg transition-colors no-underline text-navy dark:text-white text-sm font-body">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href={info.twitter} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 bg-navy-50 dark:bg-zinc-700 rounded-lg transition-colors no-underline text-navy dark:text-white text-sm font-body">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X
            </a>
          </div>
        </div>
      </div>
    )}

    {!info && (
      <h1 class="font-heading text-3xl font-extrabold text-navy dark:text-white mb-2">
        الكاتب: {author}
      </h1>
      <p class="font-body text-navy-400 dark:text-zinc-500 mb-8">{filteredPosts.length} مقال</p>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        pagePosts.map((post) => (
          <ArticleCard
            title={post.title}
            description={post.description}
            category={post.category}
            author={post.author}
            date={post.date}
            tags={post.tags}
            slug={post.slug}
            thumbnail={post.thumbnail}
          />
        ))
      }
    </div>

    {totalPages > 1 && (
      <Pagination currentPage={1} totalPages={totalPages} basePath={basePath} />
    )}
  </section>
</BaseLayout>
