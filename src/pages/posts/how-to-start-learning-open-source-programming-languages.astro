---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "how-to-start-learning-open-source-programming-languages",
    title: "كيف تبدأ تعلم لغات البرمجة مفتوحة المصدر: خطة عملية من الصفر",
    metaTitle: "كيف تبدأ تعلم لغات البرمجة مفتوحة المصدر: خطة عملية",
    description:
        "دليل عملي للبدء بتعلم لغات البرمجة مفتوحة المصدر من الصفر: كيف تختار لغتك الأولى، وتجهّز بيئة العمل، وتتبع خطة 90 يومًا، وتقرأ الكود المفتوح، وتقدّم أول مساهمة لك على GitHub.",
    keywords: [
        "تعلم لغات البرمجة مفتوحة المصدر",
        "كيف أبدأ تعلم البرمجة",
        "أفضل لغة برمجة للمبتدئين",
        "تعلم Python",
        "تعلم JavaScript",
        "المساهمة في المشاريع مفتوحة المصدر",
        "خطة تعلم البرمجة",
        "تعلم البرمجة مجانًا",
    ],
    category: "برمجة",
    author: "طلال عمران",
    date: "15 أكتوبر 2026",
    pubDate: new Date("2026-10-15"),
    tags: ["تعلم البرمجة", "مفتوح المصدر", "Python", "GitHub", "للمبتدئين"],
    thumbnail: "/images/how-to-start-learning-open-source-programming-languages.webp",
};

const tocItems = [
    { id: "why-open-source-languages", label: "لماذا تبدأ بلغات مفتوحة المصدر تحديدًا؟" },
    { id: "define-your-goal", label: "الخطوة الأولى: حدّد هدفك قبل أن تختار لغة" },
    { id: "choose-first-language", label: "اختيار لغتك الأولى: ست خيارات وكيف تقرر" },
    { id: "setup-environment", label: "تجهيز بيئة العمل: ما تحتاجه فعلًا" },
    { id: "core-concepts", label: "المفاهيم المشتركة التي تنتقل معك بين كل اللغات" },
    { id: "ninety-day-plan", label: "خطة تعلم من 90 يومًا" },
    { id: "learn-by-building", label: "تعلّم بالبناء: أفكار مشاريع حسب مستواك" },
    { id: "reading-open-source-code", label: "اقرأ الكود المفتوح: أفضل مدرسة مجانية" },
    { id: "first-contribution", label: "أول مساهمة لك في مشروع مفتوح المصدر" },
    { id: "arabic-and-english", label: "بين العربية والإنجليزية: كيف توازن؟" },
    { id: "ai-as-tutor", label: "الذكاء الاصطناعي: معلّم جيد وكاتب كود خطير" },
    { id: "common-mistakes", label: "أخطاء شائعة تُضيّع شهورًا من وقتك" },
    { id: "comparison-table", label: "جدول: الهدف واللغة وأول مشروع والمصدر الرسمي" },
    { id: "external-resources", label: "مصادر خارجية للتعلم" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            أغلب من يفكر في تعلم البرمجة يعلق في مرحلة واحدة: الاختيار.
            لغة كذا أم كذا؟ دورة هذه أم تلك؟ يقضي أسابيع في المقارنة،
            وحين يبدأ أخيرًا يكون قد استنزف حماسه الأول. والمفارقة أن
            الفرق بين الخيارات الجيدة أصغر بكثير من الفرق بين من يبدأ
            فعلًا ومن يبقى يقارن.
        </p>

        <p>
            هذا الدليل يختصر عليك الطريق: كيف تختار لغتك الأولى من بين
            اللغات مفتوحة المصدر، وكيف تجهّز بيئتك، وخطة عملية من 90
            يومًا، وكيف تقرأ كود المشاريع المفتوحة وتصل إلى أول مساهمة
            حقيقية لك.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {
                    tocItems.map((item) => (
                        <li>
                            <a
                                href={`#${item.id}`}
                                class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ol>
        </nav>

        <h2 id="why-open-source-languages">
            لماذا تبدأ بلغات مفتوحة المصدر تحديدًا؟
        </h2>

        <p>
            <img
                src="/images/articles/how-to-start-learning-open-source-programming-languages/01.webp"
                alt="متعلم مبتدئ يكتب أول سطور كود على حاسوب محمول"
                width="1200"
                height="655"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            معظم اللغات التي تُدرَّس اليوم للمبتدئين مفتوحة المصدر أصلًا:
            Python وJavaScript وGo وRust وغيرها. وهذا يمنحك مزايا عملية
            مباشرة منذ اليوم الأول:
        </p>

        <ul>
            <li>
                <strong>التعلم بلا كلفة</strong>: اللغة نفسها ومترجمها
                وأدواتها الأساسية مجانية، فلا تحتاج ترخيصًا ولا اشتراكًا
                لتبدأ
            </li>
            <li>
                <strong>الكود أمامك</strong>: يمكنك فتح الشفرة المصدرية
                للمكتبات والأدوات التي تستخدمها، وقراءة كيف كُتبت فعلًا
                لا كيف يُشرح عنها
            </li>
            <li>
                <strong>مجتمع جاهز</strong>: لكل لغة منتديات ومستودعات
                وأدلة رسمية مفتوحة، وغالبًا مشكلتك التي تواجهها واجهها
                غيرك وكتب حلها
            </li>
            <li>
                <strong>باب مفتوح للمساهمة</strong>: حين تتقن الأساسيات
                تستطيع أن تساهم في المشاريع نفسها، وهذه من أسرع الطرق
                لبناء سمعة مهنية حقيقية
            </li>
        </ul>

        <h2 id="define-your-goal">
            الخطوة الأولى: حدّد هدفك قبل أن تختار لغة
        </h2>

        <p>
            السؤال الصحيح ليس "ما أفضل لغة؟" بل "ماذا أريد أن أصنع؟".
            اللغة أداة، والأداة تُختار بحسب العمل. اسأل نفسك أيًّا من
            هذه الأهداف أقرب إليك:
        </p>

        <ul>
            <li>مواقع وتطبيقات ويب يراها الناس في المتصفح</li>
            <li>تحليل بيانات أو تعلم آلي وذكاء اصطناعي</li>
            <li>أتمتة مهام مملة على جهازك أو في عملك</li>
            <li>خدمات خلفية وبنية تحتية سحابية</li>
            <li>برمجيات أنظمة وأداء عالٍ</li>
            <li>تطبيقات أندرويد</li>
        </ul>

        <p>
            إن لم يكن لديك هدف واضح بعد، فهذا طبيعي تمامًا، وستجد في
            القسم التالي لغة تناسب هذه الحالة أيضًا.
        </p>

        <h2 id="choose-first-language">
            اختيار لغتك الأولى: ست خيارات وكيف تقرر
        </h2>

        <h3>Python: الخيار الأكثر أمانًا للتائه</h3>

        <p>
            إن لم تحدد هدفك، أو كنت تريد الدخول للذكاء الاصطناعي وتحليل
            البيانات والأتمتة، فهي نقطة بداية ممتازة. صياغتها قريبة من
            اللغة الإنجليزية العادية، وأخطاؤها تُقرأ بوضوح، والمجتمع حولها
            ضخم. وقت كتابة هذه السطور، الإصدار المستقر هو سلسلة 3.14،
            وتأكد من الإصدار الحالي من الموقع الرسمي.
        </p>

        <h3>JavaScript: إن كان هدفك الويب</h3>

        <p>
            اللغة الوحيدة التي تعمل أصلًا داخل المتصفح. تتعلمها وترى
            نتيجتها فورًا على الصفحة، وهذا يعطي دافعًا نفسيًا قويًا
            للمبتدئين. ويمكنك لاحقًا استخدامها في الخلفية عبر Node.js.
            تحتاج مع تعلمها أن تتعلم HTML وCSS كذلك.
        </p>

        <h3>Go: إن كنت تميل للخدمات الخلفية والسحابة</h3>

        <p>
            لغة بسيطة جدًا في بنيتها، ومن اللغات التي كُتبت بها أدوات
            كبرى في عالم الحاويات والسحابة. قليلة الكلمات المفتاحية، ما
            يجعل تعلمها سريعًا نسبيًا، وتتميز بسرعة التجميع.
        </p>

        <h3>Rust: للأداء والأمان وتحمّل منحنى أصعب</h3>

        <p>
            تحصل على أداء قريب من لغات الأنظمة مع أمان للذاكرة، لكن
            مفاهيمها (الملكية والاستعارة) تحتاج صبرًا. ليست الأنسب لأول
            لغة في حياتك البرمجية إلا إن كنت مهتمًا فعلًا بالأنظمة، لكنها
            مجزية جدًا لمن يصل إليها بعد أساس جيد.
        </p>

        <h3>Java وKotlin: للتطبيقات المؤسسية وأندرويد</h3>

        <p>
            Java راسخة في الأنظمة المؤسسية، وKotlin اللغة المفضلة
            لتطبيقات أندرويد. كلتاهما أكثر تفصيلًا في الكتابة من Python،
            لكنهما تعلّمانك الصرامة في الأنواع، وهذا مفيد على المدى
            البعيد.
        </p>

        <h3>C: لمن يريد أن يفهم الحاسوب من الداخل</h3>

        <p>
            ليست الخيار الأسهل، لكنها تكشف لك كيف تعمل الذاكرة والمؤشرات
            فعلًا. كثير من المقررات الجامعية الشهيرة تبدأ بها لهذا
            السبب. اختَرها إن كان فضولك تقنيًا عميقًا، لا إن كان هدفك
            الوصول لوظيفة سريعًا.
        </p>

        <p>
            القاعدة التي تلخص كل ما سبق: <strong>لا يوجد اختيار مدمّر</strong>.
            المفاهيم الأساسية تنتقل بين اللغات، ومن يتقن لغة واحدة جيدًا
            يتعلم الثانية في وقت أقصر بكثير.
        </p>

        <h2 id="setup-environment">تجهيز بيئة العمل: ما تحتاجه فعلًا</h2>

        <p>
            لا تحتاج حاسوبًا غاليًا ولا إعدادًا معقدًا. الأساسيات التي
            ستستخدمها يوميًا:
        </p>

        <ul>
            <li>
                <strong>نظام تشغيل مناسب</strong>: لينكس وماك وويندوز كلها
                تصلح. على ويندوز يمكنك استخدام WSL لتحصل على بيئة لينكس
                داخل النظام، وهذا مفيد لأن أغلب الأدلة تفترض بيئة شبيهة
                بيونكس
            </li>
            <li>
                <strong>محرر أكواد</strong>: VS Code أو نسخته المفتوحة
                بالكامل VSCodium، وكلاهما يدعم أغلب اللغات بإضافات مجانية
            </li>
            <li>
                <strong>الطرفية (Terminal)</strong>: ستحتاج أوامر قليلة
                فقط في البداية: التنقل بين المجلدات وتشغيل برنامجك
            </li>
            <li>
                <strong>Git وحساب على GitHub</strong>: تعلّمهما من الأسبوع
                الأول، فهما سيحفظان مشاريعك ويفتحان لك باب المساهمة
                لاحقًا
            </li>
        </ul>

        <p>
            نصيحة: أنشئ مجلدًا واحدًا لكل مشروع تعلم، وابدأ كل مشروع
            بمستودع Git. هذه العادة وحدها تجعل أعمالك موثّقة ومرتبة
            تلقائيًا، وتصبح لاحقًا معرض أعمالك.
        </p>

        <h2 id="core-concepts">
            المفاهيم المشتركة التي تنتقل معك بين كل اللغات
        </h2>

        <p>
            مهما اخترت، ستتعلم الأفكار نفسها بنحو مختلف. ركّز عليها
            لا على تفاصيل اللغة:
        </p>

        <ul>
            <li><strong>المتغيرات وأنواع البيانات</strong>: كيف تخزّن الأرقام والنصوص والقيم المنطقية</li>
            <li><strong>التحكم بالتدفق</strong>: الشروط والحلقات، أي كيف يتخذ البرنامج قرارات ويكرر عملًا</li>
            <li><strong>الدوال</strong>: تقسيم العمل لقطع صغيرة قابلة لإعادة الاستخدام</li>
            <li><strong>هياكل البيانات</strong>: القوائم والقواميس والمجموعات، ومتى تستخدم كلًا منها</li>
            <li><strong>التعامل مع الأخطاء</strong>: كيف تقرأ رسالة الخطأ وتتتبع سببها</li>
            <li><strong>الملفات والمدخلات</strong>: قراءة البيانات وكتابتها</li>
            <li><strong>الاختبار</strong>: كتابة اختبارات بسيطة تتحقق أن كودك يعمل كما تتوقع</li>
        </ul>

        <p>
            ومهارة واحدة تتفوق على بقية المفاهيم في الأهمية: قراءة رسالة
            الخطأ. المبتدئ يخاف منها، والمحترف يعتبرها أول دليل. تعوّد أن
            تقرأ آخر سطر في الرسالة أولًا ثم ترجع للأعلى.
        </p>

        <h2 id="ninety-day-plan">خطة تعلم من 90 يومًا</h2>

        <p>
            الخطة التالية مقترحة وليست قدرًا. عدّل أزمنتها بحسب وقتك،
            لكن احتفظ بتسلسلها: أساسيات، ثم مشروع، ثم مساهمة. الوقت
            اليومي الواقعي لأغلب الناس بين نصف ساعة وساعتين، والانتظام
            أهم من طول الجلسة.
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المرحلة</th>
                        <th class="px-4 py-2 font-semibold">المدة</th>
                        <th class="px-4 py-2 font-semibold">الهدف</th>
                        <th class="px-4 py-2 font-semibold">المخرج المطلوب</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">1. التأسيس</td>
                        <td class="px-4 py-2">الأسبوعان 1-2</td>
                        <td class="px-4 py-2">تجهيز البيئة وتعلم المتغيرات والشروط والحلقات</td>
                        <td class="px-4 py-2">برنامج بسيط يعمل ومرفوع على GitHub</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">2. الأساسيات</td>
                        <td class="px-4 py-2">الأسابيع 3-6</td>
                        <td class="px-4 py-2">الدوال وهياكل البيانات والملفات والأخطاء</td>
                        <td class="px-4 py-2">ثلاثة برامج صغيرة مختلفة الفكرة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">3. المشروع</td>
                        <td class="px-4 py-2">الأسابيع 7-10</td>
                        <td class="px-4 py-2">بناء مشروع واحد أكبر من البداية للنهاية</td>
                        <td class="px-4 py-2">مشروع موثّق بملف README واضح</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">4. المساهمة</td>
                        <td class="px-4 py-2">الأسابيع 11-13</td>
                        <td class="px-4 py-2">قراءة كود مفتوح وتقديم أول مساهمة</td>
                        <td class="px-4 py-2">طلب سحب (Pull Request) مقدَّم فعلًا</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p>
            ومبدأ يوفّر عليك الحيرة: اختر منهجًا واحدًا منظمًا وافترض أنه
            عمودك الفقري لستة إلى ثمانية أسابيع، بدلًا من القفز بين
            فيديوهات متفرقة. المصادر المقترحة في آخر المقال، وكلها
            مجانية.
        </p>

        <h2 id="learn-by-building">تعلّم بالبناء: أفكار مشاريع حسب مستواك</h2>

        <p>
            القراءة والمشاهدة تعطيك إحساسًا بالفهم، والبناء هو الذي
            يختبر هذا الإحساس فعلًا. ابنِ أشياء صغيرة تحل مشكلة حقيقية
            عندك:
        </p>

        <ul>
            <li>
                <strong>للمبتدئ تمامًا</strong>: حاسبة، لعبة تخمين رقم،
                محوّل وحدات، قائمة مهام في الطرفية
            </li>
            <li>
                <strong>بعد الأساسيات</strong>: برنامج ينظم ملفات مجلد
                التنزيلات، أو يقرأ ملف CSV ويطبع ملخصًا، أو بوت بسيط
                لمحادثات
            </li>
            <li>
                <strong>لمن يتجه للويب</strong>: صفحة شخصية، ثم تطبيق
                مهام يحفظ بياناته، ثم واجهة تجلب بيانات من واجهة برمجية
                عامة
            </li>
            <li>
                <strong>لمن يتجه للبيانات</strong>: تحليل ملف بيانات
                مفتوح عن موضوع يهمك، وعرض نتائجه برسوم بيانية
            </li>
        </ul>

        <p>
            ومعيار اختيار المشروع: يجب أن يعنيك موضوعه أنت. المشروع الذي
            تحتاجه فعلًا تكمله حتى حين تتعثر، والمشروع المنسوخ من
            الإنترنت تتركه عند أول عقبة.
        </p>

        <h2 id="reading-open-source-code">
            اقرأ الكود المفتوح: أفضل مدرسة مجانية
        </h2>

        <p>
            ميزة اللغات مفتوحة المصدر الكبرى أن أمامك آلاف المشاريع
            الحقيقية التي كتبها محترفون، ويمكنك قراءتها كما تقرأ كتابًا
            مفتوحًا. لكن لا تبدأ بمشروع ضخم مثل نواة لينكس، فستضيع في
            ملايين الأسطر.
        </p>

        <ul>
            <li>ابدأ بمشاريع صغيرة (بضعة آلاف أسطر) في اللغة التي تتعلمها</li>
            <li>اقرأ ملف README أولًا ثم ابحث عن نقطة الدخول: الملف الذي يبدأ منه البرنامج</li>
            <li>شغّل المشروع على جهازك، وغيّر سطرًا صغيرًا لترى أثره</li>
            <li>اقرأ الاختبارات، فهي تشرح السلوك المتوقع لكل جزء بأمثلة</li>
            <li>اقرأ سجل التعديلات (Commits) لترى كيف تطور المشروع وكيف أُصلحت أخطاؤه</li>
        </ul>

        <h2 id="first-contribution">أول مساهمة لك في مشروع مفتوح المصدر</h2>

        <p>
            <img
                src="/images/articles/how-to-start-learning-open-source-programming-languages/02.webp"
                alt="واجهة طلب سحب على GitHub لأول مساهمة في مشروع مفتوح المصدر"
                width="1200"
                height="670"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            كثيرون يظنون أن المساهمة تتطلب كتابة ميزة معقدة، والحقيقة أن
            أغلب المساهمات الأولى صغيرة ومفيدة جدًا: تصحيح خطأ إملائي في
            التوثيق، توضيح فقرة غامضة، إضافة اختبار، أو إصلاح خلل بسيط.
        </p>

        <p>الخطوات المعتادة، مبسطة:</p>

        <ul>
            <li>ابحث عن مشروع تستخدمه فعلًا، فأنت تعرف أين ينقصه التوضيح</li>
            <li>اقرأ ملف README وملف CONTRIBUTING إن وُجد، وفيه قواعد المشروع في استقبال المساهمات</li>
            <li>ابحث عن المشكلات الموسومة بعبارات مثل good first issue، وهي مخصصة للقادمين الجدد</li>
            <li>انسخ المستودع (Fork) إلى حسابك، ثم أنشئ فرعًا جديدًا (Branch) لتعديلك</li>
            <li>أجرِ تعديلًا صغيرًا واحدًا، واكتب رسالة واضحة تصف ما فعلته ولماذا</li>
            <li>أرسل طلب سحب (Pull Request)، واشرح بإيجاز ما غيّرته</li>
            <li>كن مستعدًا للتعليقات: قد يطلب المشرف تعديلًا، وهذا تعلّم لا رفض</li>
        </ul>

        <p>
            لا تحبط إن تأخر الرد أو رُفضت المساهمة. المشرفون غالبًا
            متطوعون بأوقات محدودة، وكل رفض مهذب يعطيك معلومة عن معايير
            المشروع تفيدك في المحاولة التالية.
        </p>

        <h2 id="arabic-and-english">بين العربية والإنجليزية: كيف توازن؟</h2>

        <p>
            ابدأ بالمصدر الأسهل لك. وجود شرح عربي منظم في الأسابيع
            الأولى يختصر وقت الحيرة، ومنصات مثل أكاديمية حسوب وإدراك
            ورواق تقدّم محتوى عربيًا منظمًا. لكن التوثيق الرسمي لمعظم
            الأدوات يصدر بالإنجليزية أولًا، ومعظم أسئلة المشكلات التقنية
            وحلولها بها كذلك.
        </p>

        <p>
            الحل العملي: تعلّم المفهوم بالعربية، ثم اقرأ عنه في التوثيق
            الرسمي بالإنجليزية في الوقت نفسه. ستتعوّد على المصطلحات
            التقنية تدريجيًا، ولست بحاجة لإتقان الإنجليزية العامة، يكفي
            فهم المفردات التقنية وبنية الجمل في التوثيق.
        </p>

        <h2 id="ai-as-tutor">
            الذكاء الاصطناعي: معلّم جيد وكاتب كود خطير
        </h2>

        <p>
            أدوات الذكاء الاصطناعي أصبحت جزءًا من رحلة التعلم، ويمكن أن
            تسرّعك أو تعطّلك، بحسب طريقة استخدامك. القاعدة: اجعلها
            معلمًا لا بديلًا عن التفكير.
        </p>

        <ul>
            <li>اطلب منها شرح مفهوم لم تفهمه بمثال أبسط، أو شرح رسالة خطأ لا تفهمها</li>
            <li>اكتب محاولتك أولًا، ثم اطلب مراجعتها واقتراح تحسينات</li>
            <li>اطلب تلميحًا لا الحل الكامل حين تتعثر في تمرين</li>
            <li>لا تنسخ كودًا لا تستطيع أن تشرح كل سطر فيه</li>
            <li>تحقق من أي دالة أو مكتبة تقترحها في التوثيق الرسمي، فقد تقترح شيئًا قديمًا أو غير موجود</li>
        </ul>

        <p>
            من ينسخ الحلول الجاهزة يشعر بالتقدم أسابيع، ثم يكتشف أنه
            عاجز أمام شاشة فارغة. تعلّم البرمجة هو تدريب على التفكير، ولا
            يُدرَّب عقلك إلا إن بذل الجهد بنفسه.
        </p>

        <h2 id="common-mistakes">أخطاء شائعة تُضيّع شهورًا من وقتك</h2>

        <ul>
            <li>
                <strong>الدوران في حلقة الدروس</strong>: مشاهدة دورة بعد
                أخرى دون بناء شيء. الحل: بعد كل وحدة، ابنِ شيئًا صغيرًا
                منها
            </li>
            <li>
                <strong>تغيير اللغة كل أسبوعين</strong>: كل لغة جديدة
                تعيدك لنقطة البداية في النحو. التزم بلغة واحدة حتى
                تُنجز بها مشروعًا
            </li>
            <li>
                <strong>الخوف من الأخطاء</strong>: الأخطاء هي المنهج
                الحقيقي، وليست دليلًا على ضعفك
            </li>
            <li>
                <strong>إهمال Git</strong>: تأجيله يعني أن مشاريعك لا
                تُحفظ ولا تُعرض، وتخسر أسهل وسيلة لإثبات تقدمك
            </li>
            <li>
                <strong>الدراسة المتقطعة</strong>: ثلاثون دقيقة يوميًا
                تتفوق على سبع ساعات في عطلة نهاية الأسبوع
            </li>
            <li>
                <strong>مقارنة نفسك بالمحترفين</strong>: تقارن بداياتك
                بنهايات الآخرين. قارن نفسك بنفسك قبل شهر
            </li>
        </ul>

