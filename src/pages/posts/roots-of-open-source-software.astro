---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "roots-of-open-source-software",
    title: "جذور البرمجيات مفتوحة المصدر: تاريخ حركة غيّرت التقنية",
    metaTitle: "جذور البرمجيات مفتوحة المصدر: تاريخ حركة غيّرت التقنية",
    description:
        "رحلة تاريخية شاملة في جذور البرمجيات مفتوحة المصدر، من ثقافة الهاكرز الأولى في معامل MIT، مرورًا بريتشارد ستولمان ومشروع GNU، وصولًا لظهور لينكس وتأسيس Open Source Initiative.",
    keywords: [
        "جذور البرمجيات مفتوحة المصدر",
        "تاريخ البرمجيات مفتوحة المصدر",
        "ريتشارد ستولمان",
        "مشروع GNU",
        "Free Software Foundation",
        "Open Source Initiative",
        "لينوس تورفالدس",
        "GPL",
        "ثقافة الهاكرز",
    ],
    category: "مقالات",
    author: "طلال عمران",
    date: "26 سبتمبر 2026",
    pubDate: new Date("2026-09-26"),
    tags: ["تاريخ التقنية", "GNU", "ريتشارد ستولمان", "مفتوح المصدر", "لينكس"],
    thumbnail: "/images/roots-of-open-source-software.webp",
};

const tocItems = [
    { id: "hacker-culture-origins", label: "البداية: ثقافة الهاكرز في معامل الحوسبة الأمريكية" },
    { id: "closing-of-code", label: "اللحظة التي بدأ فيها الكود يُغلَق" },
    { id: "stallman-printer", label: "حادثة الطابعة التي غيّرت مسار ستولمان" },
    { id: "gnu-project", label: "1983: إعلان مشروع GNU" },
    { id: "fsf-founding", label: "1985: تأسيس مؤسسة البرمجيات الحرة وبيان GNU" },
    { id: "gpl-license", label: "رخصة GPL: الفكرة القانونية التي حمت الحرية" },
    { id: "linux-emergence", label: "1991: ظهور نواة لينكس، القطعة الناقصة" },
    { id: "netscape-moment", label: "1998: لحظة Netscape التي غيّرت كل شيء" },
    { id: "osi-founding", label: "1998: تأسيس Open Source Initiative" },
    { id: "free-vs-open-source", label: "لماذا انقسمت الحركة لمصطلحين مختلفين؟" },
    { id: "other-licenses", label: "تنوع الرخص: BSD وMIT وApache" },
    { id: "timeline-table", label: "الخط الزمني الكامل بالتواريخ" },
    { id: "legacy-today", label: "الإرث اليوم: من هواية إلى بنية تحتية للعالم" },
    { id: "external-resources", label: "مصادر خارجية للتعمق أكثر" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            كل مرة تستخدم فيها متصفحًا مجانيًا، أو خادم ويب يشغّل موقعًا
            تزوره يوميًا، أو حتى هاتفًا يعمل بنظام أندرويد، أنت تستفيد من
            حركة بدأت قبل أكثر من أربعين عامًا، ليس كاستراتيجية عمل مدروسة،
            بل كرد فعل غاضب من مبرمج واحد رفض أن يُمنع من إصلاح طابعة معطّلة.
        </p>

        <p>
            هذا المقال يروي القصة الكاملة لجذور البرمجيات مفتوحة المصدر:
            من ثقافة المشاركة الأولى في معامل الحوسبة الأمريكية، مرورًا
            باللحظة التي بدأ فيها الكود يُغلَق، وصولًا لتأسيس الحركتين
            اللتين شكّلتا عالم التقنية كما نعرفه اليوم.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {
                    tocItems.map((item) => (
                        <li>
                            <a
                                href={`#${item.id}`}
                                class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ol>
        </nav>

        <h2 id="hacker-culture-origins">
            البداية: ثقافة الهاكرز في معامل الحوسبة الأمريكية
        </h2>

        <p>
            <img
                src="/images/articles/roots-of-open-source-software/01.webp"
                alt="معمل حوسبة قديم من حقبة السبعينيات"
                width="1200"
                height="800"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            في الستينيات والسبعينيات، لم يكن مفهوم "الكود مفتوح المصدر"
            موجودًا أصلاً، لأنه لم يكن هناك ما يستدعي هذا المصطلح تحديدًا.
            في معامل مثل مختبر الذكاء الاصطناعي في MIT، كان تبادل الكود
            المصدري بين الباحثين والمبرمجين ممارسة طبيعية تمامًا، أقرب
            لتبادل الأفكار العلمية منها لصفقة تجارية. البرمجيات كانت تُوزَّع
            عبر أنظمة BBS وأشرطة مغناطيسية، وكانت "الملكية الفكرية" مفهومًا
            هامشيًا في هذا السياق الأكاديمي التعاوني.
        </p>

        <p>
            هذه الثقافة أنتجت ما يُعرف لاحقًا بـ"أخلاقيات الهاكر": الاعتقاد
            بأن المعلومة يجب أن تكون حرة، وأن أفضل طريقة لتطوير برنامج هي
            السماح لأكبر عدد ممكن من العقول بفحصه وتحسينه.
        </p>

        <h2 id="closing-of-code">اللحظة التي بدأ فيها الكود يُغلَق</h2>

        <p>
            مع دخول الثمانينيات، بدأت شركات البرمجيات الناشئة تدرك أن بيع
            تراخيص استخدام مغلقة أكثر ربحية من مشاركة الكود مجانًا.
            اتفاقيات عدم الإفشاء (NDAs) والتراخيص الاحتكارية أصبحت المعيار
            الجديد للصناعة، وبدأت الشركات تطالب الباحثين والموظفين بالتوقيع
            على عقود تمنعهم من مشاركة الكود الذي كانوا يتبادلونه بحرية
            لسنوات.
        </p>

        <p>
            هذا التحول لم يكن مجرد تغيير تجاري بالنسبة لبعض المبرمجين
            القدامى؛ بدا لهم وكأنه خيانة مباشرة لثقافة كاملة بُنيت على
            المشاركة والتعاون المفتوح.
        </p>

        <h2 id="stallman-printer">حادثة الطابعة التي غيّرت مسار ستولمان</h2>

        <p>
            القصة التأسيسية الأشهر في تاريخ الحركة: ريتشارد ستولمان،
            الباحث في معمل الذكاء الاصطناعي بـ MIT منذ 1971، اعتاد تعديل
            برنامج تشغيل طابعة المختبر ليُرسل إشعارًا عند انحشار الورق،
            توفيرًا لوقت الجميع. حين حصل المختبر على طابعة جديدة من شركة
            خارجية، طلب ستولمان الكود المصدري لتطبيق نفس التعديل، فقوبل
            بالرفض: الشركة اعتبرت الكود ملكية سرية، ورفضت حتى مشاركته مع
            مبرمج يريد فقط تحسين تجربة استخدام جهازه الخاص.
        </p>

        <p>
            هذه الحادثة تحديدًا، بحسب رواية ستولمان نفسه لاحقًا، كانت
            نقطة التحول التي أقنعته أن العالم يتجه نحو نموذج "احتكار
            المعرفة التقنية" يجب مقاومته بشكل منظم، لا فقط الشكوى منه.
        </p>

        <h2 id="gnu-project">1983: إعلان مشروع GNU</h2>

        <p>
            في 27 سبتمبر 1983، نشر ريتشارد ستولمان إعلانًا على مجموعات
            الأخبار الإلكترونية (Usenet) يعلن فيه عزمه بناء نظام تشغيل
            كامل متوافق مع يونكس، لكن حرًا بالكامل، أطلق عليه اسم GNU
            (اختصار متكرر ساخر يعني "GNU's Not Unix"). بدأ المشروع رسميًا
            في يناير 1984، بعد أن غادر ستولمان وظيفته في MIT عمدًا لتجنب أي
            نزاع حول ملكية الجامعة لما سيكتبه.
        </p>

        <p>
            الهدف لم يكن مجرد بناء برنامج آخر، بل إعادة إحياء "روح
            التعاون" التي كانت سائدة قبل أن تُقيّدها التراخيص التجارية،
            عبر بناء نظام تشغيل كامل تكون كل قطعة منه حرة بشكل لا رجعة فيه.
        </p>

        <h2 id="fsf-founding">
            1985: تأسيس مؤسسة البرمجيات الحرة وبيان GNU
        </h2>

        <p>
            في مارس 1985، نشر ستولمان "بيان GNU" (GNU Manifesto)، وثيقة
            توضح الأسس الأخلاقية والعملية للمشروع، وتطلب دعم المجتمع
            التقني لتمويل استمراره. في أكتوبر من العام نفسه، أسس منظمة
            غير ربحية باسم مؤسسة البرمجيات الحرة (Free Software
            Foundation - FSF) لتمويل وتنظيم تطوير GNU رسميًا.
        </p>

        <p>
            الفلسفة التي صاغها ستولمان تقوم على أربع حريات أساسية يجب أن
            يمتلكها أي مستخدم برنامج: حرية تشغيله لأي غرض، حرية دراسة
            كيفية عمله وتعديله، حرية إعادة توزيع نسخ منه، وحرية توزيع
            نسخ معدّلة منه للآخرين. غياب أي من هذه الحريات الأربع، بحسب
            ستولمان، يجعل البرنامج "غير حر" بغض النظر عن سعره.
        </p>

        <h2 id="gpl-license">رخصة GPL: الفكرة القانونية التي حمت الحرية</h2>

        <p>
            لم يكتفِ ستولمان بإعلان مبادئ أخلاقية؛ صاغ أداة قانونية فعلية
            لحمايتها: رخصة جنو العمومية (GNU General Public License -
            GPL). ابتكارها الأذكى كان مبدأ "الرخصة المُعدية" (Copyleft):
            أي برنامج يستخدم كودًا مرخّصًا بـ GPL، ويُعاد توزيعه، يجب أن
            يبقى هو الآخر مرخّصًا بنفس الشروط الحرة.
        </p>

        <p>
            هذا قلب فكرة حقوق النشر التقليدية رأسًا على عقب: بدلاً من
            استخدام القانون لتقييد النسخ، استُخدم لضمان بقاء الحرية سارية
            في كل نسخة مشتقة للأبد، مهما تعددت أيدي المطورين التي تمر بها.
        </p>

        <h2 id="linux-emergence">1991: ظهور نواة لينكس، القطعة الناقصة</h2>

        <p>
            بحلول أوائل التسعينيات، كان مشروع GNU قد أنتج أغلب مكونات نظام
            تشغيل كامل: محرر Emacs، مترجم GCC، أدوات النظام الأساسية —
            كل شيء ما عدا القطعة الأهم: النواة (Kernel) نفسها. في هذا
            الفراغ تحديدًا، أعلن طالب فنلندي شاب يُدعى لينوس تورفالدس عام
            1991 عن نواة بسيطة كتبها كمشروع شخصي، وأطلق عليها اسمه: لينكس.
        </p>

        <p>
            حين اجتمعت نواة تورفالدس مع أدوات مشروع GNU الجاهزة أصلاً،
            اكتمل أول نظام تشغيل حر بالكامل عمليًا، وهو ما يفسّر لماذا
            يصرّ ستولمان حتى اليوم على تسمية النظام "GNU/Linux" لا "لينكس"
            فقط، تقديرًا لمكون تُنسى مساهمته أحيانًا في السرد الشعبي.
        </p>

        <h2 id="netscape-moment">1998: لحظة Netscape التي غيّرت كل شيء</h2>

        <p>
            <img
                src="/images/articles/roots-of-open-source-software/02.webp"
                alt="حقبة متصفحات الويب في التسعينيات، عصر حرب المتصفحات"
                width="960"
                height="696"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            في يناير 1998، وفي خضم "حرب المتصفحات" مع مايكروسوفت، اتخذت
            شركة Netscape قرارًا غير مسبوق تمامًا لشركة تجارية كبرى: فتح
            الكود المصدري لمتصفحها بالكامل (المشروع الذي أصبح لاحقًا أساس
            Mozilla Firefox). هذا القرار التجاري الجريء أثبت شيئًا لم يكن
            واضحًا للعالم التجاري حتى تلك اللحظة: أن الشركات الكبرى يمكن
            أن تستفيد فعليًا من فتح كودها، لا فقط الهواة والأكاديميون.
        </p>

        <h2 id="osi-founding">1998: تأسيس Open Source Initiative</h2>

        <p>
            استجابة مباشرة لهذه اللحظة، اجتمعت مجموعة من المبرمجين
            البارزين، من بينهم إريك ريموند وبروس بيرنز، وأسسوا في فبراير
            1998 منظمة Open Source Initiative (OSI). كانت الفكرة تقديم
            "علامة تجارية" أكثر قبولاً تجاريًا من مصطلح "البرمجيات الحرة"
            الذي حمل عند كثير من رجال الأعمال إيحاءً سياسيًا أو أيديولوجيًا
            مزعجًا.
        </p>

        <p>
            المنظمة صاغت "تعريف المصدر المفتوح" (Open Source Definition)،
            ومعايير واضحة لاعتماد أي رخصة كـ"مفتوحة المصدر" رسميًا، وأصبحت
            لاحقًا الجهة المرجعية عالميًا لهذا الاعتماد.
        </p>

        <h2 id="free-vs-open-source">
            لماذا انقسمت الحركة لمصطلحين مختلفين؟
        </h2>

        <p>
            هذا الانقسام ليس دلاليًا فقط، بل فلسفي حقيقي استمر لعقود:
        </p>

        <ul>
            <li>
                <strong>البرمجيات الحرة (Free Software)</strong>، بقيادة
                ستولمان وFSF، تنظر للحرية كقيمة أخلاقية وحقًا أساسيًا،
                حتى لو كلّف ذلك المستخدم مالًا أو راحة عملية
            </li>
            <li>
                <strong>المصدر المفتوح (Open Source)</strong>، بقيادة OSI،
                تركز عمليًا على الفوائد التقنية والتجارية: جودة أعلى،
                موثوقية أكبر، وتطوير تعاوني أسرع، دون التركيز على الخطاب
                الأخلاقي
            </li>
        </ul>

        <p>
            ستولمان نفسه رفض مصطلح "المصدر المفتوح" علنًا، معتبرًا أنه
            يُفرغ الحركة من جوهرها الأخلاقي لصالح خطاب عملي أكثر قبولاً
            تجاريًا. رغم هذا الخلاف الفلسفي المستمر، كلا التيارين ينتجان
            عمليًا برمجيات متوافقة تقنيًا في أغلب الأحيان، وهذا ما يجمعهما
            تحت مظلة مصطلح أوسع يُستخدم اليوم: FOSS (Free and Open Source
            Software).
        </p>

        <h2 id="other-licenses">تنوع الرخص: BSD وMIT وApache</h2>

        <p>
            لم تكن GPL الرخصة الوحيدة التي ظهرت من هذا السياق التاريخي.
            رخصة BSD (من جامعة كاليفورنيا في بيركلي) ورخصة MIT ظهرتا في
            الثمانينيات أيضًا، لكن بفلسفة مختلفة عن Copyleft: مرونة كاملة
            تسمح باستخدام الكود حتى في مشاريع تجارية مغلقة لاحقًا، دون
            إجبار المشتقات على البقاء مفتوحة. هذا التنوع في الرخص عكس
            انقسام الفلسفة نفسه: بين من يريد ضمان بقاء الحرية للأبد (GPL)،
            ومن يفضّل أقصى حرية استخدام ممكنة دون قيود لاحقة (MIT/BSD).
        </p>

        <h2 id="timeline-table">الخط الزمني الكامل بالتواريخ</h2>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">السنة</th>
                        <th class="px-4 py-2 font-semibold">الحدث</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">1971</td>
                        <td class="px-4 py-2">ستولمان ينضم لمعمل الذكاء الاصطناعي في MIT</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">سبتمبر 1983</td>
                        <td class="px-4 py-2">إعلان مشروع GNU رسميًا</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">مارس 1985</td>
                        <td class="px-4 py-2">نشر بيان GNU</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">أكتوبر 1985</td>
                        <td class="px-4 py-2">تأسيس مؤسسة البرمجيات الحرة (FSF)</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">1989</td>
                        <td class="px-4 py-2">إصدار أول نسخة من رخصة GPL</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">1991</td>
                        <td class="px-4 py-2">لينوس تورفالدس يعلن عن نواة لينكس</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">يناير 1998</td>
                        <td class="px-4 py-2">Netscape تفتح كود متصفحها</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">فبراير 1998</td>
                        <td class="px-4 py-2">تأسيس Open Source Initiative</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h2 id="legacy-today">الإرث اليوم: من هواية إلى بنية تحتية للعالم</h2>

        <p>
            ما بدأ كرد فعل غاضب من مبرمج واحد رفض قبول طابعة مغلقة، أصبح
            اليوم الأساس التقني الذي يشغّل أغلب خوادم الإنترنت (عبر لينكس)،
            أغلب الأجهزة المحمولة حول العالم (عبر أندرويد المبني على لينكس)،
            ومعظم البنية التحتية السحابية الحديثة. حتى الشركات التي كانت
            يومًا أعدى أعداء هذه الفلسفة، مثل مايكروسوفت التي وصف رئيسها
            التنفيذي السابق لينكس بـ"السرطان" عام 2001، أصبحت اليوم من أكبر
            المساهمين في مشاريع مفتوحة المصدر عالميًا.
        </p>

        <p>
            هذا التحول لم يكن حتميًا أو متوقعًا في بداياته؛ كان نتيجة
            إصرار عنيد لمجموعة صغيرة من المبرمجين على فكرة بدت للكثيرين
            غير عملية في التسعينيات: أن المشاركة المفتوحة يمكن أن تنتج
            برمجيات أفضل من الاحتكار المغلق، لا رغم انفتاحها، بل بفضله.
        </p>

