---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "0ad-release-28-boiorix-first-non-alpha-open-source-rts-game",
    title: "0 A.D. Release 28 Boiorix: أول إصدار بدون Alpha لـ لعبة RTS تاريخية مفتوحة المصدر",
    metaTitle: "0 A.D. Release 28: لعبة حروب قديمة مفتوحة المصدر وحرة",
    description:
        "0 A.D. Release 28 Boiorix أطلقت في 2026 — أول إصدار بدون عنوان Alpha للعبة RTS تاريخية مفتوحة المصدر تماماً، مع فصيلة جديدة الألمان، جنس للمدنيين، عرض خطوط محسّن، وتحسينات شاملة، تعكس نضج مشروع Wildfire Games.",
    keywords: [
        "0 A.D.",
        "Release 28",
        "Boiorix",
        "RTS Game",
        "Open Source",
        "Free Game",
        "Strategy Game",
        "لعبة RTS",
        "مفتوح المصدر",
        "ألعاب حرة",
    ],
    category: "ألعاب وترفيه",
    author: "طلال عمران",
    date: "1 أكتوبر 2026",
    pubDate: new Date("2026-10-01"),
    tags: ["0 A.D.", "RTS", "Open Source", "Free Game", "Gaming"],
    thumbnail: "/images/0ad-release-28-boiorix-first-non-alpha-open-source-rts-game.webp",
};
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>

        <p>
            أعلنت <a href="https://play0ad.com/" target="_blank" rel="noopener noreferrer nofollow">Wildfire Games</a>، 
            مجموعة دولية من مطوري الألعاب المتطوعين، عن إطلاق Release 28 من لعبة 
            0 A.D. المسماة "Boiorix" — أول إصدار للعبة بدون عنوان "Alpha". 
            هذا الإصدار يمثل نقطة فاصلة مهمة جداً في تطور اللعبة 
            لأنه يوضح أن عملية التطوير نضجت وأن اللعبة وصلت مستوى استقرار 
            وجودة عالي بما يكفي لإسقاط عنوان Alpha. الإصدار الجديد 
            يضمن فصيلة جديدة كاملة (الألمان)، ميزات واجهة مستخدم محسّنة، 
            وتحسينات شاملة في الأداء والتوازن. لعبة 0 A.D. لعبة استراتيجية 
            في الوقت الفعلي (RTS) تاريخية موجهة نحو الحروب القديمة، 
            وهي مجانية تماماً وتفتوحة المصدر بدون أي إعلانات أو عمليات شراء داخلية.
        </p>

        <h2>السياق والرحلة الطويلة</h2>

        <p>
            <img
                src="/images/articles/0ad-release-28-boiorix-first-non-alpha-open-source-rts-game/01.webp"
                alt="لقطة شاشة من 0 A.D. Release 28 Boiorix"
                width="1024"
                height="768"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            0 A.D. ليست لعبة حديثة الإطلاق. المشروع كان في مرحلة Alpha 
            لفترة طويلة جداً — سنوات من التطوير المستمر والتحسينات التدريجية. 
            Wildfire Games هي مجموعة من المطوعين حول العالم الذين يعملون على اللعبة 
            في أوقات فراغهم بدون تمويل تجاري كبير. هذا يعني أن التطوير كان دائماً بطيئاً 
            ولكنه ثابت. الآن، بعد سنوات من العمل الشاق، اللعبة وصلت مستوى 
            حيث تستحق إسقاط عنوان Alpha. هذا ليس قرار عشوائي — 
            هذا يعني أن الفريق اعتقد أن اللعبة مستقرة بما يكفي وكاملة بما يكفي 
            للاعبين العاديين أن يتمتعوا بها بدون مخاوف أساسية.
        </p>

        <h2>الميزات الرئيسية والإصدارات الجديدة</h2>

        <h3>فصيلة جديدة: الألمان (الكمبري والقبائل الجرمانية)</h3>

        <p>
            الإضافة الأساسية في Release 28 هي فصيلة جديدة تماماً: الألمان. 
            الفصيلة تمثل القبائل الجرمانية القديمة خاصة الكمبري 
            الذين هاجروا جنوباً من شمال الدانمارك الحديثة. هذه القبائل 
            كانت معروفة بـ حروبهم مع الجمهورية الرومانية في القرن الثاني قبل الميلاد.

            خصائص الفصيلة الجديدة:
        </p>

        <ul>
            <li>
                اقتصاد مرن بناءً على عربات الإمداد والمخيمات التي يمكن تحصينها
            </li>
            <li>
                اعتماد أقل على الحدود الإقليمية بسبب تقنيات "Wagon Trains" و "Migratory Resettlement"
            </li>
            <li>
                وحدات حصار عدوانية قوية جداً
            </li>
            <li>
                وحدات فريدة مثل Cimbrian raiders و Log Rams و Seeresses
            </li>
        </ul>

        <p>
            الفصيلة الجديدة توفر تجربة لعب مختلفة تماماً — 
            بدلاً من الاعتماد على المباني والموارد الثابتة، 
            اللاعبون يمكنهم الاعتماد على الحراك والمرونة.
        </p>

        <h3>جنس للمدنيين: تحسن تاريخي</h3>

        <p>
            <img
                src="/images/articles/0ad-release-28-boiorix-first-non-alpha-open-source-rts-game/02.webp"
                alt="لقطة شاشة من 0 A.D. Release 28 Boiorix"
                width="1200"
                height="675"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            لتحسين الدقة التاريخية، الفريق استبدل وحدات المدنيين. 
            سابقاً، كانت تُسمى "female citizen" بشكل غير دقيق تاريخياً 
            (لأن المرأة لم تكن مواطنة في المجتمعات القديمة). الآن، 
            وحدة المدني الأساسي لديها نماذج ذكر وأنثى. هذا التحسن 
            كان ممكناً بسبب تحسينات محرك اللعبة التي تسمح 
            بـ متغيرات للوحدات ليس فقط في المظهر بل أيضاً في الصوت.
        </p>

        <h3>عرض خطوط مباشر (Direct Font Rendering)</h3>

        <p>
            سابقاً، اللعبة كانت تحمّل خطوط مرسومة مسبقاً في الذاكرة. 
            لـ اللغات الآسيوية الشرقية مثل الصينية، هذا كان يتطلب 
            تحميل آلاف الأحرف في الذاكرة. الآن، الفريق استخدم مكتبة Freetype 
            لرسم الخطوط "on the fly" — أي عند الحاجة فقط. هذا يوفر ذاكرة كبيرة 
            ويسمح بـ دعم لغات أكثر دون الحاجة لتعديلات إضافية.
        </p>

        <h3>خيارات إعداد لعبة جديدة</h3>

        <p>
            اللاعبون الآن يمكنهم:
        </p>

        <ul>
            <li>
                إزالة لاعبين من اللعبة تماماً (مع إزالة جميع المباني والوحدات الأولية)
            </li>
            <li>
                تحديد حد السكان لكل فريق
            </li>
            <li>
                تحكم أفضل على خيارات السيناريو
            </li>
        </ul>

        <h3>ترقيات محرك اللعبة</h3>

        <p>
            اللعبة الآن تستخدم SpiderMonkey JavaScript Engine إصدار 128. 
            هذا يعني دعم Windows 10 و 11 فقط (لا يوجد دعم لـ Windows 7 و 8.1). 
            بالإضافة إلى ذلك، اللعبة الآن توفر نسخة 64-bit رسمية 
            تحل مشاكل "out-of-memory" النادرة. على Linux، 
            اللعبة الآن متاحة كـ AppImage بالإضافة إلى Snap و Flatpak.
        </p>

        <h2>التحسينات والتوازن</h2>

        <h3>تحسينات عامة</h3>

        <p>
            اللعبة حصلت على عدة تحسينات في التوازن:
        </p>

        <ul>
            <li>
                مقاومة الاستيلاء على الهياكل زادت
            </li>
            <li>
                تحسينات في الحرب البحرية — تبسيط شجرة التقنيات
            </li>
            <li>
                تحسينات في حركة المجموعات
            </li>
            <li>
                تعديلات على الفرسان والفيلة والأسلحة المختلفة
            </li>
        </ul>

        <h3>تحسينات خاصة بـ الفصائل</h3>

        <p>
            كل فصيلة حصلت على تحسينات محددة:
        </p>

        <ul>
            <li>
                قرطاج: مكافآت حجرية جديدة وتحسينات المرتزقة
            </li>
            <li>
                هان: إعادة هيكلة شاملة للوزراء والوزارات
            </li>
            <li>
                Mauryas: تحسينات التمييز بين الوحدات الذكورة والأنثى
            </li>
        </ul>

        <h2>التحليل والأهمية</h2>

        <p>
            إطلاق Release 28 بدون عنوان Alpha يمثل نقطة مهمة جداً 
            في تطور 0 A.D. هذا لا يعني أن التطوير توقف — بل الفريق 
            سيستمر في إضافة ميزات جديدة والتحسينات المستمرة. 
            لكن هذا يعني أن اللعبة الآن مستقرة وموثوقة بما يكفي 
            للاعبين العاديين.

            المتوقع أن نرى:
        </p>

        <ul>
            <li>
                نمو في عدد اللاعبين بسبب سمعة أفضل
            </li>
            <li>
                مزيد من المساهمات من المجتمع الآن أن اللعبة وصلت نضجاً
            </li>
            <li>
                تطورات أسرع قليلاً لأن الفريق لا يحتاج قضاء وقت بـ تحديث Alpha
            </li>
            <li>
                اهتمام أكبر من وسائط الإعلام عن الألعاب
            </li>
        </ul>

        <h2>قراءة تحليلية مستقلة</h2>

        <p>
            0 A.D. نموذج نادر من النجاح الحقيقي لـ مشروع مفتوح المصدر. 
            بدون تمويل تجاري كبير أو شركة داعمة، مجموعة من المتطوعين 
            قادرة على بناء لعبة RTS كاملة وعالية الجودة. هذا ليس سهلاً أبداً.

            الجانب الإيجابي: اللعبة مجانية تماماً ومفتوحة المصدر. 
            لا إعلانات، لا عمليات شراء داخلية، لا متتبعات. 
            اللاعبون يملكون حقاً على ما يلعبون. الجانب السلبي: 
            قد تكون بطيئة في إضافة ميزات جديدة مقارنة بـ ألعاب RTS التجارية. 
            كما أن المجتمع أصغر بكثير من ألعاب أخرى.

            التحديات المتوقعة: الفريق يطلب مساهمات في مجالات مثل 
            تحرير الفيديو وإدارة وسائل التواصل الاجتماعي. 
            هذا يشير إلى أن المشروع يحتاج مزيد من الدعم.
        </p>

        <h2>الأسئلة الشائعة</h2>

        <h3>س: هل 0 A.D. آمنة للعب الآن؟</h3>
        <p>
            ج: نعم تماماً. إسقاط عنوان Alpha يعني أن الفريق واثق من الاستقرار. 
            قد تكون هناك أخطاء صغيرة، لكن الأخطاء الكبيرة والمحبطة يجب أن تكون نادرة.
        </p>

        <h3>س: هل 0 A.D. تحتاج جهاز قوي؟</h3>
        <p>
            ج: اللعبة تعمل على أجهزة متوسطة. بالطبع، جهاز أقوى يعطي تجربة أفضل، 
            لكن متطلبات الأجهزة ليست عالية جداً.
        </p>

        <h3>س: ما الفرق بين 0 A.D. و Age of Empires؟</h3>
        <p>
            ج: كلاهما RTS، لكن 0 A.D. موجهة نحو التاريخ القديم والعصور الوسطى. 
            Age of Empires أكثر تجاريةً وأكثر بأساليب لعب متنوعة.
        </p>

        <h3>س: هل هناك ألعاب أونلاين متعددة اللاعبين؟</h3>
        <p>
            ج: نعم، اللعبة توفر لعبة متعددة اللاعبين عبر الإنترنت عبر lobby. 
            كما توفر اللعبة خيار "Connect by IP" للعب مع الأصدقاء مباشرة.
        </p>

        <h2>الخاتمة</h2>

        <p>
            Release 28 من 0 A.D. يمثل نقطة فاصلة مهمة في تطور اللعبة. 
            إسقاط عنوان Alpha يعكس النضج والاستقرار الذي وصلت إليه. 
            الفصيلة الجديدة (الألمان) وميزات مثل جنس المدنيين وعرض الخطوط المباشر 
            توضح أن الفريق ما زال يطور وينوّع التجربة.

            0 A.D. مثال رائع على ما يمكن أن ينجزه المتطوعون 
            عندما يكون لديهم شغف وتصميم حقيقيان. 
            بالنسبة للاعبين الذين يريدون لعبة RTS حقيقية بدون تكاليف أو قيود، 
            0 A.D. هي خيار ممتاز وجديرة بـ التجربة.
        </p>

        <h3>المصدر:</h3>
        <p>
            <a href="https://play0ad.com/new-release-0-a-d-release-28-boiorix/" target="_blank" rel="noopener noreferrer nofollow">
                0 A.D. - Release 28: Boiorix
            </a>
        </p>
    </PostLayout>
</BaseLayout>