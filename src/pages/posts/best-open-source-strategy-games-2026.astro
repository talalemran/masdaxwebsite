---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "best-open-source-strategy-games-2026",
    title: "أفضل الألعاب الإستراتيجية مفتوحة المصدر في 2026: دليل شامل",
    metaTitle: "أفضل الألعاب الإستراتيجية مفتوحة المصدر في 2026: دليل شامل",
    description:
        "دليل عملي لأفضل الألعاب الإستراتيجية مفتوحة المصدر في 2026: Battle for Wesnoth و0 A.D. وFreeciv وOpenRA وBeyond All Reason وZero-K وWidelands وWarzone 2100. مع جداول مقارنة، وأداء، ومجتمعات، وقائمة تحقق.",
    keywords: [
        "ألعاب إستراتيجية مفتوحة المصدر",
        "Battle for Wesnoth",
        "0 A.D.",
        "Freeciv",
        "OpenRA",
        "Beyond All Reason",
        "Zero-K",
        "Widelands",
        "Warzone 2100",
        "أفضل ألعاب لينكس",
    ],
    category: "ألعاب وترفيه",
    author: "طلال عمران",
    date: "31 أكتوبر 2026",
    pubDate: new Date("2026-10-31"),
    tags: ["ألعاب", "مفتوح المصدر", "إستراتيجية", "RTS", "لينكس"],
    thumbnail: "/images/best-open-source-strategy-games-2026.webp",
};

const tocItems = [
    { id: "at-a-glance", label: "نظرة سريعة: خريطة الألعاب الإستراتيجية المفتوحة" },
    { id: "why-open-source-strategy", label: "لماذا الألعاب الإستراتيجية تحديدًا؟" },
    { id: "turn-based", label: "الإستراتيجية التكتيكية بالأدوار: Wesnoth وUnciv وTripleA" },
    { id: "classic-4x", label: "بناء الإمبراطوريات 4X: Freeciv" },
    { id: "historical-rts", label: "الحرب التاريخية في الوقت الحقيقي: 0 A.D." },
    { id: "classic-rts", label: "إحياء كلاسيكيات RTS: OpenRA" },
    { id: "large-scale-rts", label: "RTS واسع النطاق: Beyond All Reason وZero-K" },
    { id: "settlement-rts", label: "بناء المستوطنات: Widelands" },
    { id: "post-apocalyptic-rts", label: "ما بعد الكارثة: Warzone 2100" },
    { id: "factory-strategy", label: "الإستراتيجية الصناعية: Mindustry" },
    { id: "other-notable", label: "ألعاب أخرى تستحق التجربة" },
    { id: "performance-hardware", label: "الأداء والعتاد: ماذا تحتاج لتشغيلها؟" },
    { id: "community-modding", label: "المجتمع والتعديل: ما الذي يطيل عمر اللعبة؟" },
    { id: "how-to-choose", label: "كيف تختار لعبتك الإستراتيجية الأولى؟" },
    { id: "final-checklist", label: "قائمة تحقق نهائية" },
    { id: "useful-links", label: "روابط ومصادر مفيدة" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            في 2026، لم تعد الألعاب الإستراتيجية مفتوحة المصدر “بدائل
            هواة” للألعاب التجارية. بعضها يعمل منذ أكثر من عقدين،
            وبعضها يضاهي إنتاجات الاستوديوهات الكبرى في العمق
            التكتيكي، وبعضها حصل على ناشر تجاري دون أن يفقد كوده
            المفتوح. الفارق بين <strong>Battle for Wesnoth</strong>
            و<strong>0 A.D.</strong> و<strong>Beyond All Reason</strong>
            لم يعد فارقًا في “المجانية”، بل في نوع التجربة التي
            تقدمها.
        </p>

        <p>
            هذا الدليل يرتب الألعاب حسب <strong>النوع</strong> لا حسب
            الشهرة: الإستراتيجية التكتيكية بالأدوار، وبناء
            الإمبراطوريات 4X، والحرب التاريخية، وإحياء كلاسيكيات
            RTS، والـRTS واسع النطاق. لكل لعبة يشرح ما تقدمه،
            وحدودها، ومن تناسبه. الهدف ليس أن تجرب كل شيء، بل أن
            تختار لعبة واحدة تناسب وقتك، ثم تتقنها.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {tocItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <h2 id="at-a-glance">نظرة سريعة: خريطة الألعاب الإستراتيجية المفتوحة</h2>

        <p>
            الجدول التالي يلخص الألعاب الرئيسية، ونوعها، وأحدث إصدار
            موثق في 2026، والمنصات المدعومة:
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">اللعبة</th>
                        <th class="px-4 py-2 font-semibold">النوع</th>
                        <th class="px-4 py-2 font-semibold">أحدث إصدار (2026)</th>
                        <th class="px-4 py-2 font-semibold">المنصات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2"><strong>Battle for Wesnoth</strong></td>
                        <td class="px-4 py-2">تكتيكية بالأدوار (فانتازيا)</td>
                        <td class="px-4 py-2">1.18.7 (مايو 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، Steam</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>0 A.D.</strong></td>
                        <td class="px-4 py-2">RTS تاريخية (العصور القديمة)</td>
                        <td class="px-4 py-2">0.28.0 (فبراير 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Freeciv</strong></td>
                        <td class="px-4 py-2">4X بالأدوار (بناء إمبراطوريات)</td>
                        <td class="px-4 py-2">3.2.6 (سبتمبر 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، ويب</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>OpenRA</strong></td>
                        <td class="px-4 py-2">RTS كلاسيكية معاد بناؤها</td>
                        <td class="px-4 py-2">Playtest 2026-10-11</td>
                        <td class="px-4 py-2">Windows، macOS، Linux</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Beyond All Reason</strong></td>
                        <td class="px-4 py-2">RTS واسع النطاق</td>
                        <td class="px-4 py-2">Alpha نشطة (2026)</td>
                        <td class="px-4 py-2">Windows، Linux</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Zero-K</strong></td>
                        <td class="px-4 py-2">RTS علمية خيالية</td>
                        <td class="px-4 py-2">1.14.9.0 (سبتمبر 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، Steam</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Widelands</strong></td>
                        <td class="px-4 py-2">RTS بناء مستوطنات</td>
                        <td class="px-4 py-2">1.3.1 (فبراير 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Warzone 2100</strong></td>
                        <td class="px-4 py-2">RTS ما بعد الكارثة</td>
                        <td class="px-4 py-2">4.7.0 (أبريل 2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، FreeBSD</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Unciv</strong></td>
                        <td class="px-4 py-2">4X بالأدوار (إعادة بناء Civ V)</td>
                        <td class="px-4 py-2">4.22.x (أكتوبر 2026)</td>
                        <td class="px-4 py-2">Android، Desktop</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>Mindustry</strong></td>
                        <td class="px-4 py-2">إستراتيجية صناعية/دفاع أبراج</td>
                        <td class="px-4 py-2">v8 (2026)</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، Android، iOS</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2"><strong>TripleA</strong></td>
                        <td class="px-4 py-2">إستراتيجية ألواح (Axis & Allies)</td>
                        <td class="px-4 py-2">2026-09-16</td>
                        <td class="px-4 py-2">Windows، macOS، Linux، ويب</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h2 id="why-open-source-strategy">لماذا الألعاب الإستراتيجية تحديدًا؟</h2>

        <p>
            <img
                src="/images/articles/best-open-source-strategy-games-2026/01.webp"
                alt="لماذا الألعاب الإستراتيجية تحديدًا؟"
                width="1200"
                height="675"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            الألعاب الإستراتيجية هي أكثر الأنواع ملاءمة للنموذج المفتوح
            المصدر، لثلاثة أسباب:
        </p>

        <ul>
            <li>
                <strong>القواعد أهم من الرسومات.</strong> اللعبة
                الإستراتيجية الجيدة تعيش بقواعدها وتوازنها، لا
                بمؤثراتها البصرية. وهذا مجال يمكن لمجتمع من
                المتطوعين أن يتفوق فيه، كما يفعل
                <strong>Battle for Wesnoth</strong> منذ
                2003.
            </li>
            <li>
                <strong>قابلية التعديل.</strong> الألعاب المفتوحة
                تسمح بتعديل القواعد والخرائط والوحدات. وهذا يطيل
                عمر اللعبة سنوات بعد إصدارها، ويخلق محتوى لا
                يستطيع استوديو واحد إنتاجه.
            </li>
            <li>
                <strong>الخوادم والمجتمعات.</strong> اللعبة
                الإستراتيجية الجماعية تحتاج خوادم ومجتمعات
                منظمة. النموذج المفتوح يسمح للمجتمع بإدارة
                بطولات وخوادم دون الاعتماد على ناشر.
            </li>
        </ul>

        <h2 id="turn-based">الإستراتيجية التكتيكية بالأدوار: Wesnoth وUnciv وTripleA</h2>

        <h3>Battle for Wesnoth: ملك الإستراتيجية بالأدوار</h3>

        <p>
            <strong>Battle for Wesnoth</strong> هو أنضج مشروع
            إستراتيجي مفتوح المصدر وأطولها عمرًا. بدأ في 2003، وما
            زال يتلقى تحديثات منتظمة. الإصدار المستقر الحالي هو
            <strong>1.18.7</strong> (مايو 2026).
        </p>

        <p>
            اللعبة تعتمد على <strong>شبكة سداسية</strong> وتكتيكات
            دورية، في عالم فانتازيا عالي. ما يميزها:
        </p>

        <ul>
            <li>
                <strong>15 حملة رسمية</strong> بسرد مكتوب جيدًا،
                ومئات الحملات المجتمعية عبر خادم الإضافات المدمج.
            </li>
            <li>
                <strong>200+ نوع وحدة</strong> و16 عرقًا و6 فصائل
                رئيسية.
            </li>
            <li>
                <strong>محرر خرائط وحملات كامل</strong>، ما يجعلها
                منصة إبداعية لا لعبة فقط.
            </li>
            <li>
                <strong>جماعية محلية وأونلاين</strong> حتى 8
                لاعبين، مع تسجيل وإعادة تشغيل
                المباريات.
            </li>
        </ul>

        <p>
            منحنى التعلم سلس: يمكنك لعب الحملة الأولى دون قراءة دليل،
            لكن العمق التكتيكي (مكافآت التضاريس، وتفوق الوحدات،
            وتطور الخبرة) يستمر لسنوات. هذا هو الخيار الأول لمن
            يريد لعبة إستراتيجية <strong>مصقولة ومستقرة</strong>
            دون مفاجآت.
        </p>

        <h3>Unciv: Civilization V في جيبك</h3>

        <p>
            <strong>Unciv</strong> هو إعادة بناء مفتوحة المصدر
            لـCivilization V، مكتوبة بـLibGDX، وتعمل على Android
            وسطح المكتب. بدأت كمشروع مطور واحد في 2020، ثم نمت
            لتصبح واحدة من أنشط المشاريع في المجال.
        </p>

        <p>
            ميزتها أنها <strong>خفيفة جدًا</strong>: تعمل على
            أجهزة قديمة، وتستهلك ذاكرة قليلة. لكنها ليست “Civ V
            بكل ميزاتها”: تفتقد بعض الرسومات والتأثيرات، وبعض
            الآليات المتقدمة. ما تقدمه هو جوهر 4X: مدن، وحدات،
            دبلوماسية، بحث علمي، وفتوحات.
        </p>

        <p>
            إذا كنت تريد تجربة Civ على هاتفك أو على جهاز قديم،
            فهي الخيار. وإذا كنت تريد عمقًا بصريًا وميكانيكيًا
            كاملًا، فـFreeciv أو اللعبة الأصلية أنسب.
        </p>

        <h3>TripleA: إستراتيجية الألواح الرقمية</h3>

        <p>
            <strong>TripleA</strong> هو محرك ألعاب ألواح إستراتيجية
            بالأدوار، بدأ في 2002، ويشبه Axis & Allies وRisk.
            يأتي مع عدة ألعاب مدمجة، وأكثر من 100 لعبة يمكن
            تحميلها من المجتمع.
        </p>

        <p>
            ما يميزه أنه <strong>محرك</strong> لا لعبة واحدة: يمكنك
            إنشاء خرائط وسيناريوهات وقواعد، من الحرب العالمية
            الثانية إلى حروب خيالية. يدعم اللعب ضد الذكاء
            الاصطناعي، وhot-seat، والبريد الإلكتروني، وردهة
            أونلاين.
        </p>

        <p>
            إذا كنت تحب ألعاب الألواح الكبيرة، أو تريد إعادة خلق
            حملة تاريخية، فهو خيار فريد. وإذا كنت تريد رسومات
            حديثة، فهو ليس كذلك.
        </p>

        <h2 id="classic-4x">بناء الإمبراطوريات 4X: Freeciv</h2>

        <p>
            <strong>Freeciv</strong> هو أقدم استنساخ مفتوح
            لـCivilization، بدأ في 1996. الإصدار المستقر الحالي
            هو <strong>3.2.6</strong> (سبتمبر 2026)، وقد أعاد
            بناء الذكاء الاصطناعي بالكامل في سلسلة
            3.2.x.
        </p>

        <p>
            يقدم جوهر Civilization: مدن، وتقنيات، ودبلوماسية،
            وحروب، وعجائب. ما يميزه:
        </p>

        <ul>
            <li>
                <strong>حتى 30 لاعبًا</strong> في لعبة واحدة، وهو
                رقم لا تقدمه الألعاب التجارية عادة.
            </li>
            <li>
                <strong>قواعد قابلة للتعديل</strong> عبر
                rulesets، من العصور القديمة إلى السيناريوهات
                الخيالية.
            </li>
            <li>
                <strong>يعمل على أي جهاز تقريبًا</strong>، بما في
                ذلك نسخة ويب عبر Freeciv-web.
            </li>
        </ul>

        <p>
            حدوده: الرسومات قديمة، والواجهة أقل صقلًا من Civ
            الحديثة. لكن إذا كنت تريد <strong>عمق 4X</strong>
            دون دفع ثمن لعبة تجارية، فهو الخيار.
        </p>

        <h2 id="historical-rts">الحرب التاريخية في الوقت الحقيقي: 0 A.D.</h2>

        <p>
            <strong>0 A.D.</strong> بدأ في 2001 كمود لـAge of
            Empires II، ثم أصبح لعبة مستقلة. الإصدار الحالي
            <strong>0.28.0</strong> (فبراير 2026)، وما زال
            المشروع في مرحلة “ألفا” رغم قابليته للعب منذ
            2015.
        </p>

        <p>
            اللعبة تدور في العصور القديمة (500 ق.م – 500 م)، وتقدم
            <strong>13 حضارة</strong> قابلة للعب، من الأثينيين
            والفرس إلى الرومان والمقدونيين.
        </p>

        <p>ما يميزها عن Age of Empires:</p>

        <ul>
            <li>
                <strong>حدود الأراضي</strong> كآلية لعب، لا مجرد
                خريطة.
            </li>
            <li>
                <strong>رسومات ثلاثية الأبعاد</strong> أفضل من
                AoE2 الأصلية.
            </li>
            <li>
                <strong>دقة تاريخية</strong> في المباني والأسماء
                والوحدات.
            </li>
        </ul>

        <p>
            حدها الرئيسي: <strong>لا توجد حملة فردية مكتوبة</strong>
            مثل AoE. اللعب الأساسي هو مباريات اسكيرميش وأونلاين.
            وإذا كنت من محبي الحملات القصصية، فقد تشعر بنقص.
        </p>

        <h2 id="classic-rts">إحياء كلاسيكيات RTS: OpenRA</h2>

        <p>
            <strong>OpenRA</strong> هو إعادة بناء مفتوحة لمحرك
            Westwood الكلاسيكي، يدعم Command & Conquer وRed Alert
            وDune 2000. الإصدارات التجريبية في 2026 نشطة، وآخرها
            Playtest 20261011.
        </p>

        <p>ما يقدمه:</p>

        <ul>
            <li>
                <strong>الأصول مدمجة</strong>: لا تحتاج إلى أقراص
                اللعبة الأصلية.
            </li>
            <li>
                <strong>بنية تحتية حديثة لل multiplayer</strong>،
                مع توازن مجتمعي وتحديثات مستمرة.
            </li>
            <li>
                <strong>مولد خرائط عشوائي</strong> لـRed Alert
                وTiberian Dawn وDune 2000 (منذ فبراير 2026).
            </li>
            <li>
                <strong>حملة Dune 2000 مكتملة</strong> أخيرًا في
                إصدار أكتوبر 2026.
            </li>
            <li>
                <strong>الانتقال إلى .NET 10</strong>، ودعم
                Windows on ARM وAppImages لينكس.
            </li>
        </ul>

        <p>
            إذا كنت تحب RTS الكلاسيكية، أو تريد لعب Red Alert
            أونلاين بتوازن محسّن، فهو الخيار الأول. وإذا لم تلعب
            الأصل من قبل، فقد تبدو الرسومات قديمة، لكن اللعب
            نفسه ما زال قويًا.
        </p>

        <h2 id="large-scale-rts">RTS واسع النطاق: Beyond All Reason وZero-K</h2>

        <h3>Beyond All Reason (BAR)</h3>

        <p>
            <strong>Beyond All Reason</strong> هو أفضل RTS مجاني
            متاح الآن، وفق مراجعات 2026. هو مبني على محرك
            Spring/Recoil، ومستوحى من Total Annihilation وSupreme
            Commander: معارك بمئات الوحدات، وسلاسل مصانع، وإدارة
            طاقة، وتضاريس تؤثر فعلًا.
        </p>

        <p>
            في يونيو 2026، وقع فريق BAR اتفاق نشر مع Hooded Horse،
            ما يعني أن اللعبة ستصل إلى Steam مع حملة فردية، لكن
            <strong>الكود سيبقى مفتوحًا</strong> واللعبة ستبقى
            متاحة مجانًا عبر موقعها.
        </p>

        <p>
            يدعم اللعب الجماعي 1v1، وفرقًا حتى 8 لاعبين لكل
            جانب، وأوضاع تعاونية، واسكيرميش فردي. لا يوجد أي
            نموذج تحقيق دخل.
        </p>

        <h3>Zero-K</h3>

        <p>
            <strong>Zero-K</strong> هو RTS علمي خيالي يعمل على
            محرك Spring، ويتميز بوحدات ذكية ومقذوفات فيزيائية
            وواجهة قوية. الإصدار الأخير
            <strong>1.14.9.0</strong> (سبتمبر 2026) جاء بتحسينات
            رسومية ووحدة جديدة.
        </p>

        <p>
            يضم أكثر من <strong>100 وحدة فريدة</strong>، ويستخدم
            Lua بكثافة لتعديل الواجهة واللعب. مجاني بالكامل، دون
            أي عنصر يمكن فتحه بالدفع.
        </p>

        <p>
            الفرق بين BAR وZero-K: BAR أوسع نطاقًا وأكثر
            “ملحمية”، بينما Zero-K أكثر تركيزًا على التكتيك
            والتحكم الدقيق. كلاهما يستحق التجربة، لكن BAR أسهل
            للمبتدئ الذي يريد معارك ضخمة.
        </p>

        <h2 id="settlement-rts">بناء المستوطنات: Widelands</h2>

        <p>
            <strong>Widelands</strong> هو استنساخ مفتوح
            لـSettlers II، بدأ في 2001، ويحتفل هذا العام بـ24
            عامًا من التطوير. الإصدار المستقر
            <strong>1.3.1</strong> (فبراير 2026) أصلح مشكلة
            عدم تزامن جماعي خطيرة.
        </p>

        <p>
            اللعبة تركز على <strong>سلاسل الإنتاج</strong>: قطع
            الأشجار، ونشر المناشر، وبناء الثكنات، وصناعة الأسلحة.
            خمس قبائل قابلة للعب: البرابرة، والإمبراطورية،
            والأطلنطيون، والفريزيون، والأمازونيات، لكل منها
            مبانيها وشجرة تقنياتها.
        </p>

        <p>
            ما يميزها عن RTS العسكرية: الاقتصاد هو اللعبة. إذا
            كنت تحب بناء شبكات إنتاج معقدة ومشاهدة “رجالك
            الصغار” ينقلون الأخشاب، فهي لك. وإذا كنت تريد معارك
            سريعة، فقد تبدو بطيئة.
        </p>

        <p>
            نقطة مثيرة: الفريق رفض رسميًا أي مساهمات مولدة
            بالذكاء الاصطناعي بسبب مخاوف حقوق النشر.
        </p>

        <h2 id="post-apocalyptic-rts">ما بعد الكارثة: Warzone 2100</h2>

        <p>
            <strong>Warzone 2100</strong> صدر تجاريًا في 1999، ثم
            أُطلق كوده المصدري في 2004. الإصدار الحالي
            <strong>4.7.0</strong> (أبريل 2026)، وهو إصدار كبير
            بعد سلسلة إصلاحات.
        </p>

        <p>ما يجعله فريدًا:</p>

        <ul>
            <li>
                <strong>مصمم وحدات</strong>: يمكنك تركيب الهيكل
                والدفع والسلاح لإنشاء وحدات مخصصة.
            </li>
            <li>
                <strong>أكثر من 400 تقنية</strong> في شجرة
                تقنيات واسعة.
            </li>
            <li>
                <strong>حملة فردية قصصية</strong>، وmultiplayer
                عبر LAN والإنترنت، واسكيرميش ضد الذكاء
                الاصطناعي.
            </li>
            <li>
                <strong>أكثر من 3.4 مليون تحميل</strong> و21+
                عامًا من التطوير المجتمعي.
            </li>
        </ul>

        <p>
            إذا كنت تحب RTS بقصة، وبناء قاعدة، وتخصيص وحدات، فهو
            من أفضل الخيارات. رسوماته قديمة، لكن عمقه ما زال
            قويًا.
        </p>

        <h2 id="factory-strategy">الإستراتيجية الصناعية: Mindustry</h2>

        <p>
            <strong>Mindustry</strong> ليس RTS تقليديًا. إنه لعبة
            بناء مصانع مع عناصر دفاع أبراج وRTS. تنشئ سلاسل
            توريد معقدة لتغذية أبراجك بالذخيرة، وتنتج مواد
            للبناء، وتبني وحدات.
        </p>

        <p>
            الإصدار <strong>8.0</strong> (2026) جاء بعد عامين
            ونصف من التطوير، وركز على تحسين حملة Serpulo، وتحسين
            التحكم بالوحدات، وترقية المحرك إلى Java 25 وSDL3 على
            سطح المكتب.
        </p>

        <p>
            تعمل على Windows وmacOS وLinux وAndroid وiOS، وتدعم
            اللعب الجماعي التعاوني عبر المنصات. إذا كنت تحب
            Factorio لكنك تريد شيئًا أخف وأكثر تركيزًا على
            الدفاع، فهي خيار ممتاز.
        </p>

        <h2 id="other-notable">ألعاب أخرى تستحق التجربة</h2>

        <ul>
            <li>
                <strong>MegaGlest:</strong> RTS ثلاثية الأبعاد
                بإعدادات القرون الوسطى والسحر، مع دروس
                وسيناريوهات واسكيرميش قابلة للتخصيص. الإصدار
                3.13.0 نشط في 2026.
            </li>
            <li>
                <strong>Bos Wars:</strong> RTS مستقبلية خفيفة،
                ما زالت تُحزم في توزيعات 2026.
            </li>
            <li>
                <strong>OpenDungeons:</strong> RTS مستوحاة من
                Dungeon Keeper وEvil Genius، ما زالت قيد
                التطوير.
            </li>
            <li>
                <strong>Ancient Beast:</strong> لعبة تكتيكية
                بالأدوار تركز على التحكم بالوحوش، ومفتوحة
                المصدر.
            </li>
        </ul>

