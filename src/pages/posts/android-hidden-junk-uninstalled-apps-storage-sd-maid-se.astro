---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "android-hidden-junk-uninstalled-apps-storage-sd-maid-se",
    title: "أندرويد يخزّن جيجابايتات من الملفات المؤقتة: لماذا حذف التطبيق لا يحذفه كاملاً",
    metaTitle: "أندرويد يخزّن ملفات مؤقتة: لماذا حذف التطبيق لا يحذفه كاملاً",
    description:
        "حذف التطبيق من أندرويد يترك وراءه بيانات مخفية في مجلدات Android/data و Android/OBB — جيجابايتات من الملفات التي لا يراها مدير الملفات الافتراضي. SD Maid SE يكتشفها ويحذفها بضغطة زر واحدة.",
    keywords: [
        "أندرويد",
        "تخزين",
        "تنظيف الملفات",
        "SD Maid SE",
        "CorpseFinder",
        "Android storage",
        "Scoped Storage",
        "حذف التطبيقات",
        "بيانات مخفية",
        "ذاكرة",
    ],
    category: "أندرويد",
    author: "طلال عمران",
    date: "3 أغسطس 2026",
    pubDate: new Date("2026-08-03"),
    tags: ["أندرويد", "تخزين", "تنظيف", "SD Maid", "Google"],
    thumbnail: "/images/android-hidden-junk-uninstalled-apps-storage-sd-maid-se.webp",
};
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            اعتقد دائماً أن حذف تطبيق من أندرويد يعني اختفاء كل بيانات ذلك
            التطبيق — لكن هذا وهم خطير. الحقيقة أن <strong
                >معظم التطبيقات تترك خلفها جيجابايتات من البيانات المخفية</strong
            > في مجلدات نظام الملفات التي لا يراها مدير الملفات الافتراضي.
        </p>

        <h2>ما الذي يحدث عند حذف تطبيق؟</h2>

        <p>
            عندما تضغط على حذف تطبيق، أندرويد يحذف فقط البيانات المرتبطة بصندوق
            التطبيق الخاص به — التخزين الداخلي والـ cache. لكن العديد من
            التطبيقات تحفظ بيانات إضافية خارج هذا الصندوق:
        </p>

        <ul>
            <li>
                <strong>التنزيلات والنسخ الاحتياطية:</strong> في مجلد التنزيلات المشترك
            </li>
            <li>
                <strong>موارد الألعاب:</strong> الخرائط والملفات الإضافية الكبيرة
            </li>
            <li>
                <strong>ملفات الوسائط:</strong> الصور والفيديوهات والبيانات المخزنة
            </li>
            <li><strong>بيانات يدوية:</strong> ملفات أنشأها المستخدم</li>
            <li>
                <strong>ملفات يتيمة:</strong> بيانات متبقية من عمليات فك التثبيت المقاطعة
            </li>
        </ul>

        <h2>مثال واقعي: Call of Duty Mobile</h2>

        <p>
            اختبرت حذف لعبة Call of Duty Mobile لأرى كم بيانات تترك خلفها.
            الحصيلة؟ <strong>1.5 جيجابايت من الملفات في مجلد OBB</strong> لم تُحذف
            رغم حذف التطبيق بالكامل. هذه الملفات تشمل الخرائط والموارد الإضافية القابلة
            للتنزيل.
        </p>

        <h2>لماذا لا يراها مدير الملفات الافتراضي؟</h2>

        <p>
            أندرويد 10 قدّم ميزة <strong>Scoped Storage</strong> عزلت كل تطبيق في
            صندوق خاص به، وأصبحت إجبارية منذ أندرويد 11. هذا يعني أن النظام يحظر وصول
            مدير الملفات الافتراضي للمجلدات التالية:
        </p>

        <ul>
            <li>Android/data</li>
            <li>Android/obb</li>
            <li>ومجلدات خاصة بتطبيقات أخرى</li>
        </ul>

        <p>
            بينما تطبيقات الملفات الخارجية قد تحصل على وصول محدود عبر Storage
            Access Framework، هذا لا يزال عملية يدوية مملة — تحتاج للبحث عن كل
            مجلد وحذفه بشكل منفصل.
        </p>

        <h2>الحل: SD Maid SE و CorpseFinder</h2>

        <p>
            التطبيق <strong>SD Maid SE</strong> — وخاصة ميزة <strong
                >CorpseFinder</strong
            > — يحل هذه المشكلة بنقرة زر واحدة. المطور حرفياً يدعو هذه البيانات المتبقية
            <strong>"corpse"</strong> (جثة). التطبيق:
        </p>

        <ul>
            <li>ينظر في جميع المجلدات المخفية تلقائياً</li>
            <li>يحدد كل البيانات المتبقية من التطبيقات المحذوفة</li>
            <li>يحذفها بضغطة زر واحدة دون البحث اليدوي</li>
        </ul>

        <h2>النتائج الفعلية</h2>

        <p>
            استخدام CorpseFinder مع أدوات SD Maid الأخرى حرر <strong
                >8.4 جيجابايت من التخزين</strong
            > على هاتف واحد فقط. تخيل كم جيجابايت مخبأة على جهازك الآن.
        </p>

        <h2>قبل حذف التطبيقات: تحقق من قسم "الآخر"</h2>

        <p>
            قبل أن تحذف تطبيقات أو وسائط، ننصح بفتح قسم <strong>"Other"</strong> في
            إعدادات التخزين. هناك ستجد الغالبية العظمى من الملفات المؤقتة المتراكمة من الذاكرة
            المؤقتة والبيانات المتبقية من التطبيقات المحذوفة.
        </p>

        <h2>حيث الحصول على SD Maid SE</h2>

        <ul>
            <li>
                <strong>Google Play:</strong> نسخة مجانية مع ميزات مدفوعة للدعم الإضافي
            </li>
            <li><strong>GitHub:</strong> مفتوح المصدر بالكامل</li>
            <li><strong>F-Droid:</strong> نسخة خاصة لمستخدمي المتجر المفتوح</li>
        </ul>

        <p>
            أندرويد يحتفظ بأسراره بعناية — لكن مع الأداة الصحيحة، يمكنك استعادة
            الجيجابايتات المخفية التي تُهدر على بيانات لتطبيقات لم تعد موجودة.
        </p>

        <h3>المصدر:</h3>
        <p>
            <a
                href="https://www.makeuseof.com/best-android-storage-trick-isnt-deleting-apps-its-clearing-system-folder/"
                target="_blank"
                rel="noopener noreferrer"
            >
                MakeUseOf
            </a>
        </p>
    </PostLayout>
</BaseLayout>
