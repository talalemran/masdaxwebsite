---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "android-open-source-customization-security-challenges",
    title: "أندرويد مفتوح المصدر: بين مرونة التخصيص وتحديات الأمان",
    metaTitle: "أندرويد مفتوح المصدر: مرونة التخصيص مقابل تحديات الأمان",
    description:
        "تحليل معمق لأندرويد مفتوح المصدر (AOSP): كيف تمنح مرونة التخصيص تنوعًا هائلًا، وكيف تخلق تحديات أمان حقيقية؟ إحصائيات التحديثات، Project Treble وMainline، GrapheneOS، ومستقبل الانفتاح مع قيود جوجل الجديدة.",
    keywords: [
        "أندرويد مفتوح المصدر",
        "AOSP",
        "أمان أندرويد",
        "تخصيص أندرويد",
        "Project Treble",
        "Project Mainline",
        "GrapheneOS",
        "تحديثات أندرويد",
        "Android security",
        "تجزئة أندرويد",
    ],
    category: "أندرويد",
    author: "طلال عمران",
    date: "1 نوفمبر 2026",
    pubDate: new Date("2026-11-01"),
    tags: ["أندرويد", "أمان", "مفتوح المصدر", "AOSP", "تخصيص"],
    thumbnail: "/images/android-open-source-customization-security-challenges.webp",
};

const tocItems = [
    { id: "at-a-glance", label: "نظرة سريعة: خريطة AOSP بين المرونة والأمان" },
    { id: "what-is-aosp", label: "ما هو AOSP بالضبط؟ وما الفرق بينه وبين أندرويد جوجل؟" },
    { id: "flexibility-wins", label: "مرونة التخصيص: كيف تغير AOSP قواعد اللعبة؟" },
    { id: "fragmentation-cost", label: "ثمن التجزئة: عندما تصبح المرونة عبئًا أمنيًا" },
    { id: "deep-customization-risks", label: "مخاطر التخصيص العميق: مفاتيح اختبار وحلول أمنية مكسورة" },
    { id: "update-crisis", label: "أزمة التحديثات: 42% من الأجهزة خارج الدعم" },
    { id: "treble-mainline", label: "Project Treble وMainline: هل أنقذا الموقف؟" },
    { id: "custom-roms", label: "الروم المخصصة: GrapheneOS وCalyxOS وLineageOS" },
    { id: "aosp-vs-ios", label: "AOSP مقابل iOS: أيهما أكثر أمانًا فعليًا؟" },
    { id: "google-control", label: "جوجل تشد الحبل: التحقق من المطورين وAOSP مرتين سنويًا" },
    { id: "balance", label: "كيف توازن بين المرونة والأمان؟" },
    { id: "final-checklist", label: "قائمة تحقق نهائية" },
    { id: "useful-links", label: "روابط ومصادر مفيدة" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            أندرويد هو نظام التشغيل الأكثر انتشارًا في العالم، بحصة
            تتجاوز 69% من سوق الهواتف الذكية. لكن الجزء الأكثر
            إثارة للجدل فيه ليس متجر التطبيقات ولا خدمات جوجل، بل
            <strong>الأساس المفتوح المصدر</strong> الذي بُني عليه:
            مشروع أندرويد مفتوح المصدر (AOSP). هذا الأساس هو ما يمنح
            الشركات المصنعة والمطورين حرية بناء أنظمة مختلفة، وهو في
            الوقت نفسه ما يخلق أعقد تحديات الأمان في أي نظام تشغيل
            رئيسي.
        </p>

        <p>
            هذا الدليل لا يكتفي بوصف AOSP بأنه “مفتوح” أو “غير آمن”،
            بل يفكك العلاقة بين المرونة والأمان: لماذا تنتج التخصيصات
            العميقة ثغرات لا تظهر في نظام مغلق؟ وكيف تتعامل جوجل مع
            هذه المشكلة عبر Project Treble وMainline؟ وأين تقف الروم
            المخصصة مثل GrapheneOS من كل هذا؟ وأخيرًا، هل تستطيع
            AOSP أن تبقى مفتوحة فعلًا في 2026، أم أن سياسات جوجل
            الجديدة تغير المعادلة؟
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {tocItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <h2 id="at-a-glance">نظرة سريعة: خريطة AOSP بين المرونة والأمان</h2>

        <p>
            الجدول التالي يلخص المحاور الأساسية التي يغطيها المقال،
            قبل الدخول في التفاصيل:
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المحور</th>
                        <th class="px-4 py-2 font-semibold">المرونة</th>
                        <th class="px-4 py-2 font-semibold">التحدي الأمني</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">تنوع الأجهزة</td>
                        <td class="px-4 py-2">هواتف بكل الأسعار والأشكال</td>
                        <td class="px-4 py-2">تحديثات غير متساوية بين الشركات</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">تخصيص النظام</td>
                        <td class="px-4 py-2">واجهات وخدمات مختلفة</td>
                        <td class="px-4 py-2">ثغرات في التخصيصات العميقة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">الروم المخصصة</td>
                        <td class="px-4 py-2">تحكم كامل، إزالة جوجل</td>
                        <td class="px-4 py-2">تأخر التحديثات، عبء أمني على المستخدم</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">دورة الإصدارات</td>
                        <td class="px-4 py-2">وصول أسرع للمطورين</td>
                        <td class="px-4 py-2">خفضها إلى مرتين سنويًا يؤخر الرقع</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">التحقق من التطبيقات</td>
                        <td class="px-4 py-2">تثبيت من مصادر حرة</td>
                        <td class="px-4 py-2">انتشار برمجيات خبيثة أعلى 90 مرة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">حالة التحديثات (2026)</td>
                        <td class="px-4 py-2">58% فقط على إصدار مدعوم</td>
                        <td class="px-4 py-2">42% خارج الدعم الأمني</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h2 id="what-is-aosp">ما هو AOSP بالضبط؟ وما الفرق بينه وبين أندرويد جوجل؟</h2>

        <p>
            <img
                src="/images/articles/android-open-source-customization-security-challenges/01.webp"
                alt="أندرويد مفتوح المصدر"
                width="1200"
                height="675"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>


        <p>
            <strong>AOSP</strong> هو الاسم الذي يطلق على الشيفرة المصدرية
            المفتوحة لنظام أندرويد، والتي تديرها جوجل. يشمل النظام
            الأساسي، وإطار التطبيقات، وخدمات النظام، وبعض التطبيقات
            الافتراضية. أي شركة يمكنها تنزيل هذه الشيفرة، وبناؤها،
            وتعديلها، وإصدارها على أجهزتها دون دفع ترخيص لجوجل.
        </p>

        <p>
            لكن AOSP ليس هو “أندرويد” الذي يستخدمه معظم الناس. الهاتف
            الذي تشتريه من سامسونج أو شاومي أو جوجل نفسها لا يعمل
            بـAOSP الخام، بل بنسخة معدلة تضيف طبقات كثيرة:
        </p>

        <ul>
            <li>
                <strong>واجهة المستخدم:</strong> One UI من سامسونج،
                وMIUI من شاومي، وPixel UI من جوجل.
            </li>
            <li>
                <strong>خدمات جوجل للهواتف (GMS):</strong> متجر
                Play، وخدمات Play، والتطبيقات الأساسية مثل الخرائط
                وجيميل. هذه <strong>ليست مفتوحة المصدر</strong>،
                وتتطلب ترخيصًا من جوجل.
            </li>
            <li>
                <strong>تعريفات العتاد:</strong> برامج تشغيل
                المعالج والكاميرا والشاشة، التي تختلف بين
                الشركات.
            </li>
        </ul>

        <p>
            هذا التمييز هو أصل كل النقاش: AOSP مفتوح، لكن
            <strong>الأندرويد الفعلي</strong> في يد المستخدم هو
            مزيج من مفتوح ومغلق، ومن مسؤوليات موزعة بين جوجل
            والشركة المصنعة. وعندما نتحدث عن “تحديات أمان أندرويد
            مفتوح المصدر”، فإننا نتحدث عن هذه الطبقات مجتمعة، لا عن
            AOSP وحده.
        </p>

        <h2 id="flexibility-wins">مرونة التخصيص: كيف تغير AOSP قواعد اللعبة؟</h2>

        <p>
            مرونة AOSP ليست ميزة ثانوية. إنها السبب في أن أندرويد
            أصبح النظام المهيمن عالميًا. أربعة أشكال من المرونة تنتج
            مباشرة من كون الشيفرة مفتوحة:
        </p>

        <ul>
            <li>
                <strong>تنوع الأجهزة:</strong> يمكن لشركة صغيرة
                في سوق ناشئ أن تبني هاتفًا ذكيًا بتكلفة منخفضة
                دون تطوير نظام من الصفر. هذا ما يجعل هواتف
                بأسعار مختلفة جدًا متاحة لمليارات
                المستخدمين.
            </li>
            <li>
                <strong>تخصيص السوق المحلي:</strong> شركات مثل
                شاومي وOppo وVivo بنت واجهات وخدمات تناسب
                أسواقها. هذه التخصيصات ليست “تجميلًا” فقط، بل
                تستجيب لاحتياجات محلية في اللغة والدفع
                والخدمات.
            </li>
            <li>
                <strong>الروم المخصصة:</strong> يستطيع المجتمع
                بناء أنظمة كاملة مثل <strong>LineageOS</strong>
                و<strong>GrapheneOS</strong> و<strong>CalyxOS</strong>،
                بعضها يقدم أمانًا أعلى من النظام الأصلي.
            </li>
            <li>
                <strong>الابتكار:</strong> ميزات كثيرة ظهرت أولًا
                في تخصيصات الشركات، ثم انتقلت إلى AOSP. المنافسة
                بين الشركات على الواجهات تدفع الابتكار بسرعة
                أكبر من نظام واحد مغلق.
            </li>
        </ul>

        <p>
            هذه المرونة هي ما يجعل أندرويد “نظام الجميع”، لا نظام
            شركة واحدة. لكن الثمن هو أن <strong>الجودة الأمنية
            تتفاوت بشكل هائل</strong> بين جهاز وآخر، حتى داخل
            الطراز نفسه في بعض الأحيان.
        </p>

        <h2 id="fragmentation-cost">ثمن التجزئة: عندما تصبح المرونة عبئًا أمنيًا</h2>

        <p>
            التجزئة ليست مجرد “إصدارات كثيرة”. إنها تعني أن
            <strong>مسؤولية الأمان موزعة</strong> بين جوجل (التي
            تطور AOSP)، والشركة المصنعة (التي تبني النسخة النهائية)،
            ومزود الشريحة (التي توفر تعريفات العتاد). وعندما يتخلى
            أي طرف عن مسؤوليته، يتوقف الدعم.
        </p>

        <p>
            المشكلة أن الشركات المصنعة غالبًا ما توقف الدعم بعد
            سنوات قليلة، خصوصًا في الفئة المتوسطة والمنخفضة. النتيجة
            أن أجهزة كثيرة تبقى تعمل، لكنها <strong>لا تتلقى
            تحديثات أمنية</strong>، وتصبح عرضة لثغرات معروفة
            ومعلنة. وهذا ليس خطرًا نظريًا: الثغرات القديمة هي
            أكثر ما يُستغل فعليًا، لأن أدوات استغلالها متاحة
            للجميع.
        </p>

        <h2 id="deep-customization-risks">مخاطر التخصيص العميق: مفاتيح اختبار وحلول أمنية مكسورة</h2>

        <p>
            أخطر أشكال التخصيص ليس تغيير الواجهة، بل تعديل
            <strong>آليات الأمان الأساسية</strong> أثناء بناء
            النظام. مثال صارخ ظهر في 2026: ثغرة
            <strong>CVE-2026-107153</strong> في هواتف Rakuten
            Mobile، حيث استخدمت الشركة <strong>مفاتيح اختبار
            AOSP</strong> لتوقيع نظام Android Verified Boot (AVB)
            بدلًا من مفاتيح إنتاج خاصة بها.
        </p>

        <p>
            ماذا يعني ذلك عمليًا؟ AVB هو نظام التحقق من أن النظام
            الذي يعمل على الجهاز هو النظام الأصلي غير المعدل. إذا
            استُخدمت مفاتيح اختبار معروفة للجميع، فإن أي شخص لديه
            وصول مادي إلى الجهاز يمكنه تثبيت صورة نظام معدلة تحتوي
            على برمجيات خبيثة، وسيقبلها الجهاز باعتبارها “موقعة
            رسميًا”. الثغرة ليست في AOSP نفسه، بل في
            <strong>قرار التخصيص</strong> الذي اتخذته الشركة أثناء
            الإنتاج.
        </p>

        <p>
            هذا المثال يوضح نقطة أوسع: المرونة تسمح ببناء نظام آمن،
            لكنها تسمح أيضًا ببناء نظام <strong>يبدو آمنًا</strong>
            وهو ليس كذلك. والأخطر أن المستخدم لا يستطيع التمييز
            بسهولة. دراسة أكاديمية في 2026 وجدت أن تخصيصات الشركات
            لإدارة الصلاحيات قد تمنح تطبيقات وصولًا لا يفترض أن
            تحصل عليه، أو تبقي الوصول قائمًا بعد إلغاء الإذن.
        </p>

        <p>
            باختصار: التخصيص العميق يفتح بابًا للإبداع، لكنه يفتح
            في الوقت نفسه بابًا للأخطاء الأمنية التي لا تظهر في
            نظام مغلق تتحكم فيه جهة واحدة.
        </p>

        <h2 id="update-crisis">أزمة التحديثات: 42% من الأجهزة خارج الدعم</h2>

        <p>
            الأرقام وحدها تحكي القصة. في فبراير 2026، كشفت بيانات
            جوجل أن <strong>42% من هواتف أندرويد النشطة</strong>
            — أكثر من مليار جهاز — تعمل بإصدارات لم تعد تتلقى
            تحديثات أمنية رسمية. وأحدث إصدار، Android 16، كان
            مثبتًا على <strong>7.5%</strong> فقط من الأجهزة.
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">إصدار أندرويد</th>
                        <th class="px-4 py-2 font-semibold">نسبة الأجهزة (ديسمبر 2025)</th>
                        <th class="px-4 py-2 font-semibold">حالة الدعم الأمني</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">Android 16</td>
                        <td class="px-4 py-2">7.5%</td>
                        <td class="px-4 py-2">مدعوم</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">Android 15</td>
                        <td class="px-4 py-2">19.3%</td>
                        <td class="px-4 py-2">مدعوم</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">Android 14</td>
                        <td class="px-4 py-2">17.2%</td>
                        <td class="px-4 py-2">مدعوم</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">Android 13</td>
                        <td class="px-4 py-2">13.9%</td>
                        <td class="px-4 py-2">الحد الأدنى المدعوم</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">Android 12 وأقدم</td>
                        <td class="px-4 py-2">42.1%</td>
                        <td class="px-4 py-2">خارج الدعم الأمني</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p>
            للمقارنة، في يناير 2026 كان <strong>60% من مستخدمي
            iPhone</strong> على iOS 26 الأحدث، و37% على iOS 18،
            وكلاهما يتلقى تحديثات أمنية. الفارق ليس في جودة
            المهندسين، بل في <strong>نموذج التوزيع</strong>:
            آبل تتحكم في العتاد والنظام معًا، بينما أندرويد يوزع
            المسؤولية على سلسلة طويلة من الشركات.
        </p>

        <h2 id="treble-mainline">Project Treble وMainline: هل أنقذا الموقف؟</h2>

        <p>
            جوجل لم تقف مكتوفة الأيدي. مشروعان رئيسيان حاولا معالجة
            المشكلة من جذورها:
        </p>

        <h3>Project Treble (2017)</h3>

        <p>
            Treble فصل <strong>إطار نظام أندرويد</strong> عن
            <strong>تعريفات العتاد الخاصة بالشركة المصنعة</strong>.
            قبل Treble، كانت كل تحديث يتطلب من الشركة إعادة دمج
            تعريفاتها مع النظام الجديد، وهي عملية بطيئة ومكلفة.
            بعد Treble، أصبح تحديث النظام الأساسي أسهل، لأن طبقة
            التعريفات منفصلة.
        </p>

        <h3>Project Mainline (2019)</h3>

        <p>
            Mainline ذهب خطوة أبعد: جزّأ مكونات أساسية في النظام
            (مثل مدقق الوسائط، ومسؤول الشبكة، وخدمات الأمان) بحيث
            يمكن تحديثها <strong>مباشرة عبر متجر Play</strong>، دون
            انتظار الشركة المصنعة. هذا يعني أن ثغرة في أحد هذه
            المكونات يمكن رقعها لكل الأجهزة المدعومة في وقت واحد،
            لا جهازًا جهازًا.
        </p>

        <p>
            النتائج جزئية. Treble وMainline حسّنا الوضع، لكنهما لم
            يحلا المشكلة الأساسية: <strong>الأجهزة القديمة التي
            لم تعد الشركة المصنعة تدعمها</strong> لا تتلقى تحديثات
            Mainline إلا إذا كانت تعمل بإصدار أندرويد حديث بما يكفي.
            والأجهزة التي تعمل بـAndroid 12 أو أقدم خارج نطاق
            التغطية.
        </p>

        <h2 id="custom-roms">الروم المخصصة: GrapheneOS وCalyxOS وLineageOS</h2>

        <p>
            إذا كانت النسخ الرسمية غير كافية، فإن مرونة AOSP تسمح
            ببناء بدائل. الروم المخصصة هي الوجه الآخر للتخصيص:
            بدلًا من أن تتحكم الشركة المصنعة في الأمان، يتولى
            المجتمع أو فريق مستقل هذه المسؤولية.
        </p>

        <h3>GrapheneOS</h3>

        <p>
            <strong>GrapheneOS</strong> هو الروم المخصص الأكثر
            تشددًا أمنيًا. يعمل على أجهزة Google Pixel (لأنها
            توفر دعmًا أفضل للأمان العتادي)، ويضيف طبقات تعزيز
            تتجاوز AOSP:
        </p>

        <ul>
            <li>
                <strong>Vanadium WebView:</strong> محرك ويب
                مقوّى يفرض عمليات 64-بت ويعطل العمليات القديمة.
            </li>
            <li>
                <strong>hardened_malloc:</strong> مخصص ذاكرة
                مقوّى يغلق فئات كاملة من ثغرات فساد
                الذاكرة.
            </li>
            <li>
                <strong>تعزيز النواة:</strong> مبني على
                linux-hardened وKernel Self Protection
                Project.
            </li>
            <li>
                <strong>Sandboxed Google Play:</strong> إذا
                احتجت خدمات جوجل، تعمل داخل بيئة معزولة
                بصلاحيات محدودة، لا كجزء من النظام.
            </li>
        </ul>

        <p>
            GrapheneOS ليس بديلًا “للمستخدم العادي” بالضرورة، لكنه
            يثبت نقطة مهمة: <strong>AOSP يمكن أن يكون أكثر أمانًا
            من iOS</strong> إذا بُني بالطريقة الصحيحة.
        </p>

        <h3>CalyxOS وLineageOS</h3>

        <p>
            <strong>CalyxOS</strong> يركز على الخصوصية مع توافق
            أوسع، ويستخدم microG بدلًا من خدمات جوجل الكاملة.
            توقف تطويره مؤقتًا في 2025، ثم عاد في يوليو 2026
            بإصدار 7.2.2.0. <strong>LineageOS</strong> هو
            الروم المخصص الأوسع انتشارًا، ويدعم مئات الأجهزة،
            لكنه لا يقدم نفس مستوى التعزيز الأمني العميق الذي
            يقدمه GrapheneOS.
        </p>

        <p>
            المفارقة أن الروم المخصصة تعاني من مشكلة التحديثات
            نفسها: إذا توقف الفريق عن العمل، يتوقف الدعم. وهذا
            يضع عبء الأمان على المستخدم، الذي قد لا يملك الخبرة
            لتقييم المخاطر.
        </p>

        <h2 id="aosp-vs-ios">AOSP مقابل iOS: أيهما أكثر أمانًا فعليًا؟</h2>

        <p>
            السؤال ليس “أيهما أكثر أمانًا” بشكل مطلق، بل “أي
            نموذج أمان يناسبك”. الجدول التالي يلخص الفروق:
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المعيار</th>
                        <th class="px-4 py-2 font-semibold">AOSP (والنسخ المبنية عليه)</th>
                        <th class="px-4 py-2 font-semibold">iOS</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">نموذج الأمان</td>
                        <td class="px-4 py-2">مفتوح، قابل للتخصيص، مسؤولية موزعة</td>
                        <td class="px-4 py-2">مغلق، متحكم مركزيًا</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">سرعة التحديثات</td>
                        <td class="px-4 py-2">متفاوتة، تعتمد على الشركة المصنعة</td>
                        <td class="px-4 py-2">موحدة وسريعة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">مدة الدعم</td>
                        <td class="px-4 py-2">2–7 سنوات حسب الجهاز</td>
                        <td class="px-4 py-2">5–7 سنوات موحدة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">الشفافية</td>
                        <td class="px-4 py-2">عالية (يمكن تدقيق AOSP)</td>
                        <td class="px-4 py-2">منخفضة (كود مغلق)</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">أعلى مستوى أمان ممكن</td>
                        <td class="px-4 py-2">GrapheneOS قد يتجاوز iOS</td>
                        <td class="px-4 py-2">ممتاز في الإعداد الافتراضي</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">الأمان الافتراضي للمستخدم العادي</td>
                        <td class="px-4 py-2">جيد إذا كان الجهاز مدعومًا</td>
                        <td class="px-4 py-2">أفضل بشكل عام</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p>
            الخلاصة: iOS أكثر أمانًا <strong>افتراضيًا</strong>
            لمعظم المستخدمين، لأن كل شيء يعمل معًا تحت سيطرة
            واحدة. لكن AOSP يسمح ببناء نظام أكثر أمانًا
            <strong>إذا كنت تعرف ما تفعله</strong>. المشكلة أن
            “معرفة ما تفعله” ليست مهارة شائعة.
        </p>

        <h2 id="google-control">جوجل تشد الحبل: التحقق من المطورين وAOSP مرتين سنويًا</h2>

        <p>
            في 2026، بدأت جوجل تضيّق المساحة التي كانت تجعل AOSP
            جذابًا للمجتمع. تغييران كبيران يثيران القلق:
        </p>

        <h3>1. خفض إصدارات AOSP إلى مرتين سنويًا</h3>

        <p>
            بدأت جوجل في 2026 بنشر شيفرة AOSP <strong>مرتين في
            السنة فقط</strong> بدلًا من أربع مرات. هذا يعني أن
            مجتمعات الروم المخصصة مثل LineageOS وGrapheneOS ستنتظر
            فترات أطول للحصول على التحديثات، وقد تتأخر الرقع
            الأمنية في الوصول إليها.
        </p>

        <h3>2. التحقق من هوية المطورين</h3>

        <p>
            من سبتمبر 2026، أصبح على كل مطور تطبيقات أندرويد
            <strong>التحقق من هويته</strong> لدى جوجل، حتى لو كان
            يوزع تطبيقه خارج متجر Play. الهدف المعلن هو مكافحة
            البرمجيات الخبيثة، لكن المنتقدين يرون أنه يقلص
            حرية التوزيع، ويجعل جوجل بوابة لكل تطبيق على النظام.
        </p>

        <p>
            جوجل تبرر ذلك بأن التطبيقات المثبتة عبر sideloading
            تحمل خطر برمجيات خبيثة أعلى <strong>90 مرة</strong> من
            تلك المثبتة عبر Play. لكن السؤال الذي يطرحه المجتمع:
            هل الحل هو تقييد الجميع، أم تحسين الكشف؟
        </p>

        <h2 id="balance">كيف توازن بين المرونة والأمان؟</h2>

        <p>
            لا يوجد حل سحري، لكن هناك مبادئ عملية تقلل المخاطر:
        </p>

        <ul>
            <li>
                <strong>اختر جهازًا بسياسة تحديث واضحة.</strong>
                إذا كنت تشتري هاتفًا جديدًا، ابحث عن عدد سنوات
                الدعم الأمني المعلنة. Pixel وSamsung يقدمان
                الآن دعمًا يصل إلى 7 سنوات، وهذا يغير
                المعادلة.
            </li>
            <li>
                <strong>لا تفترض أن جهازًا “مفتوحًا” آمن.</strong>
                الروم المخصصة تحتاج إلى فريق نشط، وتحديثات
                منتظمة، وسمعة موثوقة.
            </li>
            <li>
                <strong>استخدم التحقق من الإقلاع (Verified
                Boot) حيثما أمكن.</strong> هذا يمنع تثبيت
                أنظمة معدلة دون علمك.
            </li>
            <li>
                <strong>راقب نهاية دعم جهازك.</strong> عندما
                يتوقف الدعم، إما تنتقل إلى روم مخصص نشط، أو
                تغير الجهاز. لا تفترض أن “الجهاز يعمل” يعني أنه
                آمن.
            </li>
            <li>
                <strong>كن حذرًا مع sideloading.</strong> إذا
                كنت تثبت تطبيقات من خارج المتجر، فافعل ذلك من
                مصادر تثق بها، وتأكد من التوقيعات.
            </li>
        </ul>

        <h2 id="final-checklist">قائمة تحقق نهائية</h2>

        <ul>
            <li>
                هل تعرف الفرق بين AOSP وأندرويد جوجل؟ ←
                <strong>ضروري لفهم أي نقاش عن الأمان</strong>
            </li>
            <li>
                هل جهازك لا يزال يتلقى تحديثات أمنية؟ ←
                <strong>تحقق من إصدار Android ومسار التحديثات</strong>
            </li>
            <li>
                هل تعتمد على روم مخصص؟ ←
                <strong>تأكد من نشاط الفريق وتواتر التحديثات</strong>
            </li>
            <li>
                هل تستخدم خدمات جوجل؟ ←
                <strong>افهم ما تشاركه، أو استخدم بدائل معزولة</strong>
            </li>
            <li>
                هل تثبت تطبيقات من خارج المتجر؟ ←
                <strong>تحقق من المصدر والتوقيع</strong>
            </li>
            <li>
                هل تعرف سياسة دعم الشركة المصنعة؟ ←
                <strong>ابحث عن سنوات الدعم الأمني المعلنة</strong>
            </li>
            <li>
                هل تفترض أن “مفتوح المصدر” يعني “آمن”؟ ←
                <strong>الأمان يعتمد على التنفيذ والتحديثات</strong>
            </li>
            <li>
                هل تستخدم جهازًا قديمًا؟ ←
                <strong>فكر في روم مخصص نشط أو ترقية</strong>
            </li>
        </ul>

