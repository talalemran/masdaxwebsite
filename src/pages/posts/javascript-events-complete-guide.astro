---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "javascript-events-complete-guide",
    title: "الأحداث (Events) في JavaScript وكيفية التعامل معها: دليل شامل",
    metaTitle: "أحداث JavaScript: دليل شامل من الالتقاط إلى التفويض",
    description:
        "دليل معمق لأحداث JavaScript: مراحل تدفق الحدث، addEventListener مقابل onclick، كائن الحدث، التفويض (Event Delegation)، preventDefault وstopPropagation، الأحداث المخصصة، المستمعات السلبية (Passive)، AbortController للتنظيف، والأخطاء الشائعة في الإنتاج.",
    keywords: [
        "أحداث JavaScript",
        "addEventListener",
        "Event Delegation",
        "event bubbling",
        "event capturing",
        "preventDefault",
        "stopPropagation",
        "CustomEvent",
        "passive listeners",
        "AbortController",
    ],
    category: "برمجة",
    author: "طلال عمران",
    date: "10 نوفمبر 2026",
    pubDate: new Date("2026-11-10"),
    tags: ["جافاسكريبت", "تطوير الويب", "أحداث", "DOM", "أداء"],
    thumbnail: "/images/javascript-events-complete-guide.webp",
};

const tocItems = [
    { id: "at-a-glance", label: "نظرة سريعة: خريطة أحداث JavaScript" },
    { id: "what-are-events", label: "ما هي الأحداث؟ ولماذا هي جوهر الويب التفاعلي؟" },
    { id: "event-flow", label: "تدفق الحدث: الالتقاط والهدف والفقاعات" },
    { id: "addEventListener", label: "addEventListener مقابل onclick: الفرق الذي يحدد جودة الكود" },
    { id: "event-object", label: "كائن الحدث: ما الذي تحمله كل نقرة؟" },
    { id: "prevent-default", label: "preventDefault وstopPropagation: الفرق الذي يخلط كثيرين" },
    { id: "delegation", label: "تفويض الأحداث (Event Delegation): النمط الذي يغير كل شيء" },
    { id: "common-events", label: "الأحداث الأكثر استخدامًا في 2026" },
    { id: "custom-events", label: "الأحداث المخصصة: تواصل بين مكوناتك" },
    { id: "passive", label: "المستمعات السلبية (Passive): كيف تنقذ التمرير؟" },
    { id: "cleanup", label: "التنظيف: AbortController وremoveEventListener" },
    { id: "common-mistakes", label: "أخطاء شائعة في التعامل مع الأحداث" },
    { id: "performance", label: "الأداء: كيف تتجنب إبطاء الصفحة؟" },
    { id: "best-practices", label: "أفضل الممارسات في الإنتاج" },
    { id: "final-checklist", label: "قائمة تحقق نهائية" },
    { id: "useful-links", label: "روابط ومصادر مفيدة" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            كل تفاعل في صفحة ويب، من نقرة زر إلى تمرير الفأرة إلى
            ضغطة لوحة مفاتيح، يمر عبر نظام <strong>الأحداث</strong>
            في JavaScript. هو النظام الذي يحوّل صفحة جامدة إلى
            تطبيق حي. ورغم أن معظم المطورين يستخدمون
            <code>addEventListener</code> يوميًا، فإن قليلين
            يفهمون <strong>كيف ينتقل الحدث عبر DOM</strong>، أو
            لماذا قد لا يعمل مستمع معين، أو لماذا تبدو الصفحة
            بطيئة بعد إضافة مستمعي تمرير.
        </p>

        <p>
            هذا الدليل لا يكتفي بشرح “كيف تضيف مستمعًا”. إنه يفكك
            النظام من الداخل: كيف ينتقل الحدث من أعلى الشجرة إلى
            العنصر ثم يعود، وكيف يؤثر ذلك على الأداء والمنطق،
            وكيف تستخدم التفويض (Event Delegation) لتحسين الأداء،
            وكيف تنظف المستمعات دون تسريب ذاكرة. الهدف أن تتعامل
            مع الأحداث <strong>كالمهندس، لا كمستخدم للـAPI</strong>.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy-700 dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {tocItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <h2 id="at-a-glance">نظرة سريعة: خريطة أحداث JavaScript</h2>

        <p>
            الجدول التالي يلخص المفاهيم الأساسية التي يغطيها
            الدليل، مع مثال سريع لكل منها:
        </p>

        <div class="overflow-x-auto my-4">
            <div class="inline-block min-w-full overflow-hidden rounded-lg border border-navy-200 dark:border-zinc-700">
                <table class="min-w-full text-right">
                    <thead class="bg-navy-50 dark:bg-zinc-800 text-navy-700 dark:text-zinc-300">
                        <tr>
                            <th class="px-4 py-2 font-semibold">المفهوم</th>
                            <th class="px-4 py-2 font-semibold">الوظيفة</th>
                            <th class="px-4 py-2 font-semibold">مثال</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                        <tr>
                            <td class="px-4 py-2">التدفق</td>
                            <td class="px-4 py-2">مسار الحدث عبر DOM</td>
                            <td class="px-4 py-2">capture → target → bubble</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">addEventListener</td>
                            <td class="px-4 py-2">تسجيل مستمع حدث</td>
                            <td class="px-4 py-2"><code>el.addEventListener(...)</code></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">كائن الحدث</td>
                            <td class="px-4 py-2">بيانات الحدث</td>
                            <td class="px-4 py-2"><code>e.target</code>، <code>e.type</code></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">preventDefault</td>
                            <td class="px-4 py-2">منع السلوك الافتراضي</td>
                            <td class="px-4 py-2">منع إرسال نموذج</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">stopPropagation</td>
                            <td class="px-4 py-2">إيقاف انتشار الحدث</td>
                            <td class="px-4 py-2">منع وصول النقر للأب</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">التفويض</td>
                            <td class="px-4 py-2">مستمع واحد لعناصر كثيرة</td>
                            <td class="px-4 py-2"><code>parent.addEventListener</code></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">Passive</td>
                            <td class="px-4 py-2">تحسين أداء التمرير</td>
                            <td class="px-4 py-2"><code>{`{ passive: true }`}</code></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">AbortController</td>
                            <td class="px-4 py-2">إزالة مستمعات متعددة</td>
                            <td class="px-4 py-2"><code>signal: controller.signal</code></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <h2 id="what-are-events">ما هي الأحداث؟ ولماذا هي جوهر الويب التفاعلي؟</h2>

        <p>
            <img
                src="/images/articles/javascript-events-complete-guide/01.webp"
                alt="أحداث JavaScript"
                width="1200"
                height="682"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            الحدث هو <strong>إشعار يصدره المتصفح</strong> عند حدوث
            شيء يستحق الانتباه: نقرة، ضغطة مفتاح، اكتمال تحميل صورة،
            تغير حجم النافذة، استلام بيانات من الشبكة. المتصفح
            يطلق الإشعار، والكود الذي سجّل مستمعًا له يستجيب.
        </p>

        <p>
            قبل الأحداث، كانت صفحات الويب جامدة. الـJavaScript
            الحديثة كلها تقوم على الأحداث: أطر مثل React وVue
            تستخدم نظامًا اصطناعيًا (synthetic) مبنيًا على أحداث
            DOM الحقيقية. حتى لو لم تكن تكتب
            <code>addEventListener</code> مباشرة، فأنت تستخدم
            نظام الأحداث عندما تكتب <code>onClick</code> في React
            أو <code>v-on:click</code> في Vue.
        </p>

        <p>
            فهم الأحداث الحقيقية يجعلك قادرًا على:
        </p>

        <ul>
            <li>
                تشخيص مشاكل لا يفسرها الإطار (لماذا لا يعمل
                المستمع؟ لماذا يُستدعى مرتين؟).
            </li>
            <li>
                تحسين الأداء عبر التفويض والمستمعات السلبية.
            </li>
            <li>
                تجنب تسريب الذاكرة بتنظيف المستمعات.
            </li>
            <li>
                بناء مكونات قابلة لإعادة الاستخدام مع أحداث
                مخصصة.
            </li>
        </ul>

        <h2 id="event-flow">تدفق الحدث: الالتقاط والهدف والفقاعات</h2>

        <p>
            عندما تنقر على زر داخل صفحة، لا يحدث الحدث في الزر
            فقط. المتصفح يمرره في <strong>ثلاث مراحل</strong> عبر
            شجرة DOM:
        </p>

        <ol>
            <li>
                <strong>مرحلة الالتقاط (Capturing):</strong>
                يبدأ الحدث من أعلى شجرة (window أو document)،
                وينزل نحو العنصر المستهدف.
            </li>
            <li>
                <strong>مرحلة الهدف (Target):</strong>
                يصل الحدث إلى العنصر الذي نُقر عليه.
            </li>
            <li>
                <strong>مرحلة الفقاعات (Bubbling):</strong>
                يعود الحدث صاعدًا من الهدف نحو الجذر.
            </li>
        </ol>

        <p>
            هذا التدفق هو أساس <strong>تفويض الأحداث</strong>
            (Event Delegation)، وهو أيضًا مصدر كثير من الأخطاء
            عند المبتدئين. المثال التالي يوضح:
        </p>

        <pre dir="ltr" class="bg-zinc-900 text-zinc-100 rounded-lg p-4 overflow-x-auto text-left text-sm my-4"><code>{`<div id="outer">
    <button id="inner">Click me</button>
</div>

<script>
    const outer = document.getElementById("outer");
    const inner = document.getElementById("inner");

    outer.addEventListener("click", () => console.log("outer capture"), true);
    outer.addEventListener("click", () => console.log("outer bubble"), false);
    inner.addEventListener("click", () => console.log("inner"));

    // النتيجة عند النقر على الزر:
    // outer capture
    // inner
    // outer bubble
</script>`}</code></pre>

        <p>
            المعامل الثالث في <code>addEventListener</code> يحدد
            المرحلة: <code>true</code> (أو
            <code>{`{capture: true}`}</code>) يعني الالتقاط،
            والافتراضي <code>false</code> يعني الفقاعات. معظم
            الأكواد تستخدم الوضع الافتراضي، لكن فهم الفرق
            حاسم عند تشخيص مشاكل “لماذا يُستدعى المستمع
            في العنصر الأب قبل الابن؟”.
        </p>

        <h2 id="addEventListener">addEventListener مقابل onclick: الفرق الذي يحدد جودة الكود</h2>

        <p>
            الطريقة التقليدية <code>element.onclick = handler</code>
            تبدو أبسط، لكنها تحمل قيودًا تجعلها غير مناسبة في
            الإنتاج:
        </p>

        <div class="overflow-x-auto my-4">
            <div class="inline-block min-w-full overflow-hidden rounded-lg border border-navy-200 dark:border-zinc-700">
                <table class="min-w-full text-right">
                    <thead class="bg-navy-50 dark:bg-zinc-800 text-navy-700 dark:text-zinc-300">
                        <tr>
                            <th class="px-4 py-2 font-semibold">المعيار</th>
                            <th class="px-4 py-2 font-semibold">onclick</th>
                            <th class="px-4 py-2 font-semibold">addEventListener</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                        <tr>
                            <td class="px-4 py-2">مستمعات متعددة</td>
                            <td class="px-4 py-2">لا، يستبدل السابق</td>
                            <td class="px-4 py-2">نعم، يمكن إضافة عدة مستمعات</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">التحكم في المرحلة</td>
                            <td class="px-4 py-2">لا</td>
                            <td class="px-4 py-2">نعم، عبر capture</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">الإزالة</td>
                            <td class="px-4 py-2"><code>el.onclick = null</code></td>
                            <td class="px-4 py-2"><code>removeEventListener</code> أو AbortSignal</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">المستمعات السلبية</td>
                            <td class="px-4 py-2">لا</td>
                            <td class="px-4 py-2">نعم، <code>{`{passive: true}`}</code></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">التوافق مع الأطر</td>
                            <td class="px-4 py-2">قد يتعارض مع مستمعات أخرى</td>
                            <td class="px-4 py-2">مستقل</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2">الشيوع في الإنتاج</td>
                            <td class="px-4 py-2">نادر</td>
                            <td class="px-4 py-2">المعيار الفعلي</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <p>
            <strong>القاعدة العملية:</strong> استخدم
            <code>addEventListener</code> دائمًا. الحالة الوحيدة
            التي قد تستخدم فيها <code>onclick</code> هي كود تعليمي
            بسيط، أو عند الحاجة إلى استبدال معالج حدث ديناميكيًا
            دون تراكم مستمعات.
        </p>

        <h2 id="event-object">كائن الحدث: ما الذي تحمله كل نقرة؟</h2>

        <p>
            كل مستمع يستقبل كائن حدث يحتوي على معلومات غنية.
            الخصائص الأكثر استخدامًا:
        </p>

        <ul>
            <li>
                <strong><code>type</code>:</strong> نوع الحدث
                (مثل “click”).
            </li>
            <li>
                <strong><code>target</code>:</strong> العنصر
                الذي أُطلق عليه الحدث فعليًا (قد يكون ابنًا
                للعنصر المسجّل عليه المستمع).
            </li>
            <li>
                <strong><code>currentTarget</code>:</strong>
                العنصر الذي عليه المستمع الحالي (يختلف عن
                target عند الفقاعات).
            </li>
            <li>
                <strong><code>timeStamp</code>:</strong>
                وقت وقوع الحدث.
            </li>
            <li>
                <strong><code>preventDefault()</code>:</strong>
                منع السلوك الافتراضي.
            </li>
            <li>
                <strong><code>stopPropagation()</code>:</strong>
                إيقاف انتشار الحدث.
            </li>
            <li>
                <strong><code>stopImmediatePropagation()</code>:</strong>
                إيقاف الانتشار ومنع المستمعات الأخرى على
                نفس العنصر.
            </li>
        </ul>

        <p>
            لأحداث محددة، هناك خصائص إضافية. مثلًا،
            <code>MouseEvent</code> تحتوي على
            <code>clientX/clientY</code> و
            <code>button</code>، و<code>KeyboardEvent</code>
            تحتوي على <code>key</code> و<code>code</code>
            و<code>altKey</code> وغيرها.
        </p>

        <p>
            نقطة مهمة: <code>target</code> هو ما نقر عليه
            المستخدم، وهو ليس دائمًا العنصر الذي عليه المستمع.
            هذه الحقيقة هي أساس التفويض.
        </p>

        <h2 id="prevent-default">preventDefault وstopPropagation: الفرق الذي يخلط كثيرين</h2>

        <p>
            هاتان الدالتان تبدوان متشابهتين، لكن وظيفتهما مختلفة
            تمامًا:
        </p>

        <ul>
            <li>
                <strong><code>preventDefault()</code>:</strong>
                تمنع السلوك <strong>الافتراضي للمتصفح</strong>
                تجاه الحدث. مثال: منع إرسال نموذج عند الضغط
                على زر submit، أو منع فتح رابط عند النقر عليه.
            </li>
            <li>
                <strong><code>stopPropagation()</code>:</strong>
                تمنع الحدث من <strong>الانتشار</strong> إلى
                العناصر الأخرى في شجرة DOM. الحدث لا يكمل
                مرحلة الفقاعات.
            </li>
        </ul>

        <pre dir="ltr" class="bg-zinc-900 text-zinc-100 rounded-lg p-4 overflow-x-auto text-left text-sm my-4"><code>{`document.querySelector("form").addEventListener("submit", (e) => {
    e.preventDefault(); // منع إعادة تحميل الصفحة
    // إرسال البيانات عبر fetch
});

document.querySelector(".modal").addEventListener("click", (e) => {
    e.stopPropagation(); // منع النقر من الوصول للخلفية
});`}</code></pre>

        <p>
            خطأ شائع: استخدام <code>stopPropagation</code>
            عندما تريد منع السلوك الافتراضي، أو العكس. تذكر
            القاعدة: <strong>preventDefault يوقف المتصفح،
            stopPropagation يوقف الحدث</strong>.
        </p>

        <h2 id="delegation">تفويض الأحداث (Event Delegation): النمط الذي يغير كل شيء</h2>

        <p>
            بدلًا من إضافة مستمع لكل عنصر في قائمة من 1000 عنصر،
            أضف مستمعًا واحدًا على العنصر الأب، واستفد من
            الفقاعات لتحديد أي عنصر تم النقر عليه. هذا هو
            <strong>تفويض الأحداث</strong>.
        </p>

        <pre dir="ltr" class="bg-zinc-900 text-zinc-100 rounded-lg p-4 overflow-x-auto text-left text-sm my-4"><code>{`// الطريقة السيئة: مستمع لكل عنصر
document.querySelectorAll(".item").forEach((item) => {
    item.addEventListener("click", () => console.log(item.dataset.id));
});

// الطريقة الأفضل: مستمع واحد على الأب
document.querySelector(".list").addEventListener("click", (e) => {
    const item = e.target.closest(".item");
    if (!item) return;
    console.log(item.dataset.id);
});`}</code></pre>

        <p>مزايا التفويض:</p>

        <ul>
            <li>
                <strong>أداء أفضل:</strong> مستمع واحد بدل
                آلاف المستمعات.
            </li>
            <li>
                <strong>يدعم العناصر المضافة حديثًا:</strong>
                إذا أضفت عنصرًا جديدًا إلى القائمة، سيعمل
                دون إعادة ربط.
            </li>
            <li>
                <strong>كود أنظف:</strong> منطق واحد في
                مكان واحد.
            </li>
            <li>
                <strong>ذاكرة أقل:</strong> عدد أقل من
                closures محتجزة.
            </li>
        </ul>

        <p>
            لكن التفويض ليس سحريًا. تحدياته:
        </p>

        <ul>
            <li>
                بعض الأحداث لا تنتشر (مثل <code>focus</code>
                و<code>blur</code>، رغم أن
                <code>focusin</code> و<code>focusout</code>
                ينتشران).
            </li>
            <li>
                يجب استخدام <code>closest()</code> بدل
                <code>matches()</code> للتعامل مع العناصر
                المتداخلة.
            </li>
            <li>
                قد يكون أبطأ في حالات نادرة إذا كان الشجرة
                عميقة جدًا.
            </li>
        </ul>

