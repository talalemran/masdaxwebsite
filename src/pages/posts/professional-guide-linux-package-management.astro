                        <td class="px-4 py-2">Flatpak</td>
                        <td class="px-4 py-2">شامل معزول</td>
                        <td class="px-4 py-2">كل التوزيعات تقريبًا</td>
                        <td class="px-4 py-2">لامركزية ومفتوح المصدر بالكامل</td>
                    </tr>
