                    </tr>
                    <tr>
                        <td class="px-4 py-2">Zypper</td>
                        <td class="px-4 py-2">RPM</td>
                        <td class="px-4 py-2">openSUSE</td>
                        <td class="px-4 py-2">محرك حل تبعيات قوي جدًا</td>
                    </tr>
