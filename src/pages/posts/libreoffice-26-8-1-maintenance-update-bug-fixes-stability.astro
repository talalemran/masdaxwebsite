---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "libreoffice-26-8-1-maintenance-update-bug-fixes-stability",
    title: "LibreOffice 26.8.1: تحديث صيانة بـ إصلاحات أخطاء وتحسينات استقرار",
    metaTitle: "LibreOffice 26.8.1: أول تحديث صيانة للإصدار 26.8",
    description:
        "LibreOffice 26.8.1 أطلقت في سبتمبر 2026 — أول تحديث صيانة لـ LibreOffice 26.8 بـ إصلاحات أخطاء وتحسينات استقرار، مع الحفاظ على الفلسفة المحلية أولاً بدون AI أو Telemetry، مما يعكس التزام مؤسسة Document بـ جودة وخصوصية.",
    keywords: [
        "LibreOffice 26.8.1",
        "Open Source Office Suite",
        "Bug Fixes",
        "Maintenance Update",
        "Free Office",
        "أدوات مكتبية",
        "مفتوح المصدر",
        "إصلاحات",
        "تحديث صيانة",
        "LibreOffice",
    ],
    category: "برامج",
    author: "طلال عمران",
    date: "02 أكتوبر 2026",
    pubDate: new Date("2026-10-02"),
    tags: ["LibreOffice", "Office Suite", "Bug Fixes", "Open Source", "Maintenance"],
    thumbnail: "/images/libreoffice-26-8-1-maintenance-update-bug-fixes-stability.webp",
};
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <h2>المقدمة الخبرية</h2>

        <p>
            أطلقت <a href="https://www.libreoffice.org/" target="_blank" rel="noopener noreferrer nofollow">مؤسسة Document Foundation</a>
            في سبتمبر 2026 النسخة 26.8.1 من LibreOffice — 
            أول تحديث صيانة لـ إصدار LibreOffice 26.8 الرئيسي. 
            التحديث يضمن إصلاحات شاملة لـ الأخطاء التي تم اكتشافها منذ إطلاق النسخة 26.8.0 
            في نهاية أغسطس، بالإضافة إلى تحسينات استقرار وتحسينات التوافقية. 
            LibreOffice 26.8.1 تحافظ على فلسفة المشروع الأساسية: 
            مجموعة مكتبية مفتوحة المصدر تماماً وحرة بدون إعلانات أو عمليات شراء داخلية، 
            وبدون أي ميزات AI توليدية أو Telemetry تتبعي. 
            التحديث موجه نحو المستخدمين الذين يريدون استقراراً وموثوقية 
            مع الاستفادة من الميزات الجديدة التي جاءت في النسخة 26.8. 
            بالنسبة للمستخدمين في بيئات الإنتاج، 
            LibreOffice الآن توفر خيارين قويين: 
            النسخة 26.2 الناضجة والمستقرة أو النسخة 26.8 الأحدث مع ميزات جديدة.
        </p>

        <h2>السياق: من LibreOffice 26.8.0 إلى 26.8.1</h2>

        <p>
            LibreOffice 26.8 أطلقت في 26 أغسطس 2026 كـ إصدار رئيسي جديد 
            يركز بشكل كبير على تحسينات الطباعة والكتابة والخطوط. 
            الإصدار الجديد جلب تحسينات كبيرة مثل Paragraph Composer 
            الذي يوازن المسافات بين الكلمات بشكل ذكي، 
            و دعم OpenType variable fonts، و تحسينات في اللغات RTL (Right-to-Left). 
            لكن، كما هو الحال مع أي إصدار رئيسي جديد، 
            الأخطاء البسيطة والمشاكل الموقعية ظهرت عند استخدام أعداد كبيرة من المستخدمين. 
            هذا هو السبب في وجود نسخة الصيانة 26.8.1 — 
            لحل هذه المشاكل وتحسين الاستقرار قبل أن يعتمد المستخدمون على النسخة في بيئات الإنتاج.
        </p>

        <h2>الميزات والتحسينات الرئيسية من 26.8</h2>

        <p>
            <img
                src="/images/articles/libreoffice-26-8-1-maintenance-update-bug-fixes-stability/01.webp"
                alt="LibreOffice 26.8.1"
                width="1200"
                height="675"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <h3>تحسينات الكتابة والطباعة</h3>

        <p>
            LibreOffice 26.8 حملت تحسينات كبيرة جداً في مجال الكتابة:
        </p>

        <ul>
            <li>
                Paragraph Composer: ميزة جديدة توازن المسافات بين الكلمات بذكاء
            </li>
            <li>
                دعم OpenType variable fonts: خطوط حديثة مع تباينات لا نهائية
            </li>
            <li>
                دعم تلقائي لاتجاه النصوص: اكتشاف تلقائي لـ RTL و LTR
            </li>
            <li>
                تحسينات الوصولية: دعم ARIA لـ جداول وعناصر أخرى
            </li>
            <li>
                سرعة أفضل: فتح أسرع للمستندات الثقيلة بالصور
            </li>
        </ul>

        <h3>تحسينات الجداول والرسوم البيانية</h3>

        <p>
            LibreOffice Calc و Impress حصلتا على تحسينات أيضاً:
        </p>

        <ul>
            <li>
                دعم لـ أنواع جديدة من الرسوم البيانية مثل Funnel, Pareto, Sunburst
            </li>
            <li>
                توافقية أفضل مع Excel و PowerPoint
            </li>
            <li>
                دوال جديدة في Calc
            </li>
        </ul>

        <h2>فلسفة LibreOffice: بدون AI وبدون Telemetry</h2>

        <p>
            نقطة مهمة جداً في LibreOffice 26.8.1 — 
            المشروع التزم بـ موقف واضح جداً: 
            لا ميزات AI توليدية، لا Telemetry تتبعي، لا إعلانات. 
            هذا في وقت الاتجاه العام في الصناعة نحو إضافة AI في كل مكان. 
            LibreOffice قالت: لا. بدلاً من ذلك، المشروع يركز على 
            الحقائق الأساسية: أدوات مكتبية موثوقة تحترم خصوصية المستخدمين. 
            هذا قرار فلسفي قوي يعكس القيم الأساسية للمشروع.
        </p>

        <h2>التحسينات المتوقعة في 26.8.1</h2>

        <p>
            تحديث الصيانة 26.8.1 يركز على:
        </p>

        <ul>
            <li>
                إصلاحات للأخطاء المبلغ عنها في النسخة 26.8.0
            </li>
            <li>
                تحسينات الاستقرار والأداء
            </li>
            <li>
                إصلاحات التوافقية مع الملفات المختلفة
            </li>
            <li>
                تحسينات المنصات المختلفة (Windows, macOS, Linux)
            </li>
            <li>
                تحسينات الترجمة والدعم متعدد اللغات
            </li>
        </ul>

        <h2>التحليل والأهمية</h2>

        <p>
            LibreOffice 26.8.1 يمثل استمراراً طبيعياً في تطور المشروع. 
            بينما LibreOffice 26.8 حملت ميزات جديدة مثيرة، 
            النسخة 26.8.1 توضح التزام مؤسسة Document بـ الجودة والاستقرار. 
            المشروع لا يسرع في إطلاق نسخ جديدة على حساب الاستقرار.

            المتوقع أن نرى:
        </p>

        <ul>
            <li>
                تحسينات مستمرة في الأداء والاستقرار
            </li>
            <li>
                اعتماد أوسع من المستخدمين على LibreOffice 26.8
            </li>
            <li>
                المزيد من تحديثات الصيانة المخطط لها (7 تحديثات حتى يونيو 2027)
            </li>
            <li>
                ضغط على برامج تجارية لتحسين معايير الخصوصية
            </li>
        </ul>

        <h2>قراءة تحليلية مستقلة</h2>

        <p>
            LibreOffice يقف في موقف فريد جداً في سوق أدوات المكتبية. 
            بينما معظم الشركات تركض نحو AI والاشتراكات والبيانات الشخصية، 
            LibreOffice قالت: نحن نبني أداة موثوقة محترمة للخصوصية. 
            هذا ليس كمياً الأفضل من ناحية الميزات، 
            لكنه الأفضل من ناحية الثقة والموثوقية.

            الجانب الإيجابي: المشروع مستقر جداً وموثوق، 
            وسهل التوسع والتعديل لأنه مفتوح المصدر. 
            الجانب السلبي: قد لا يملك جميع الميزات التي توجد في Microsoft Office، 
            لكن معظم المستخدمين لن يحتاجوها.

            التحديات المتوقعة: الحفاظ على فريق تطوير نشط 
            عندما لا تكون هناك شركة كبيرة تمول المشروع بشكل كامل.
        </p>

        <h2>الأسئلة الشائعة</h2>

        <h3>س: هل يجب أن أحدّث إلى 26.8.1 الآن؟</h3>
        <p>
            ج: إذا كنت تستخدم 26.8.0 وليس لديك مشاكل، يمكنك الانتظار. 
            لكن التحديث إلى 26.8.1 موصى به للاستقرار الأفضل.
        </p>

        <h3>س: هل LibreOffice 26.8 جاهزة للاستخدام الإنتاجي؟</h3>
        <p>
            ج: نعم، مع 26.8.1 الآن متاحة. 
            لكن مؤسسة Document توصي بـ LibreOffice 26.2 للبيئات الإنتاجية المحافظة.
        </p>

        <h3>س: كم سيكون عدد تحديثات الصيانة لـ 26.8؟</h3>
        <p>
            ج: سبعة تحديثات مخطط لها حتى يونيو 2027. 
            هذا يعني دعم طويل الأمد والاستقرار.
        </p>

        <h3>س: هل LibreOffice توفر نسخة online أيضاً؟</h3>
        <p>
            ج: نعم، LibreOffice Online في طريقها لـ الإصدار. 
            المشروع يعمل على نسخة ويب محترمة للخصوصية أيضاً.
        </p>

        <h2>الخاتمة</h2>

        <p>
            LibreOffice 26.8.1 تمثل خطوة مهمة في تطور مشروع 
            يلتزم بـ الجودة والخصوصية والحرية. 
            النسخة 26.8 جاءت بـ ميزات مثيرة، 
            و النسخة 26.8.1 تضمن استقراراً وموثوقية.

            بالنسبة للمستخدمين الذين يبحثون عن بديل موثوق لـ Microsoft Office، 
            LibreOffice 26.8.1 خيار ممتاز وجدير بـ التجربة. 
            المشروع مجاني تماماً وحر وآمن.

            مع استمرار تطور LibreOffice والتزامها بـ الخصوصية والجودة، 
            المتوقع أن تصبح الخيار الأول للملايين من المستخدمين 
            الذين يريدون أداة مكتبية حقيقية بدون قيود تجارية.
        </p>

        <h3>المصدر:</h3>
        <p>
            تم البحث عن معلومات LibreOffice 26.8.1 من خلال:
            <a href="https://www.libreoffice.org/" target="_blank" rel="noopener noreferrer nofollow">
                LibreOffice Official Website
            </a>
        </p>
    </PostLayout>
</BaseLayout>