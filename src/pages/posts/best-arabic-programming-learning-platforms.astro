---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "best-arabic-programming-learning-platforms",
    title: "أفضل منصات تعلم البرمجة بالعربية للمبتدئين: دليل شامل",
    metaTitle: "أفضل منصات عربية مجانية لتعلم البرمجة للمبتدئين 2026",
    description:
        "دليل شامل لأفضل المنصات العربية لتعلم البرمجة من الصفر — أكاديمية حسوب، إدراك، رواق، طويق، وغيرها — مع شرح تفصيلي لكل منصة، لمن تناسب، وروابطها الرسمية.",
    keywords: [
        "تعلم البرمجة بالعربي",
        "منصات عربية لتعلم البرمجة",
        "أكاديمية حسوب",
        "إدراك",
        "رواق",
        "أكاديمية طويق",
        "تعلم البرمجة للمبتدئين",
        "دورات برمجة مجانية بالعربي",
    ],
    category: ["برمجة", "مقالات"],
    author: "طلال عمران",
    date: "22 أغسطس 2026",
    pubDate: new Date("2026-08-22"),
    tags: [
        "تعلم البرمجة",
        "منصات عربية",
        "أكاديمية حسوب",
        "إدراك",
        "رواق",
    ],
    thumbnail: "/images/best-arabic-programming-learning-platforms.webp",
};

const tocItems = [
    { id: "why-arabic-platforms", label: "لماذا تبدأ بمنصة عربية تحديدًا؟" },
    { id: "how-we-picked", label: "كيف اخترنا هذه المنصات؟" },
    { id: "hsoub-academy", label: "1. أكاديمية حسوب" },
    { id: "edraak", label: "2. إدراك (Edraak)" },
    { id: "rwaq", label: "3. رواق (Rwaq)" },
    { id: "tuwaiq", label: "4. أكاديمية طويق" },
    { id: "nagwa", label: "5. نجوى (Nagwa)" },
    { id: "madrasa", label: "6. مدرسة (Madrasa)" },
    { id: "comparison-table", label: "جدول مقارنة شامل" },
    { id: "how-to-choose", label: "كيف تختار المنصة المناسبة لك؟" },
    { id: "beyond-platform", label: "ماذا بعد اختيار المنصة؟ نصائح عملية" },
    { id: "conclusion", label: "خلاصة عملية" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            عائق اللغة لم يعد عذرًا مقبولًا لتأجيل تعلم البرمجة. المحتوى
            العربي في هذا المجال أصبح غنيًا بما يكفي لبناء أساس متين
            وحقيقي، من الصفر وحتى مستوى احترافي في الأساسيات، دون الحاجة
            لإتقان الإنجليزية أولاً.
        </p>

        <p>
            هذا الدليل يستعرض أفضل المنصات العربية المتخصصة أو الداعمة
            لتعلم البرمجة، مع شرح تفصيلي لكل منصة، الفئة التي تناسبها،
            وروابطها الرسمية المباشرة.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {
                    tocItems.map((item) => (
                        <li>
                            <a
                                href={`#${item.id}`}
                                class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                            >
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ol>
        </nav>

        <h2 id="why-arabic-platforms">لماذا تبدأ بمنصة عربية تحديدًا؟</h2>

        <p>
            الحجة الشائعة تقول إن على كل مبرمج تعلم الإنجليزية أولاً قبل
            أي شيء آخر. هذا صحيح جزئيًا على المدى الطويل، لأن التوثيق
            الرسمي لأغلب الأدوات والتقنيات يصدر بالإنجليزية أولاً. لكن
            هذا لا يعني أن البداية يجب أن تكون بالإنجليزية أيضًا:
        </p>

        <ul>
            <li>
                فهم المفاهيم الأساسية (المتغيرات، الحلقات، الدوال) أسرع
                وأوضح بلغتك الأم، خصوصًا في الأسابيع الأولى الحرجة
            </li>
            <li>
                منصات عربية جيدة تشرح المصطلحات التقنية بمرادفات عربية
                واضحة، بدلاً من الاصطدام بمصطلحات إنجليزية مجردة دون سياق
            </li>
            <li>
                المجتمع العربي حول هذه المنصات يعني وجود من يفهم أسئلتك
                بنفس اللغة ونفس السياق التعليمي
            </li>
        </ul>

        <p>
            القاعدة الذهبية العملية: ابدأ بمصدر عربي واحد منظم والتزم به
            حتى النهاية، بدلاً من التنقل بين عشرات المصادر. وبالتوازي، خصص
            جزءًا صغيرًا من وقتك لتعويد نفسك تدريجيًا على قراءة التوثيق
            الإنجليزي، لأنك ستحتاجه حتمًا لاحقًا.
        </p>

        <h2 id="how-we-picked">كيف اخترنا هذه المنصات؟</h2>

        <p>
            اعتمدنا معايير محددة عند اختيار المنصات المذكورة في هذا الدليل:
            أن تكون المنصة عربية فعليًا (لا مجرد ترجمة آلية لمحتوى أجنبي)،
            أن يكون المحتوى منظمًا في مسارات تعليمية واضحة لا فيديوهات
            متفرقة، وأن تكون متاحة لعموم المتعلمين العرب لا مقتصرة على
            فئة جغرافية ضيقة.
        </p>

        <h2 id="hsoub-academy">1. أكاديمية حسوب</h2>

        <p>
            <img
                src="/images/hsoub-academy-interface.webp"
                alt="واجهة أكاديمية حسوب لتعلم البرمجة بالعربية"
                width="1200"
                height="565"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            تُعتبر أكبر وأشهر منصة عربية متخصصة تحديدًا في تعليم البرمجة
            وتطوير الويب، وتتبع لشركة حسوب التي تدير أيضًا منصات عربية
            معروفة أخرى في مجال العمل الحر والتدوين التقني.
        </p>

        <ul>
            <li>مقالات وشروحات مجانية ضخمة تغطي كل شيء تقريبًا من أساسيات البرمجة إلى مواضيع متقدمة</li>
            <li>دورات مدفوعة منظمة بعناية، تأخذك خطوة بخطوة من الصفر حتى بناء مشاريع حقيقية</li>
            <li>مجتمع أسئلة وأجوبة نشط جدًا (حسوب I/O)، حيث يمكنك طرح أي سؤال تقني ومعرفة إجابته من مبرمجين آخرين</li>
        </ul>

        <p>
            <strong>الأنسب لـ</strong>: المبتدئين المطلقين الذين يريدون
            مسارًا منظمًا شاملاً بالعربية، خصوصًا في تطوير الويب.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://academy.hsoub.com/" target="_blank" rel="noopener noreferrer">academy.hsoub.com</a>
        </p>

        <h2 id="edraak">2. إدراك (Edraak)</h2>

        <p>
            منصة مساقات جماعية مفتوحة (MOOC) أطلقتها مؤسسة الملكة رانيا
            للتعليم والتنمية، بمستوى أكاديمي عالٍ يقترب من تجربة الجامعات
            الرسمية، لكن بالكامل باللغة العربية ومجانًا في الغالب.
        </p>

        <ul>
            <li>دورات برمجة تغطي لغات متعددة مثل Python وJavaScript وSQL ضمن مسارات أكاديمية منظمة</li>
            <li>شهادات إتمام موثوقة، مفيدة لمن يريد إثباتًا رسميًا لتعلمه</li>
            <li>محتوى يجمع بين الفيديو والاختبارات والواجبات التفاعلية</li>
        </ul>

        <p>
            <strong>الأنسب لـ</strong>: الطلاب والباحثين عن تجربة تعليمية
            أكاديمية منظمة مع شهادات معتمدة عربيًا.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://www.edraak.org/" target="_blank" rel="noopener noreferrer">edraak.org</a>
        </p>

        <h2 id="rwaq">3. رواق (Rwaq)</h2>

        <p>
            منصة عربية مفتوحة للتعليم، تقدم مواد أكاديمية مجانية بالكامل
            في شتى المجالات، من بينها مقررات برمجة وعلوم حاسوب يدرّسها
            نخبة من الأكاديميين العرب.
        </p>

        <ul>
            <li>نظام مساقات أسبوعية منظمة، أقرب لتجربة الفصل الدراسي الجامعي الحقيقي</li>
            <li>لقاءات مباشرة دورية مع المحاضر للإجابة على أسئلة الطلاب مباشرة</li>
            <li>منتديات نقاش لكل محاضرة، ومنتدى عام للمادة بالكامل</li>
            <li>شهادات إكمال لبعض المواد بعد اجتياز الاختبار النهائي</li>
        </ul>

        <p>
            <strong>الأنسب لـ</strong>: من يفضل تجربة تعليمية أكاديمية
            منظمة بجدول زمني واضح، أقرب لأسلوب الجامعة التقليدي.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://www.rwaq.org/" target="_blank" rel="noopener noreferrer">rwaq.org</a>
        </p>

        <h2 id="tuwaiq">4. أكاديمية طويق</h2>

        <p>
            مبادرة سعودية تعليمية تركز على برامج تدريبية مكثفة (Bootcamps)
            ودبلومات متخصصة في البرمجة والتقنيات الناشئة، بالشراكة أحيانًا
            مع شركات عالمية كبرى مثل Meta وجوجل.
        </p>

        <ul>
            <li>برامج تدريبية عملية مكثفة، أقرب لمعسكرات تدريب حقيقية منها لدورات نظرية</li>
            <li>دبلومات متخصصة في مجالات حديثة مثل تطوير الألعاب والذكاء الاصطناعي</li>
            <li>تركيز واضح على التطبيق العملي وبناء مشاريع تخرج حقيقية</li>
        </ul>

        <p>
            <strong>ملاحظة مهمة</strong>: بعض برامج طويق قد تكون موجهة
            بالأساس للمقيمين في السعودية أو تتطلب شروط قبول معينة، لذا
            يُنصح بمراجعة شروط كل برنامج تحديدًا قبل التسجيل.
        </p>

        <p>
            <strong>الأنسب لـ</strong>: من أنهى الأساسيات ويريد تدريبًا
            عمليًا مكثفًا يحاكي بيئة العمل الحقيقية.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://tuwaiq.edu.sa/" target="_blank" rel="noopener noreferrer">tuwaiq.edu.sa</a>
        </p>

        <h2 id="nagwa">5. نجوى (Nagwa)</h2>

        <p>
            منصة تعليمية عربية شاملة تغطي مواد دراسية متعددة، وتضم ضمن
            محتواها مسارات في علوم الحاسوب والبرمجة الأساسية، بأسلوب شرح
            مبسط جدًا ومناسب لمن يبدأ من نقطة الصفر المطلق.
        </p>

        <ul>
            <li>شروحات مبسطة جدًا للمفاهيم الأساسية، بأسلوب تربوي واضح</li>
            <li>محتوى تفاعلي يشمل فيديوهات وتمارين قصيرة</li>
            <li>مناسبة جدًا كنقطة انطلاق قبل الانتقال لمنصات أكثر تخصصًا في البرمجة</li>
        </ul>

        <p>
            <strong>الأنسب لـ</strong>: المبتدئين الصغار في السن أو من
            يفضل أسلوب شرح تربوي مبسط جدًا قبل الانتقال لمحتوى أعمق.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://www.nagwa.com/" target="_blank" rel="noopener noreferrer">nagwa.com</a>
        </p>

        <h2 id="madrasa">6. مدرسة (Madrasa)</h2>

        <p>
            مبادرة تعليمية أطلقتها مؤسسة محمد بن راشد آل مكتوم العالمية،
            تقدم محتوى STEM (العلوم والتقنية والهندسة والرياضيات) مجانيًا
            بالكامل باللغة العربية، موجهة أساسًا لطلاب المدارس لكنها مفيدة
            جدًا أيضًا لأي مبتدئ يريد أساسًا متينًا في التفكير المنطقي
            والحاسوبي قبل الغوص في لغة برمجة محددة.
        </p>

        <ul>
            <li>محتوى مجاني بالكامل دون أي رسوم أو اشتراكات</li>
            <li>ربط واضح بين المناهج الدراسية ومفاهيم البرمجة الأساسية</li>
            <li>مناسبة كأساس تمهيدي قبل الانتقال لمنصات متخصصة في البرمجة تحديدًا</li>
        </ul>

        <p>
            <strong>الأنسب لـ</strong>: طلاب المدارس، أو أي مبتدئ يريد بناء
            أساس منطقي وحاسوبي عام قبل التخصص.
        </p>

        <p>
            <strong>الرابط الرسمي</strong>:{" "}
            <a href="https://www.madrasa.org/" target="_blank" rel="noopener noreferrer">madrasa.org</a>
        </p>

        <h2 id="comparison-table">جدول مقارنة شامل</h2>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المنصة</th>
                        <th class="px-4 py-2 font-semibold">التكلفة</th>
                        <th class="px-4 py-2 font-semibold">نوع المحتوى</th>
                        <th class="px-4 py-2 font-semibold">الأنسب لـ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">أكاديمية حسوب</td>
                        <td class="px-4 py-2">مجاني جزئيًا + مدفوع</td>
                        <td class="px-4 py-2">مقالات ودورات منظمة</td>
                        <td class="px-4 py-2">تطوير الويب من الصفر</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">إدراك</td>
                        <td class="px-4 py-2">مجاني في الغالب</td>
                        <td class="px-4 py-2">مساقات أكاديمية (MOOC)</td>
                        <td class="px-4 py-2">شهادات معتمدة عربيًا</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">رواق</td>
                        <td class="px-4 py-2">مجاني بالكامل</td>
                        <td class="px-4 py-2">مساقات جامعية أسبوعية</td>
                        <td class="px-4 py-2">أسلوب دراسي أكاديمي</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">أكاديمية طويق</td>
                        <td class="px-4 py-2">مجاني (شروط قبول)</td>
                        <td class="px-4 py-2">معسكرات تدريب عملية</td>
                        <td class="px-4 py-2">التدريب العملي المكثف</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">نجوى</td>
                        <td class="px-4 py-2">مجاني/مدفوع جزئيًا</td>
                        <td class="px-4 py-2">شروحات مبسطة تفاعلية</td>
                        <td class="px-4 py-2">المبتدئين الصغار سنًا</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">مدرسة</td>
                        <td class="px-4 py-2">مجاني بالكامل</td>
                        <td class="px-4 py-2">محتوى STEM تمهيدي</td>
                        <td class="px-4 py-2">أساس منطقي قبل التخصص</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h2 id="how-to-choose">كيف تختار المنصة المناسبة لك؟</h2>

        <ul>
            <li><strong>تريد مسارًا شاملاً في تطوير الويب من الصفر:</strong> أكاديمية حسوب</li>
            <li><strong>تريد شهادة أكاديمية معتمدة تضيفها لسيرتك الذاتية:</strong> إدراك</li>
            <li><strong>تفضل أسلوب الفصل الدراسي الجامعي التقليدي:</strong> رواق</li>
            <li><strong>أنهيت الأساسيات وتريد تدريبًا عمليًا مكثفًا:</strong> أكاديمية طويق</li>
            <li><strong>مبتدئ تمامًا أو طالب مدرسة:</strong> نجوى أو مدرسة كنقطة انطلاق</li>
        </ul>

        <h2 id="beyond-platform">ماذا بعد اختيار المنصة؟ نصائح عملية</h2>

        <ul>
            <li>
                <strong>التزم بمصدر واحد حتى النهاية</strong>: التنقل
                المستمر بين منصات مختلفة يبعثر جهدك أكثر مما يفيدك
            </li>
            <li>
                <strong>ابنِ مشاريع فعلية أثناء التعلم</strong>: المصدر
                المثالي هو الذي تنهيه فعلاً وتطبق ما تعلمته منه عمليًا، لا
                الذي تجمع شهاداته فقط دون ممارسة
            </li>
            <li>
                <strong>خصص وقتًا تدريجيًا للمحتوى الإنجليزي</strong>:
                التوثيق الرسمي لأي أداة أو لغة برمجة يصدر بالإنجليزية
                أولاً، فابدأ بالتعود على قراءته بالتوازي مع تعلمك بالعربية
            </li>
            <li>
                <strong>انضم لمجتمعات الأسئلة والنقاش</strong> المرتبطة
                بكل منصة، فهي غالبًا أسرع طريقة لحل عقبة تقنية تواجهك
            </li>
        </ul>

        <h2 id="conclusion">خلاصة عملية</h2>

        <p>
            المحتوى العربي لتعلم البرمجة اليوم كافٍ تمامًا لبناء أساس
            احترافي متين، سواء اخترت أسلوب أكاديمية حسوب العملي المباشر،
            أو المسار الأكاديمي المنظم لإدراك ورواق، أو التدريب المكثف عبر
            طويق. الأهم ليس اسم المنصة نفسها، بل التزامك الفعلي بها حتى
            النهاية، وتحويل ما تتعلمه لمشاريع حقيقية تبني بها مهارتك خطوة
            بخطوة.
        </p>

