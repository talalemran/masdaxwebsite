---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "open-vs-closed-ai-future-of-open-models",
    title: "الذكاء الاصطناعي المغلق مقابل مفتوح المصدر: لماذا المستقبل للنماذج المفتوحة؟",
    metaTitle: "الذكاء الاصطناعي المفتوح مقابل المغلق: لماذا المستقبل للنماذج المفتوحة؟",
    description:
        "تحليل معمق لمعركة النماذج المغلقة مقابل المفتوحة في 2026: تضييق فجوة الأداء إلى 4.4 أشهر فقط، وانخفاض التكلفة إلى عُشر الثمن، والسيادة الرقمية، والابتكار، وتبني المؤسسات. مع جداول مقارنة وأدلة عملية على أن المستقبل للنماذج المفتوحة.",
    keywords: [
        "الذكاء الاصطناعي مفتوح المصدر",
        "نماذج مغلقة مقابل مفتوحة",
        "Open weight vs closed AI",
        "DeepSeek V4",
        "Kimi K3",
        "Llama 4",
        "Qwen",
        "مستقبل الذكاء الاصطناعي",
        "تكلفة الذكاء الاصطناعي",
        "السيادة الرقمية",
    ],
    category: "ذكاء اصطناعي",
    author: "طلال عمران",
    date: "23 أكتوبر 2026",
    pubDate: new Date("2026-10-23"),
    tags: ["ذكاء اصطناعي", "مفتوح المصدر", "نماذج لغوية", "اقتصاد التقنية", "سيادة رقمية"],
    thumbnail: "/images/open-vs-closed-ai-future-of-open-models.webp",
};

const tocItems = [
    { id: "at-a-glance", label: "نظرة سريعة: خريطة المعركة في 2026" },
    { id: "what-open-means", label: "ما الذي نعنيه بـ«مفتوح»؟ توضيح ضروري" },
    { id: "gap-collapsed", label: "الفجوة انهارت: من 0.5% إلى 4.4 أشهر" },
    { id: "cost-revolution", label: "ثورة التكلفة: 90% من الأداء بعُشر الثمن" },
    { id: "enterprise-shift", label: "تحول المؤسسات: من «الولاء للمورد» إلى «محفظة نماذج»" },
    { id: "sovereignty", label: "السيادة الرقمية والتحكم في البيانات" },
    { id: "innovation-engine", label: "محرك الابتكار: لماذا المفتوح يسرّع الجميع؟" },
    { id: "objections", label: "الاعتراضات المشروعة: الأمان والجودة والدعم" },
    { id: "geopolitics", label: "البعد الجيوسياسي: الصين والولايات المتحدة وأوروبا" },
    { id: "licenses", label: "التراخيص: الفرق بين «مفتوح» و«مفتوح حقًا»" },
    { id: "how-to-choose", label: "كيف تختار بين المفتوح والمغلق في 2026؟" },
    { id: "final-checklist", label: "قائمة تحقق نهائية" },
    { id: "useful-links", label: "روابط وأدوات مفيدة" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            لسنوات، كان النقاش حول الذكاء الاصطناعي المفتوح مقابل المغلق
            يُحسم بجملة واحدة: النماذج المغلقة أفضل، فإذا أردت الأفضل
            فادفع مقابل واجهة برمجية من الحدود الأمامية. هذه الجملة لم
            تعد صحيحة في 2026. <strong>الفجوة في القدرات تضيّقت إلى
            أشهر قليلة</strong>، والتكلفة انخفضت إلى عُشر أو أقل،
            والسؤال لم يعد «أيهما أذكى؟» بل «كم من التحكم تحتاج؟».
        </p>

        <p>
            هذا الدليل يقدم حجة منهجية بأن المستقبل — على المدى المتوسط
            والطويل — يميل لصالح النماذج المفتوحة، ليس لأنها «أفضل
            أخلاقيًا» فقط، بل لأن <strong>اقتصادياتها وتوجهات المؤسسات
            والبنية التحتية العالمية</strong> تدفع في هذا الاتجاه. لكنه
            لا يتجاهل الاعتراضات المشروعة: الأمان، والجودة في المهام
            القصوى، والحاجة إلى الدعم المؤسسي. الحجة هنا ليست أن
            النماذج المغلقة ستنتهي، بل أن <strong>الافتراضي سيتغير</strong>.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {tocItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <h2 id="at-a-glance">نظرة سريعة: خريطة المعركة في 2026</h2>

        <p>
            الجدول التالي يلخص المؤشرات الرئيسية التي تحدد ميزان القوى
            بين النماذج المفتوحة والمغلقة:
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المؤشر</th>
                        <th class="px-4 py-2 font-semibold">النماذج المفتوحة</th>
                        <th class="px-4 py-2 font-semibold">النماذج المغلقة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">فجوة الأداء (سبتمبر 2026)</td>
                        <td class="px-4 py-2" colspan="2">حوالي <strong>4.4 أشهر</strong> فقط (Mozilla)</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">أفضل نموذج مفتوح (Artificial Analysis)</td>
                        <td class="px-4 py-2">Kimi K3: 157 نقطة</td>
                        <td class="px-4 py-2">Fable 5 / Opus 5: 162 نقطة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">التكلفة النسبية</td>
                        <td class="px-4 py-2">30% من سعر النموذج المغلق المقارن</td>
                        <td class="px-4 py-2">100% (السعر المرجعي)</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">حصة حركة OpenRouter (أواخر 2025)</td>
                        <td class="px-4 py-2">نموذج صيني مفتوح: حوالي 30%</td>
                        <td class="px-4 py-2">البقية</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">حصة Vercel AI Gateway (يوليو 2026)</td>
                        <td class="px-4 py-2">36% من حجم الرموز (Tokens)</td>
                        <td class="px-4 py-2">64%</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">استخدام المطورين</td>
                        <td class="px-4 py-2">79% يستخدمون نماذج مفتوحة</td>
                        <td class="px-4 py-2">63% يستخدمون نماذج مغلقة في الإنتاج</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">قيمة الأداء مقابل السعر</td>
                        <td class="px-4 py-2">أعلى بفارق كبير</td>
                        <td class="px-4 py-2">محدودة بالمهام الحرجة</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h2 id="what-open-means">ما الذي نعنيه بـ«مفتوح»؟ توضيح ضروري</h2>

        <p>
            <img
                src="/images/articles/open-vs-closed-ai-future-of-open-models/01.webp"
                alt="الذكاء الاصطناعي المفتوح مقابل المغلق: لماذا المستقبل للنماذج المفتوحة؟"
                width="1200"
                height="800"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            الخلط بين «مفتوح المصدر» (open source) و«مفتوح الأوزان»
            (open weight) يفسد كثيرًا من النقاش. النموذج
            <strong>مفتوح الأوزان</strong> هو نموذج يمكنك تنزيل أوزانه
            المدربة وتشغيله بنفسك، غالبًا برخصة مثل MIT أو Apache 2.0.
            لكن بيانات التدريب وكود التدريب الكامل قد تبقى خاصة، فلا
            يمكنك إعادة إنتاجه من الصفر.
        </p>

        <p>
            لأغراض المؤسسات، هذا التمييز نادرًا ما يهم. ما يهم هو أنك
            تستطيع تشغيل النموذج على بنيتك التحتية، والتحكم في بياناتك،
            وعدم الارتباط بواجهة برمجية لمورّد واحد. وهذا هو
            <strong>جوهر اللعبة</strong>.
        </p>

        <p>
            النماذج المفتوحة الأوزان الرائدة في 2026 تشمل
            <strong>DeepSeek</strong> (رخصة MIT)، و<strong>Qwen</strong>
            من علي بابا (Apache 2.0)، و<strong>Kimi K3</strong> من
            Moonshot، و<strong>GLM</strong> من Z.ai، و<strong>Llama 4</strong>
            من Meta (برخصة مجتمعية بحد 700 مليون مستخدم شهري)،
            و<strong>Mistral</strong> (Apache 2.0). في المقابل، النماذج
            المغلقة تشمل <strong>GPT-6 Astra</strong> من OpenAI،
            و<strong>Claude Fable 5</strong> من Anthropic،
            و<strong>Gemini</strong> من Google.
        </p>

        <h2 id="gap-collapsed">الفجوة انهارت: من 0.5% إلى 4.4 أشهر</h2>

        <p>
            في أغسطس 2024، كانت الفجوة بين أفضل نموذج مغلق وأفضل نموذج
            مفتوح <strong>0.5%</strong> فقط على بعض المؤشرات. ثم اتسعت
            مؤقتًا، ثم انهارت مرة أخرى. في سبتمبر 2026، قدّرت Mozilla
            أن الفجوة تعادل <strong>4.4 أشهر</strong> من البحث
            والتطوير: أي أن النموذج المفتوح يحتاج أقل من خمسة أشهر
            ليلحق بمستوى النموذج المغلق اليوم.
        </p>

        <p>
            على مؤشر Epoch AI المركب (الذي يجمع الاستدلال والبرمجة
            والمعرفة العامة)، حصل <strong>Kimi K3</strong> المفتوح على
            157 نقطة، مقابل 162 لنموذج <strong>Fable 5</strong>
            المغلق. الفارق خمس نقاط فقط، وهو فارق يُقدَّر بأربعة أشهر
            من التطوير. والأهم أن الفجوة تُقاس بـ<strong>الوقت</strong>
            لا بالمسافة: النموذج المفتوح يلحق بالنموذج المغلق خلال
            أشهر، ثم يلحق النموذج المغلق بجيل جديد، وهكذا.
        </p>

        <p>
            لكن هناك تحفظ مهم. مؤشر «الأفق الزمني» من METR — أي طول
            المهمة المعقدة التي يستطيع الوكيل إنجازها باستقلالية بنسبة
            نجاح 50% — يُظهر أن النموذج المغلق يتعامل مع مهام أطول
            بحوالي <strong>1.74 مرة</strong> من النموذج المفتوح. إذا
            كان النموذج المفتوح ينجز مهمة سبع ساعات، فالمغلق ينجز
            مهمة 12 ساعة. هذا فرق حقيقي، لكنه يضيق بوتيرة سريعة.
        </p>

        <p>
            المهم أن هذه الفجوة لم تعد تعني أن المفتوح «غير صالح
            للعمل». في المهام المؤسسية الواسعة — التصنيف، والاستخراج،
            والتوجيه، والتلخيص، والبرمجة القياسية — النماذج المفتوحة
            أصبحت <strong>«جيدة بما يكفي»</strong>، وهذا يعيد ترتيب
            الأولويات.
        </p>

        <h2 id="cost-revolution">ثورة التكلفة: 90% من الأداء بعُشر الثمن</h2>

        <p>
            هذا هو العامل الأكثر حسماً، والأقل إثارة للجدل. في 2026،
            تستطيع النماذج المفتوحة أداء حوالي <strong>90%</strong> من
            مهام النموذج الأكثر تقدمًا، وبتكلفة بنية تحتية أقل بكثير.
        </p>

        <p>
            الأرقام صريحة: <strong>DeepSeek V4.1-Flash</strong> حقق
            98% من نتيجة أفضل نموذج مغلق على معيار تصميم خارجي،
            وبتكلفة <strong>1.4%</strong> فقط. و<strong>Kimi K3</strong>
            يتخلف بثلاث نقاط عن Fable 5، لكنه يُكلّف
            <strong>30%</strong> من سعره. و<strong>Llama 4 Maverick</strong>
            يتفوق على GPT-4o في معايير رئيسية بتكلفة 0.30 دولار لكل
            مليون رمز. و<strong>DeepSeek R1</strong> يقدم استدلالًا
            بمستوى GPT-4 بتكلفة 0.55 دولار لكل مليون رمز إدخال، أي
            أرخص بـ<strong>27 مرة</strong> من Claude Opus.
        </p>

        <div class="overflow-x-auto my-4">
            <table
                class="w-full text-right border border-zinc-200 dark:border-zinc-700 rounded-lg"
            >
                <thead
                    class="bg-zinc-100 dark:bg-zinc-800 light:text-zinc-700 dark:text-zinc-300"
                >
                    <tr>
                        <th class="px-4 py-2 font-semibold">المقياس</th>
                        <th class="px-4 py-2 font-semibold">القيمة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                    <tr>
                        <td class="px-4 py-2">DeepSeek V4.1-Flash مقابل أفضل مغلق</td>
                        <td class="px-4 py-2">98% من النتيجة بتكلفة 1.4%</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">Kimi K3 مقابل Fable 5</td>
                        <td class="px-4 py-2">3 نقاط أقل، 30% من التكلفة</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">DeepSeek R1 مقابل Claude Opus</td>
                        <td class="px-4 py-2">27 مرة أرخص</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">تبني المؤسسات للنماذج المفتوحة</td>
                        <td class="px-4 py-2">تخفيض تكاليف التنفيذ 60%، والصيانة 46%</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2">توفير محتمل للاقتصاد العالمي</td>
                        <td class="px-4 py-2">200–480 مليار دولار سنويًا</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p>
            هذا الفارق ليس هامشيًا. المؤسسة التي تدفع أربعة أضعاف مقابل
            تحسين بنسبة 10% في الأداء تحتاج إلى تبرير اقتصادي قوي.
            ومعظم الشركات لن تدفع. <strong>القرار لم يعد تقنيًا، بل
            اقتصاديًا</strong>.
        </p>

        <h2 id="enterprise-shift">تحول المؤسسات: من «الولاء للمورد» إلى «محفظة نماذج»</h2>

        <p>
            في 2024، كانت المؤسسة تختار نموذجًا مغلقًا واحدًا وتلتزم به.
            في 2026، الصورة مختلفة. الرؤساء التنفيذيون في IBM وSAP
            وMeta يتحدثون عن <strong>محفظة نماذج</strong>: بعضها مغلق
            للمهام الحرجة، ومعظمها مفتوح للمهام اليومية.
        </p>

        <p>
            أرفيند كريشنا، الرئيس التنفيذي لـIBM، لخص المنطق: في 2024
            لم تكن المؤسسة لتقبل نموذجًا رخيصًا أقل قدرة بنسبة 70%.
            لكن الفجوة أُغلقت في 2025. في 2026، النماذج المفتوحة تنجز
            حوالي 90% من عمل النموذج الأكثر تقدمًا، وبتكلفة تتراوح بين
            10% و25% من تكلفة الرموز في النموذج المغلق. «هل تريد شيئًا
            بتكلفة 10% إذا كان بجودة 90%؟ أم تريد أن تدفع عشرة أضعاف؟».
        </p>

        <p>
            هذا لا يعني اختفاء النماذج المغلقة. إنها تحتفظ بقيمتها في
            <strong>العمل الاحترافي المتخصص، والاسترجاع المكثف،
            والسياق الطويل</strong>. لكنها لم تعد الافتراضي لكل شيء.
            شركة مثل DoorDash تستخدم Kimi للعمل الروتيني، وتحتفظ
            بـFable للمهام الصعبة التي كانت ستستهلك وقت خبراء بشريين.
        </p>

        <p>
            على مستوى حركة المرور الفعلية، بلغت حصة النماذج المفتوحة
            في Vercel AI Gateway <strong>36%</strong> من حجم الرموز في
            يوليو 2026، ارتفاعًا من 11% في أبريل. لكن حصتها من
            الإنفاق كانت 8.6% فقط، وهذا يوضح المفارقة: النماذج
            المفتوحة تُستخدم كثيرًا لأنها رخيصة، لكنها لا تحقق
            إيرادات للبائعين. <strong>القيمة تنتقل من بائع النموذج
            إلى من يبنيه ويشغله</strong>.
        </p>

        <h2 id="sovereignty">السيادة الرقمية والتحكم في البيانات</h2>

        <p>
            بالنسبة للحكومات والمؤسسات في القطاعات الحساسة — الصحة،
            والدفاع، والمالية — لم يعد السؤال «أي نموذج أذكى؟» بل
            «أين تعمل بياناتي؟». النموذج المغلق يعني أن كل استعلام يمر
            عبر خوادم مورّد خارجي، وأن السياسات والبيانات قد تخضع
            لولاية قضائية أخرى.
        </p>

        <p>
            النموذج المفتوح الأوزان يغير المعادلة: يمكن تشغيله داخل
            مركز بيانات المؤسسة، أو على حافة الشبكة، دون أن تغادر
            البيانات الحدود. في دراسة عن نماذج الروبوتات في المستشفيات،
            وُجد أن خصوصية المرضى وشبكات المستشفيات غير الموثوقة
            وسلامة التحقق تفضّل جميعها <strong>نماذج على الجهاز</strong>
            يمكن للمستشفى أو المورّد فحصها، وهو ما تسمح به الأوزان
            المفتوحة.
        </p>

        <p>
            هذا البعد يفسر لماذا تبنت دول عديدة استراتيجيات «ذكاء
            اصطناعي سيادي» تعتمد على النماذج المفتوحة. منظمة التعاون
            الاقتصادي والتنمية (OECD) ربطت صراحة بين انفتاح الذكاء
            الاصطناعي و<strong>السيادة التكنولوجية والاستقلال
            الاستراتيجي</strong>، لأن النشر المحلي يسمح بالاحتفاظ
            بالتحكم في البيانات الحساسة وتقليل الاعتماد على موردين
            خارجيين.
        </p>

        <h2 id="innovation-engine">محرك الابتكار: لماذا المفتوح يسرّع الجميع؟</h2>

        <p>
            الحجة الاقتصادية لا تتوقف عند التكلفة المباشرة. النماذج
            المفتوحة تغير <strong>بنية الابتكار</strong> نفسها. عندما
            تكون الأوزان متاحة، يستطيع أي فريق صغير أن يبني عليها،
            ويخصصها، ويختبر أفكارًا لا تستطيع الشركات الكبرى تبرير
            تكلفتها.
        </p>

        <p>
            هذا ليس تخمينًا. بيانات منظمة التعاون الاقتصادي والتنمية
            وجدت علاقة إيجابية ذات دلالة إحصائية بين نشاط الذكاء
            الاصطناعي مفتوح المصدر — مقيسًا بمساهمات GitHub — والنمو
            الاقتصادي في 33 دولة. كما أن المنظمة تشير إلى أن الانفتاح
            ينقل خلق القيمة إلى الطبقات الوسيطة والدنيا من مكدس
            الذكاء الاصطناعي، حيث تستطيع الشركات الناشئة والمؤسسات
            الصغيرة والمتوسطة تكييف الأنظمة لاحتياجاتها المحلية.
        </p>

        <p>
            ديناميكية «أفق الوقت» تكشف شيئًا مهمًا: أفق النماذج
            المفتوحة يتضاعف كل <strong>3.9 أشهر</strong>، بينما أفق
            النماذج المغلقة يتضاعف كل <strong>5.5 أشهر</strong>. أي أن
            النماذج المفتوحة لا تلحق فقط، بل تتقدم بمعدل أسرع. هذا
            يعني أن الفجوة ستستمر في التقلص، لا في الاتساع.
        </p>

        <h2 id="objections">الاعتراضات المشروعة: الأمان والجودة والدعم</h2>

        <p>
            لا يمكن بناء حجة جدية دون مواجهة الاعتراضات. ثلاثة منها
            تستحق النظر:
        </p>

        <h3>1. الأمان وسوء الاستخدام</h3>

        <p>
            النماذج المفتوحة يمكن تنزيلها واستخدامها دون رقابة. هذا
            يثير مخاوف حقيقية حول الاستخدام الضار. لكن الحجة المقابلة
            قوية: البرمجيات مفتوحة المصدر مثل Linux تُعتبر غالبًا أكثر
            أمانًا لأن ثغراتها تُفحص وتُرقّع من مجتمع واسع. الشفافية
            تسمح بالتدقيق، والتدقيق يسمح بالاكتشاف المبكر.
        </p>

        <h3>2. الجودة في المهام القصوى</h3>

        <p>
            النموذج المغلق لا يزال متفوقًا في أصعب مهام الاستدلال،
            والمهام الطويلة، والاسترجاع المكثف. هذا صحيح، لكنه يعني
            أن النموذج المغلق أصبح <strong>أداة متخصصة</strong>، لا
            الافتراضي. المؤسسة العاقلة تستخدم المفتوح للجزء الأكبر من
            العمل، والمغلق للجزء الحرج.
        </p>

        <h3>3. الدعم والمساءلة</h3>

        <p>
            المؤسسات تدفع للنموذج المغلق مقابل «حزمة الامتثال والدعم
            والمساءلة»، وليس فقط مقابل النموذج. كثير من المؤسسات تفتقر
            إلى الكوادر لتشغيل النماذج المفتوحة بشكل جيد. هذا اعتراض
            عملي، لكنه يتراجع مع نضوج أدوات النشر المُدار مثل
            Ollama وvLLM والمنصات السحابية التي تدعم النماذج المفتوحة.
        </p>

        <h2 id="geopolitics">البعد الجيوسياسي: الصين والولايات المتحدة وأوروبا</h2>

        <p>
            المعركة ليست تقنية فقط. استراتيجيات الأطراف مختلفة
            جذريًا:
        </p>

        <ul>
            <li>
                <strong>المختبرات الأمريكية المغلقة</strong> (OpenAI،
                Anthropic، Google): تحقيق الدخل عبر الواجهات البرمجية،
                وبناء الخنادق، والدفاع عن الهوامش.
            </li>
            <li>
                <strong>Meta (Llama):</strong> أوزان مفتوحة دفاعيًا
                للحفاظ على المواهب ومنع سيطرة Apple/Google/Microsoft
                على النظام البيئي.
            </li>
            <li>
                <strong>المختبرات الصينية المفتوحة</strong> (Qwen،
                DeepSeek، GLM، MiniMax): استراتيجية
                <strong>تسليع متعمدة</strong>. بإتاحة نماذج بجودة
                الحدود الأمامية مجانًا برخص متسامحة، تضمن أن الافتراضي
                العالمي — ما يصل إليه المطورون أولًا، وما يُخصص
                لتطبيقات القطاعات — صيني.
            </li>
        </ul>

        <p>
            النتائج بدأت تظهر: بحلول أواخر 2025، تجاوزت النماذج الصينية
            مفتوحة الأوزان نظيرتها الأمريكية في تنزيلات Hugging Face
            (17% مقابل 15.8%)، وهي المرة الأولى التي تتفوق فيها الصين
            في أي مقياس مفتوح. وفي شريحة النماذج التي تتجاوز مليار
            معامل، كانت Meta في الصدارة بنسبة 23.2%، لكن علي بابا
            وصلت إلى 20%، والمسار كان لصالحها.
        </p>

        <p>
            أوروبا تحاول اللحاق عبر مبادرات مثل Euro-Office في البرمجيات
            المكتبية، وتوجهات مماثلة في الذكاء الاصطناعي. القانون
            الأوروبي للذكاء الاصطناعي (EU AI Act) يستثني صراحة
            النماذج المنشورة برخصة حرة ومفتوحة من بعض الالتزامات،
            مما يعطي دفعة تنظيمية للنماذج المفتوحة.
        </p>

