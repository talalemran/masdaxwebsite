---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "bloomberg-bonobo-mock-cpp-testing-library-no-code-changes",
    title: "مهندسو بلومبرج يطلقون BonoboMock: مكتبة اختبار C++ ثورية بدون تعديل أكواد",
    metaTitle: "BonoboMock: اختبار C++ بدون تعديل الأكواد الموجودة",
    description:
        "مهندسو بلومبرج نشروا BonoboMock — مكتبة C++ للمحاكاة والاختبار تتطلب صفر تغييرات في الأكواد الموجودة، مما يحسّن الإنتاجية ويقلل التعقيد التقني في البيئات الضخمة والمعقدة، خاصة الأنظمة المالية عالية الأداء.",
    keywords: [
        "BonoboMock",
        "Bloomberg",
        "C++ Testing",
        "Unit Testing",
        "Mocking Library",
        "Zero Code Changes",
        "Financial Technology",
        "Software Engineering",
        "Testing Framework",
        "Open Source",
    ],
    category: "برمجة",
    author: "طلال عمران",
    date: "14 سبتمبر 2026",
    pubDate: new Date("2026-09-14"),
    tags: ["Bloomberg", "C++", "Testing", "مكتبة", "برمجة"],
    thumbnail: "/images/bloomberg-bonobo-mock-cpp-testing-library-no-code-changes.webp",
};
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>

        <p>
            نشر مهندسون من <a href="https://www.bloomberg.com/" target="_blank" rel="noopener noreferrer nofollow">بلومبرج</a>
            أخيراً مشروعاً جديداً مفتوح المصدر يسمى <strong>BonoboMock</strong> — مكتبة C++ متخصصة في الاختبار والمحاكاة 
            (Mocking) بطريقة ثورية. ما يجعل هذا المشروع مختلفاً عن آلاف مكتبات الاختبار الأخرى هو ميزته الفريدة: 
            <strong>لا تتطلب أي تعديلات على الأكواد الموجودة</strong>. في صناعة يسيطر عليها التعقيد والبيروقراطية، 
            هذه إضافة حقيقية مهمة جداً. بلومبرج، التي تعتمد على C++ بشكل كثيف في بناء أنظمتها المالية عالية الأداء، 
            أدركت الحاجة الماسة لأداة اختبار تتكيف مع الأنظمة الموجودة بدلاً من إجبار المطورين على إعادة كتابة 
            أكوادهم. هذا الإطلاق يعكس فهماً عميقاً لتحديات الهندسة البرمجية في المؤسسات الكبيرة.
        </p>

        <h2>السياق التاريخي والخلفية</h2>

        <p>
            لطالما كانت كتابة الاختبارات في C++ مهمة معقدة. بخلاف لغات حديثة مثل Python و JavaScript التي توفر مكتبات 
            اختبار بسيطة وقوية مدمجة، C++ تاريخياً كانت تحتاج إلى عمل يدوي كبير. المطورون كانوا مضطرين لـ:
        </p>

        <p>
            أولاً: <strong>إعادة تصميم معمارية أكوادهم</strong> لتكون قابلة للاختبار — إضافة واجهات (interfaces) وتبعيات 
            غير ضرورية. ثانياً: <strong>استخدام مكتبات مثل Google Mock و Catch2</strong> التي تتطلب بنية معينة وغالباً 
            تحتاج تعديلات كبيرة على الكود الموجود. ثالثاً: <strong>التعامل مع التعقيد الناشئ</strong> من محاولة محاكاة 
            الدوال والكائنات المعقدة. في المؤسسات الضخمة مثل بلومبرج، حيث الأنظمة تتكون من ملايين الأسطر من الكود المكتوب 
            عبر عقود، فكرة "إعادة كتابة الكود لتصبح قابلة للاختبار" ليست واقعية على الإطلاق. بلومبرج نفسها تعاني من هذه 
            المشاكل منذ سنوات، وتجربتها مع مكتبتها الخاصة BDE (Basic Development Environment) أعطتها رؤية فريدة عن ما تحتاجه 
            الصناعة حقاً.
        </p>

        <h2>ما هي BonoboMock وكيف تعمل</h2>

        <p>
            <img
                src="/images/articles/bloomberg-bonobo-mock-cpp-testing-library-no-code-changes/01.webp"
                alt="BonoboMock c++"
                width="288"
                height="254"
                loading="lazy"
                style=" display: block;  margin-left: auto;  margin-right: auto;"
            />
        </p>

        <h3>المحاكاة بدون تعديل الكود</h3>

        <p>
            الفكرة الأساسية بسيطة لكن قوية جداً: <strong>BonoboMock تحقن سلوك اختبار في الدوال والكائنات موجودة 
            بالفعل دون الحاجة لتعديل الكود الأصلي</strong>. كيف؟ من خلال استخدام تقنيات متقدمة في C++ مثل:
        </p>

        <p>
            أولاً: <strong>Linker-level interception</strong> — بدلاً من تعديل الكود، BonoboMock تتدخل على مستوى 
            المحرر (Linker) لالتقاط استدعاءات الدوال. هذا يعني أن الكود الأصلي يبقى دون لمس. ثانياً: 
            <strong>Runtime polymorphism</strong> — المكتبة تستخدم تقنيات متطورة للحقن الديناميكي لسلوك البيئة 
            المحاكاة. ثالثاً: <strong>Configuration-based setup</strong> — المطورون يمكنهم تعريف السلوك المتوقع للدوال 
            المحاكاة من خلال ملفات إعدادات أو دوال بسيطة، دون المس بالكود الأصلي.
        </p>

        <h3>الفوائد العملية</h3>

        <p>
            هذا النهج يحمل فوائد ضخمة على المستوى العملي. المطورون لا يحتاجون لـ:
        </p>

        <ul>
            <li>
                <strong>إعادة صياغة الدوال:</strong> إذا كانت دالة معينة تتصل بقاعدة بيانات خارجية، لا تحتاج لتعريف 
                واجهة جديدة أو تغيير البنية — BonoboMock تحل هذا في المستوى الأعمق.
            </li>
            <li>
                <strong>مساحة جديدة للخطأ:</strong> لا توجد طبقة إضافية من الأكواد التي قد تفشل. المكتبة تعمل شفافياً.
            </li>
            <li>
                <strong>وقت إعادة التدريب:</strong> فريق موجود يعمل مع نظام معقد قد لا يحتاج لتدريب طويل — المكتبة 
                توفر واجهة حدسية وبسيطة.
            </li>
        </ul>

        <h2>التفاصيل التقنية والعمارة</h2>

        <h3>آلية العمل الداخلية</h3>

        <p>
            <img
                src="/images/articles/bloomberg-bonobo-mock-cpp-testing-library-no-code-changes/02.webp"
                alt="c++ logo"
                width="1200"
                height="676"
                loading="lazy"
            />
        </p>

        <p>
            تحت الغطاء، BonoboMock تعتمد على عدة آليات متقدمة:
        </p>

        <p>
            <strong>أولاً: Symbol Interception</strong> — عندما ينتهي المترجم من ترجمة الأكواد، المحرر (Linker) يربط 
            الرموز والدوال معاً. BonoboMock تُوفر نسخة بديلة من الدوال المختارة، وتخبر المحرر باستخدام النسخة الجديدة 
            عند التشغيل الاختباري. هذا يعني أن الكود الأصلي نفسه لم يتغير قط — فقط الرابطة بين الدوال تغيرت.
        </p>

        <p>
            <strong>ثانياً: Template Metaprogramming</strong> — المكتبة تستخدم تقنيات C++ متقدمة جداً (template 
            specialization وـ concept synthesis) لتحديد وتوليد أكواد محاكاة ديناميكية بناءً على توقيع الدالة.
        </p>

        <p>
            <strong>ثالثاً: Configuration DSL</strong> — BonoboMock توفر "Domain-Specific Language" بسيط يتيح 
            للمطورين تحديد السلوك المتوقع:
        </p>

        <p style="background-color: #f4f4f4; padding: 10px; border-left: 4px solid #007bff; margin: 15px 0;">
            MOCK(calculateInterest, returns=5.25);<br/>
            MOCK(getUserData, throws=DatabaseException);<br/>
            MOCK(processTransaction, modifies_argument=0);
        </p>

        <h2>الأثر على صناعة الاختبار والتطوير</h2>

        <h3>الفوائد للمؤسسات الكبيرة</h3>

        <p>
            بلومبرج ليست الوحيدة التي تعاني من مشكلة الاختبار في الأنظمة الضخمة. البنوك والمؤسسات المالية الأخرى والشركات 
            التي تعتمد على C++ بشكل كبير ستجد في BonoboMock حلاً حقيقياً. التكاليف المتوقعة للانتفاع:
        </p>

        <ul>
            <li>
                <strong>تقليل وقت كتابة الاختبارات:</strong> بدون الحاجة لإعادة البناء المعماري، المطورون يمكنهم 
                كتابة اختبارات بسرعة أكبر بـ 40-50%.
            </li>
            <li>
                <strong>تحسن جودة الأكواس:</strong> الاختبارات الأفضل والأسرع تعني المزيد من الاختبارات والتغطية أوسع.
            </li>
            <li>
                <strong>تقليل الأخطاء الإنتاجية:</strong> أنظمة مختبرة بشكل جيد تعني أخطاء أقل في الإنتاج.
            </li>
        </ul>

        <h2>قراءة تحليلية مستقلة</h2>

        <p>
            هناك شيء مثير للإعجاب في هذا الإطلاق. بلومبرج تعرف أن المشاكل الحقيقية في الهندسة البرمجية الحديثة لا تحل 
            بحماس أو أيديولوجيات — تحل بأدوات عملية تناسب الواقع. BonoboMock هي أداة واقعية. الجانب الإيجابي واضح: 
            المكتبة توفر حلاً حقيقياً لمشكلة حقيقية. الجانب السلبي: التبني قد يكون بطيئاً. مطورو C++ تاريخياً يفضلون 
            الأدوات المألوفة والمثبتة. BonoboMock جديدة وتتطلب ثقة. كما أن الوثائق والمجتمع حول المكتبة سيحتاج لوقت 
            للنمو. هناك أيضاً سؤال فلسفي: هل يجب أن نعتمد على مثل هذه التقنيات المتقدمة بدلاً من بناء معمارية أفضل من 
            البداية؟ الإجابة: في العالم الحقيقي، الأنظمة الموجودة لن تعاد بناء. BonoboMock تعترف بهذا الواقع.
        </p>

        <h2>الأسئلة الشائعة</h2>

        <h3>س: هل BonoboMock تحل جميع مشاكل الاختبار في C++؟</h3>
        <p>
            ج: لا، هذه ليست حلاً سحرياً. BonoboMock متخصصة في المحاكاة (Mocking) والدوال الخارجية. لا تزال تحتاج 
            إلى أدوات أخرى لأنواع الاختبارات الأخرى (الاختبارات المتكاملة، اختبارات الأداء، إلخ).
        </p>

        <h3>س: هل يمكنني استخدام BonoboMock مع الأنظمة الموجودة؟</h3>
        <p>
            ج: هذا هو القصد الأساسي لـ BonoboMock. بدون تعديل الأكواس الموجودة، يمكنك البدء في الاختبار فوراً. 
            لكن قد تحتاج بعض الجهود لفهم كيفية حقن سلوك معين للدوال المعقدة.
        </p>

        <h3>س: هل هناك تأثير على الأداء عند استخدام BonoboMock في الاختبارات؟</h3>
        <p>
            ج: نعم، هناك تأثير بسيط على الأداء بسبب طبقة الحقن الإضافية، لكن هذا عادة ما يكون مقبولاً في بيئة الاختبار.
        </p>

        <h3>س: هل بلومبرج ستواصل تطوير BonoboMock؟</h3>
        <p>
            ج: بناءً على التزام بلومبرج بالمشاريع مفتوحة المصدر الأخرى (BDE، RMQcpp، إلخ)، من المتوقع أن نرى 
            استثمارات مستمرة في تطوير BonoboMock.
        </p>

        <h2>الخاتمة</h2>

        <p>
            BonoboMock تمثل خطوة مهمة نحو تحسين تجربة الاختبار في C++. في عصر حيث الأنظمة تصبح أكثر تعقيداً والشركات 
            تحتاج إلى أدوات عملية تناسب واقعها، مكتبة كهذه توفر قيمة حقيقية. بلومبرج، بخبرتها الطويلة في البرمجة 
            عالية الأداء والمتطلبات الصارمة للأنظمة المالية، جلبت معها معرفة عميقة عن ما يحتاجه المطورون حقاً. 
            سواء كنت مطوراً في مؤسسة مالية كبيرة أو في شركة تقنية، BonoboMock توفر أداة جديرة بالاهتمام والتجربة. 
            النجاح الحقيقي سيقاس بالتبني الفعلي في المشاريع الضخمة — وهناك مؤشرات قوية تشير إلى أن المشروع قد يكون 
            بداية لتغيير في كيفية اختبار أنظمة C++ الضخمة في المستقبل.
        </p>

        <h3>المصادر:</h3>
        <p>
            <a href="https://github.com/bloomberg" target="_blank" rel="noopener noreferrer nofollow">
                مستودع بلومبرج على GitHub
            </a>
        </p>
    </PostLayout>
</BaseLayout>