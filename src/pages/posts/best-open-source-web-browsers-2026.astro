---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostLayout from "@/components/PostLayout.astro";

const postModules = import.meta.glob("../posts/*.astro", { eager: true });
const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

export const post = {
    slug: "best-open-source-web-browsers-2026",
    title: "أفضل متصفحات الويب مفتوحة المصدر في 2026: دليل شامل",
    metaTitle: "أفضل متصفحات ويب مفتوحة المصدر 2026: مقارنة شاملة",
    description:
        "دليل معمق لأفضل المتصفحات مفتوحة المصدر في 2026: Firefox وBrave وTor وLibreWolf وUngoogled Chromium وFalkon وMidori وZen وWaterfox وMullvad. الخصوصية، الأداء، الترخيص، والاختيار الصحيح.",
    keywords: [
        "أفضل متصفحات مفتوحة المصدر",
        "Firefox",
        "Brave",
        "Tor Browser",
        "LibreWolf",
        "Ungoogled Chromium",
        "Falkon",
        "Midori",
        "Zen Browser",
        "Waterfox",
        "Mullvad Browser",
        "متصفحات ويب 2026",
    ],
    category: "برامج",
    author: "طلال عمران",
    date: "20 نوفمبر 2026",
    pubDate: new Date("2026-11-20"),
    tags: ["متصفحات", "مفتوح المصدر", "خصوصية", "Firefox", "Brave", "Tor"],
    thumbnail: "/images/best-open-source-web-browsers-2026.webp",
};

const tocItems = [
    { id: "at-a-glance", label: "نظرة سريعة: خريطة المتصفحات مفتوحة المصدر" },
    { id: "why-open-source", label: "لماذا المتصفح مفتوح المصدر؟ الشفافية كأساس للثقة" },
    { id: "firefox", label: "Firefox: العملاق المستقل الذي لا يزال يقاوم" },
    { id: "brave", label: "Brave: الخصوصية كميزة تجارية" },
    { id: "tor", label: "Tor Browser: المعيار الذهبي لإخفاء الهوية" },
    { id: "librewolf", label: "LibreWolf: Firefox بأقصى درجات التحصين" },
    { id: "ungoogled", label: "Ungoogled Chromium: كروم بدون جوجل" },
    { id: "lightweight", label: "Falkon وMidori: المتصفحات الخفيفة" },
    { id: "newcomers", label: "Zen وWaterfox وMullvad: البدائل الصاعدة" },
    { id: "comparison", label: "جدول المقارنة الشامل" },
    { id: "how-to-choose", label: "كيف تختار المتصفح المناسب؟" },
    { id: "best-practices", label: "أفضل الممارسات في أمان المتصفح" },
    { id: "final-checklist", label: "قائمة تحقق نهائية" },
    { id: "useful-links", label: "روابط ومصادر مفيدة" },
    { id: "faq", label: "أسئلة شائعة" },
];
---

<BaseLayout
    title={post.title}
    metaTitle={post.metaTitle}
    description={post.description}
    keywords={post.keywords}
    canonical={`/posts/${post.slug}/`}
    ogImage={post.thumbnail}
    ogType="article"
>
    <PostLayout {post} allPosts={allPosts}>
        <p>
            المتصفح هو أكثر برنامج تستخدمه على جهازك، وأكثر برنامج يعرف عنك.
            كل نقرة، كل بحث، كل تسجيل دخول، كل ثانية تقضيها في قراءة صفحة —
            كلها تمر عبره. ومع ذلك، معظم الناس يستخدمون متصفحًا واحدًا
            لأنهم "اعتادوا عليه"، دون أن يسألوا: <strong>ماذا يفعل هذا
            المتصفح ببياناتي؟</strong>
        </p>

        <p>
            المتصفحات مفتوحة المصدر تقدم إجابة مختلفة. ليس لأنها "مجانية"
            (معظم المتصفحات التجارية مجانية أيضًا)، بل لأن
            <strong>كودها متاح للتدقيق</strong>. يمكنك أن ترى ما يفعله
            المتصفح فعلاً، لا ما تقوله صفحة التسويق. في 2026، هذا
            الفرق أصبح جوهريًا: مع تصاعد التشريعات حول الخصوصية، وتزايد
            هجمات بصمة المتصفح (Fingerprinting)، أصبح اختيار متصفح
            مفتوح المصدر قرارًا أمنيًا وليس ترفًا تقنيًا.
        </p>

        <p>
            هذا الدليل لا يكتفي بقائمة أسماء. إنه يفكك كل متصفح من
            الداخل: <strong>Firefox</strong> كعملاق مستقل،
            <strong>Brave</strong> كخصوصية تجارية،
            <strong>Tor</strong> كمعيار إخفاء الهوية،
            <strong>LibreWolf</strong> كتحصين أقصى،
            <strong>Ungoogled Chromium</strong> ككروم منزوع الجوجل،
            <strong>Falkon</strong> و<strong>Midori</strong> كخيارات
            خفيفة، و<strong>Zen</strong> و<strong>Waterfox</strong>
            و<strong>Mullvad</strong> كبدائل صاعدة. الهدف أن تختار
            متصفحًا تعرف بالضبط لماذا اخترته.
        </p>

        <nav
            class="toc bg-navy-50 border border-navy-200 dark:bg-zinc-800 dark:border-zinc-700 rounded-lg p-8 my-6"
            aria-label="جدول المحتويات"
        >
            <p class="font-bold text-lg mb-4 text-navy-700 dark:text-white">
                محتويات المقال
            </p>
            <ol class="list-decimal list-inside space-y-3 text-lg">
                {tocItems.map((item) => (
                    <li>
                        <a
                            href={`#${item.id}`}
                            class="text-navy-700 dark:text-white hover:text-accent dark:hover:text-accent hover:underline"
                        >
                            {item.label}
                        </a>
                    </li>
                ))}
            </ol>
        </nav>

        <h2 id="at-a-glance">نظرة سريعة: خريطة المتصفحات مفتوحة المصدر</h2>

        <p>
            الجدول التالي يلخص المتصفحات التي يغطيها الدليل، مع
            الفئة التي تنتمي إليها والمحرك الذي تستخدمه:
        </p>

        <div class="overflow-x-auto my-4">
            <div class="inline-block min-w-full overflow-hidden rounded-lg border border-navy-200 dark:border-zinc-700">
                <table class="min-w-full text-right">
                    <thead class="bg-navy-50 dark:bg-zinc-800 text-navy-700 dark:text-zinc-300">
                        <tr>
                            <th class="px-4 py-2 font-semibold">المتصفح</th>
                            <th class="px-4 py-2 font-semibold">الفئة</th>
                            <th class="px-4 py-2 font-semibold">المحرك</th>
                            <th class="px-4 py-2 font-semibold">الترخيص</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                        <tr>
                            <td class="px-4 py-2"><strong>Firefox</strong></td>
                            <td class="px-4 py-2">عام / مستقل</td>
                            <td class="px-4 py-2">Gecko</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Brave</strong></td>
                            <td class="px-4 py-2">خصوصية / Chromium</td>
                            <td class="px-4 py-2">Blink</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Tor Browser</strong></td>
                            <td class="px-4 py-2">إخفاء هوية</td>
                            <td class="px-4 py-2">Gecko (Firefox ESR)</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>LibreWolf</strong></td>
                            <td class="px-4 py-2">خصوصية متطرفة</td>
                            <td class="px-4 py-2">Gecko (Firefox fork)</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Ungoogled Chromium</strong></td>
                            <td class="px-4 py-2">Chromium نقي</td>
                            <td class="px-4 py-2">Blink</td>
                            <td class="px-4 py-2">BSD-3-Clause</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Falkon</strong></td>
                            <td class="px-4 py-2">خفيف / KDE</td>
                            <td class="px-4 py-2">QtWebEngine (Chromium)</td>
                            <td class="px-4 py-2">GPL-3.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Midori</strong></td>
                            <td class="px-4 py-2">خفيف / خصوصية</td>
                            <td class="px-4 py-2">Gecko (حديثًا)</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Zen Browser</strong></td>
                            <td class="px-4 py-2">إنتاجية / Firefox fork</td>
                            <td class="px-4 py-2">Gecko</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Waterfox</strong></td>
                            <td class="px-4 py-2">خصوصية / Firefox fork</td>
                            <td class="px-4 py-2">Gecko</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-2"><strong>Mullvad Browser</strong></td>
                            <td class="px-4 py-2">مقاومة البصمة</td>
                            <td class="px-4 py-2">Gecko (Firefox ESR)</td>
                            <td class="px-4 py-2">MPL-2.0</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <h2 id="why-open-source">لماذا المتصفح مفتوح المصدر؟ الشفافية كأساس للثقة</h2>

        <p>
            <img
                src="/images/articles/best-open-source-web-browsers-2026/01.webp"
                alt="متصفحات مفتوحة المصدر"
                width="1200"
                height="805"
                loading="lazy"
                class="w-full h-auto rounded-lg mb-4"
            />
        </p>

        <p>
            المتصفح ليس مجرد نافذة على الويب. إنه
            <strong>نظام تشغيل مصغر</strong>: يشغّل JavaScript، ويدير
            ملفات تعريف الارتباط، ويتعامل مع الشهادات الرقمية، ويتصل
            بمئات الخوادم يوميًا. عندما تستخدم متصفحًا مغلق المصدر،
            فأنت تثق في الشركة التي بنته بأنها لا تسيء استخدام هذه
            القدرات. عندما تستخدم متصفحًا مفتوح المصدر، فأنت لا
            تحتاج إلى الثقة — يمكنك <strong>التحقق</strong>.
        </p>

        <p>
            هذا لا يعني أن كل متصفح مفتوح المصدر آمن أو خاص بشكل
            تلقائي. هناك متصفحات مفتوحة المصدر ترسل بيانات
            تليمترية، وأخرى لا. هناك متصفحات مفتوحة المصدر تعاني
            من ثغرات أمنية ببطء في الإصلاح، وأخرى تُحدَّث يوميًا.
            <strong>الانفتاح شرط ضروري، لكنه ليس كافيًا</strong>.
            لهذا يجب أن تنظر إلى عوامل أخرى: من يدير المشروع،
            وما هي سياسته في الإفصاح عن الثغرات، وما مدى سرعة
            تحديثاته الأمنية.
        </p>

        <p>
            في 2026، أصبح هذا التمييز مهمًا بشكل خاص لأن
            <strong>معظم المتصفحات مبنية على Chromium</strong>،
            وهو مشروع مفتوح المصدر تديره Google. هذا يعني أن
            المتصفح قد يكون "مفتوح المصدر" في واجهته، لكنه
            يعتمد على محرك يتحكم فيه لاعب واحد. المتصفحات
            المستقلة — مثل Firefox — تلعب دورًا حيويًا في
            الحفاظ على تنوع الويب ومنع احتكار محرك واحد.
        </p>

        <h2 id="firefox">Firefox: العملاق المستقل الذي لا يزال يقاوم</h2>

        <p>
            Firefox هو <strong>آخر متصفح رئيسي يستخدم محركًا
            مستقلًا (Gecko)</strong>، وليس Chromium. هذا وحده
            يجعله مهمًا. في 2026، يبلغ نصيبه من سوق سطح
            المكتب حوالي 7.38%، وهو رقم صغير لكنه يعني ملايين
            المستخدمين الذين يعتمدون على بديل حقيقي.
        </p>

        <p>
            Firefox 147 (يناير 2026) حسّن تشغيل الفيديو على
            بطاقات AMD من خلال تمكين "النسخ الصفري" (Zero-Copy
            Playback) للفيديو المفكوك عتاديًا، ليصل إلى
            التكافؤ مع Intel وNVIDIA. Firefox 159 (أكتوبر
            2026) أضاف ميزات ذكاء اصطناعي لمساعدة المستخدم
            على تتبع الصفحات، ودعم البحث في التبويبات
            المفتوحة عبر <code>Ctrl+Shift+A</code>. كما
            تحسنت سرعة تحميل المحتوى الرئيسي بنسبة 9% خلال
            العام الماضي، وأصبح عارض PDF أسرع بنسبة تصل
            إلى 45% في بعض السيناريوهات.
        </p>

        <p>
            Firefox هو الخيار <strong>المتوازن</strong>:
            مفتوح المصدر بالكامل، مستقل عن Google، يدعم
            آلاف الإضافات، ويقدم خصوصية أفضل من الافتراضي
            في المتصفحات التجارية. لكنه ليس "متصفح خصوصية
            متطرفة" — فهو يحتوي على بعض التليمترية
            (يمكن تعطيلها)، ويستخدم Google كمحرك بحث
            افتراضي في بعض المناطق. لمن يريد أساسًا
            متينًا يمكن تحصينه، Firefox هو نقطة البداية.
        </p>

        <h2 id="brave">Brave: الخصوصية كميزة تجارية</h2>

        <p>
            Brave هو متصفح مفتوح المصدر مبني على Chromium،
            لكنه يزيل الكثير من اتصالات Google ويضيف طبقة
            حماية قوية. يقدم <strong>حظر إعلانات ومتتبعات
            مدمجًا</strong> (Brave Shields)، وحماية من
            بصمة المتصفح، ووضع تصفح خاص يدمج شبكة Tor
            (اختياري). إنه من أكثر المتصفحات شعبية بين
            من يريدون "خصوصية جاهزة" دون إعدادات معقدة.
        </p>

        <p>
            لكن Brave ليس بلا انتقادات. نموذجه التجاري
            يقوم على الإعلانات التي يحل محل الإعلانات
            التقليدية (Brave Ads)، وعلى اشتراكات
            اختيارية مثل Brave VPN وBrave Leo (مساعد
            ذكاء اصطناعي). هذا يجعله <strong>مشروعًا
            تجاريًا</strong>، وليس مشروعًا مجتمعيًا
            خالصًا. الكود مفتوح، لكن القرارات تُتخذ
            في شركة. إذا كنت تريد خصوصية قوية مع
            تجربة "تعمل فورًا"، فBrave خيار ممتاز.
            إذا كنت تريد استقلالًا كاملًا عن أي نموذج
            تجاري، فقد تبحث في مكان آخر.
        </p>

        <h2 id="tor">Tor Browser: المعيار الذهبي لإخفاء الهوية</h2>

        <p>
            Tor Browser ليس "متصفحًا خاصًا" بالمعنى
            التقليدي. إنه <strong>أداة إخفاء هوية</strong>.
            يوجّه كل حركة المرور عبر شبكة Tor (ثلاثة
            عقد عشوائية حول العالم)، ويجعل كل مستخدمي
            Tor يبدون متطابقين من منظور المواقع، مما
            يمنع بصمة المتصفح. لا يعرف الموقع من
            أنت، ولا يعرف مزود خدمة الإنترنت ما
            تتصفحه.
        </p>

        <p>
            الثمن هو السرعة. تحميل الصفحات عبر Tor
            أبطأ بكثير من المتصفحات العادية، وكثير
            من المواقع تحجب مستخدمي Tor أو تطلب
            اختبارات CAPTCHA لا نهائية. إنه ليس
            متصفحًا للاستخدام اليومي (التسوق،
            البث، البنوك)، بل للبحث الحساس،
            والصحافة، والنشاط السياسي، وأي
            موقف تحتاج فيه إلى إخفاء هويتك
            حقًا. Tor Browser 16.0 (نوفمبر
            2026) يستند إلى Firefox ESR 153،
            ويظل الخيار الأول لمن يحتاج إلى
            أعلى مستوى من الخصوصية.
        </p>

        <h2 id="librewolf">LibreWolf: Firefox بأقصى درجات التحصين</h2>

        <p>
            LibreWolf هو <strong>نسخة معدلة من Firefox</strong>
            تزيل كل التليمترية، وتقطع الاتصال بخدمات
            Mozilla، وتطبق إعدادات خصوصية صارمة
            افتراضيًا. لا يوجد به Pocket، ولا
            رعاية، ولا اقتراحات، ولا مزامنة
            Firefox (افتراضيًا). يأتي مع
            <strong>uBlock Origin</strong> مثبتًا
            مسبقًا، ويعطل WebGL لمنع بصمة
            بطاقة الرسوميات، ويمسح الكوكيز
            وبيانات الموقع عند الإغلاق.
        </p>

        <p>
            هذه الصرامة تأتي بثمن. مواقع مثل
            YouTube أو بعض تطبيقات الويب
            المعقدة قد "تنكسر" وتحتاج إلى
            إعدادات إضافية. LibreWolf ليس
            مصممًا لمن يريد "تصفحًا سلسًا بلا
            تفكير"؛ إنه مصمم لمن يقبل بعض
            الإزعاج مقابل خصوصية قصوى. إذا
            كنت من هذا النوع، فهو من أفضل
            الخيارات المتاحة.
        </p>

        <h2 id="ungoogled">Ungoogled Chromium: كروم بدون جوجل</h2>

        <p>
            Ungoogled Chromium ليس "متصفحًا جديدًا" بقدر
            ما هو <strong>Chromium نقي مع إزالة كل
            اتصالات Google</strong>. لا توجد به
            خدمات Google، ولا تليمترية، ولا
            "Google Safe Browsing" (يمكن
            إضافته يدويًا إن أردت). الهدف:
            الحفاظ على تجربة Chromium الافتراضية
            قدر الإمكان، لكن دون الاعتماد على
            خدمات Google.
        </p>

        <p>
            هذا يعني أنك تحصل على <strong>توافق
            واسع مع المواقع</strong> (لأنه Chromium)،
            لكن دون الطبقات التي تضيفها Google.
            العيب: بعض الميزات التي تعتمد على
            Google (مثل الترجمة التلقائية أو
            مزامنة الإشارات) تحتاج إلى إعداد
            يدوي أو بدائل. كما أن التحديثات
            تعتمد على متطوعين، وقد تتأخر أحيانًا
            عن تحديثات Chromium الرسمية. إنه
            خيار جيد لمن يريد "كروم دون جوجل"،
            لكنه ليس للمبتدئين تمامًا.
        </p>

        <h2 id="lightweight">Falkon وMidori: المتصفحات الخفيفة</h2>

        <p>
            ليس كل مستخدم يحتاج إلى "متصفح كامل
            الميزات". على الأجهزة القديمة أو
            البيئات المكتبية الخفيفة، المتصفحات
            الثقيلة تكون عبئًا. هنا يأتي دور
            المتصفحات الخفيفة.
        </p>

        <p>
            <strong>Falkon</strong> هو متصفح KDE
            مبني على QtWebEngine (محرك Chromium).
            يقدم تكاملًا ممتازًا مع KDE Plasma،
            وحظر إعلانات مدمجًا، وواجهة خفيفة.
            لكنه يعتمد على دورة تحديث Chromium
            الخاصة بـQtWebEngine، مما يعني أن
            تحديثات الأمان قد تتأخر مقارنة
            بمتصفحات Chromium الرئيسية. إنه
            خيار جيد لمستخدمي KDE الذين يريدون
            متصفحًا "يشعر بأنه جزء من النظام".
        </p>

        <p>
            <strong>Midori</strong> تحول في 2026
            إلى استخدام محرك Gecko (بدلاً من
            WebKit)، وأصبح يقدم <strong>Midori
            Sync</strong> — خدمة مزامنة مفتوحة
            المصدر بتشفير من الطرف إلى الطرف.
            يهدف إلى أن يكون خفيفًا وسريعًا
            ويهتم بالخصوصية، مع دعم متعدد
            المنصات. لكنه لا يزال أقل نضجًا
            من Firefox أو Brave، وقد يواجه
            مشاكل توافق مع بعض المواقع الحديثة.
        </p>

        <h2 id="newcomers">Zen وWaterfox وMullvad: البدائل الصاعدة</h2>

        <p>
            بعيدًا عن الخيارات الرئيسية، هناك
            متصفحات أحدث تجذب جمهورًا متخصصًا:
        </p>

        <ul>
            <li>
                <strong>Zen Browser:</strong> مبني
                على Firefox، ويستعير أفضل أفكار
                Arc (شريط جانبي، تبويبات عمودية،
                تقسيم الشاشة) دون ذكاء اصطناعي
                أو تعقيد. مفتوح المصدر بترخيص
                MPL-2.0، ويركز على الإنتاجية
                والهدوء البصري. إنه خيار ممتاز
                لمن يحب فكرة Arc لكنه يريد
                متصفحًا مفتوح المصدر وخاليًا
                من الاشتراكات.
            </li>
            <li>
                <strong>Waterfox:</strong> من
                أقدم فروع Firefox. في 2026،
                يقدم حظر إعلانات مدمجًا،
                وOblivious DNS، ومزامنة،
                وتخصيصًا عاليًا (بما في
                ذلك تبويبات عمودية أصلية).
                يستهدف من يريد "Firefox
                بدون تليمترية" لكن مع
                تحديثات منتظمة وتجربة
                يومية سلسة. عيبه: لا يوجد
                محدث تلقائي على Windows
                وLinux (يجب تحديثه يدويًا).
            </li>
            <li>
                <strong>Mullvad Browser:</strong>
                ثمرة تعاون بين Mullvad VPN
                وTor Project. يقدم
                <strong>تحصين Tor دون
                شبكة Tor</strong>. يأتي
                مع uBlock Origin وNoScript
                مثبتين مسبقًا، ويجعل
                كل المستخدمين يبدون
                متطابقين لمقاومة البصمة.
                لكنه <strong>لا يخفي عنوان
                IP</strong> — تحتاج إلى
                VPN أو Tor لذلك. إنه
                لمن يريد مقاومة بصمة
                قوية مع سرعة متصفح
                عادي.
            </li>
        </ul>

