---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../posts/*.astro", { eager: true });
  const allPosts = Object.values(postModules)
    .map((mod: any) => mod.post)
    .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

  const categories = [...new Set(allPosts.flatMap((p) => Array.isArray(p.category) ? p.category : [p.category]))];
  return categories.map((category) => ({
    params: { category },
    props: { category, posts: allPosts },
  }));
}

export interface Props {
  category: string;
  posts: any[];
}

const { category, posts: allPosts } = Astro.props;
const pageSize = 9;
const filteredPosts = allPosts.filter((p) => {
  const cats = Array.isArray(p.category) ? p.category : [p.category];
  return cats.includes(category);
});
const totalPages = Math.ceil(filteredPosts.length / pageSize);
const pagePosts = filteredPosts.slice(0, pageSize);
const basePath = `/category/${category}/page`;
---

<BaseLayout
  title={category}
  description={`جميع المقالات في تصنيف ${category} على مصدر إكس`}
  keywords={[category, "تصنيفات", "مصادر مفتوحة"]}
  canonical={`/category/${category}/`}
  ogType="website"
>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="mb-6 text-sm font-body text-navy-400 dark:text-zinc-500">
      <a href="/" class="hover:text-accent dark:hover:text-white transition-colors no-underline">الرئيسية</a>
      <span class="mx-2">/</span>
      <span class="text-navy dark:text-white">{category}</span>
    </nav>

    <h1 class="font-heading text-3xl font-extrabold text-navy dark:text-white mb-2">
      تصنيف: {category}
    </h1>
    <p class="font-body text-navy-400 dark:text-zinc-500 mb-8">{filteredPosts.length} مقال</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        pagePosts.map((post) => (
          <ArticleCard
            title={post.title}
            description={post.description}
            category={post.category}
            author={post.author}
            date={post.date}
            tags={post.tags}
            slug={post.slug}
            thumbnail={post.thumbnail}
          />
        ))
      }
    </div>

    {totalPages > 1 && (
      <Pagination currentPage={1} totalPages={totalPages} basePath={basePath} />
    )}
  </section>
</BaseLayout>
