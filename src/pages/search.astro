---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="بحث — مصدر إكس"
  description="ابحث في مقالات ومشاريع مصدر إكس عن أي موضوع يهمك."
  keywords={["بحث", "search", "مصدر إكس", "مقالات", "مشاريع"]}
  canonical="/search/"
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="mb-6 text-sm font-body text-navy-400 dark:text-zinc-500">
      <a href="/" class="hover:text-accent dark:hover:text-white transition-colors no-underline"
        >الرئيسية</a
      >
      <span class="mx-2">/</span>
      <span class="text-navy dark:text-white">بحث</span>
    </nav>

    <h1
      class="font-heading text-3xl sm:text-4xl font-extrabold text-navy dark:text-white mb-6 leading-snug"
    >
      بحث
    </h1>

    <div class="relative mb-8">
      <i class="fa-solid fa-magnifying-glass absolute right-4 top-1/2 -translate-y-1/2 text-navy-400 dark:text-zinc-500 text-lg"></i>
      <input
        id="search-input"
        type="text"
        placeholder="ابحث عن مقالات، مشاريع، تصنيفات..."
        class="w-full pr-12 pl-4 py-4 text-lg font-body bg-white dark:bg-zinc-800 border border-navy-200 dark:border-zinc-700 rounded-xl text-navy dark:text-white placeholder-navy-400 dark:placeholder-zinc-500 focus:outline-none focus:border-accent dark:focus:border-accent transition-colors"
        autocomplete="off"
      />
      <button
        id="search-clear"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-navy-400 dark:text-zinc-500 hover:text-navy dark:hover:text-white transition-colors cursor-pointer bg-transparent border-none hidden"
        type="button"
        aria-label="مسح البحث"
      >
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>
    </div>

    <div id="search-status" class="mb-6 text-sm font-body text-navy-400 dark:text-zinc-500 hidden">
    </div>

    <div id="search-results" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    </div>

    <div id="search-empty" class="text-center py-16">
      <i class="fa-solid fa-magnifying-glass text-5xl text-navy-200 dark:text-zinc-600 mb-4"></i>
      <p class="font-heading text-xl font-bold text-navy dark:text-white mb-2">
        ابدأ بالكتابة للبحث
      </p>
      <p class="font-body text-base text-navy-400 dark:text-zinc-500">
        ابحث في أكثر من 60 مقالة و20 مشروع مفتوح المصدر
      </p>
    </div>

    <div id="search-no-results" class="hidden text-center py-16">
      <i class="fa-solid fa-face-sad-tear text-5xl text-navy-200 dark:text-zinc-600 mb-4"></i>
      <p class="font-heading text-xl font-bold text-navy dark:text-white mb-2">
        لا توجد نتائج
      </p>
      <p class="font-body text-base text-navy-400 dark:text-zinc-500">
        جرّب كلمات بحث مختلفة أو تصفّح التصنيفات
      </p>
    </div>

    <div id="search-loading" class="hidden text-center py-16">
      <div class="inline-block w-8 h-8 border-4 border-navy-200 dark:border-zinc-600 border-t-accent rounded-full animate-spin mb-4"></div>
      <p class="font-body text-base text-navy-400 dark:text-zinc-500">جاري تحميل البيانات...</p>
    </div>
  </section>

  <script>
    import Fuse from "fuse.js";

    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const clearBtn = document.getElementById("search-clear") as HTMLButtonElement;
    const resultsContainer = document.getElementById("search-results")!;
    const emptyState = document.getElementById("search-empty")!;
    const noResults = document.getElementById("search-no-results")!;
    const loadingState = document.getElementById("search-loading")!;
    const statusEl = document.getElementById("search-status")!;

    let searchData: any[] = [];
    let fuse: Fuse<any> | null = null;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;

    async function loadData() {
      loadingState.classList.remove("hidden");
      emptyState.classList.add("hidden");
      try {
        const res = await fetch("/search-data.json");
        searchData = await res.json();
        fuse = new Fuse(searchData, {
          keys: [
            { name: "title", weight: 0.4 },
            { name: "description", weight: 0.3 },
            { name: "tags", weight: 0.2 },
            { name: "category", weight: 0.1 },
          ],
          threshold: 0.4,
          includeMatches: true,
          minMatchCharLength: 2,
        });
        loadingState.classList.add("hidden");
        const q = new URLSearchParams(window.location.search).get("q");
        if (q) {
          searchInput.value = q;
          performSearch(q);
        } else {
          emptyState.classList.remove("hidden");
        }
      } catch {
        loadingState.classList.add("hidden");
      }
    }

    function renderResults(results: any[]) {
      if (results.length === 0) {
        resultsContainer.innerHTML = "";
        noResults.classList.remove("hidden");
        return;
      }
      noResults.classList.add("hidden");
      resultsContainer.innerHTML = results
        .map(
          (item: any) => `
          <a href="${item.url}" class="block bg-white dark:bg-zinc-800 border border-navy-100 dark:border-zinc-700 rounded-xl overflow-hidden no-underline hover:border-accent dark:hover:border-accent transition-colors group">
            ${item.thumbnail ? `<div class="bg-navy-50 dark:bg-zinc-900 overflow-hidden"><img src="${item.thumbnail}" alt="${item.title}" width="400" height="225" loading="lazy" class="w-full h-auto" /></div>` : ""}
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2 py-0.5 text-xs font-bold font-heading rounded-full ${item.type === "post" ? "text-white bg-navy" : item.type === "wiki" ? "text-navy bg-accent/20 border border-accent/30" : "text-white bg-accent"}">${item.type === "post" ? "مقال" : item.type === "wiki" ? "موسوعة" : "مشروع"}</span>
                ${item.category.map((c: string) => `<span class="inline-block px-2 py-0.5 text-xs font-body text-navy-600 dark:text-zinc-400 bg-navy-50 dark:bg-zinc-700 rounded-full">${c}</span>`).join("")}
              </div>
              <h3 class="font-heading text-lg font-bold text-navy dark:text-white mb-2 leading-snug group-hover:text-accent dark:group-hover:text-accent transition-colors line-clamp-2">${item.title}</h3>
              <p class="font-body text-sm text-navy-600 dark:text-zinc-400 leading-relaxed line-clamp-3">${item.description}</p>
              ${item.tags.length > 0 ? `<div class="flex flex-wrap gap-1.5 mt-3">${item.tags.slice(0, 4).map((t: string) => `<span class="inline-block px-2 py-0.5 text-xs font-body text-navy-500 dark:text-zinc-500 bg-navy-50 dark:bg-zinc-900 rounded-full">${t}</span>`).join("")}</div>` : ""}
            </div>
          </a>
        `
        )
        .join("");
    }

    function performSearch(query: string) {
      if (!query.trim()) {
        resultsContainer.innerHTML = "";
        statusEl.classList.add("hidden");
        noResults.classList.add("hidden");
        emptyState.classList.remove("hidden");
        clearBtn.classList.add("hidden");
        return;
      }

      clearBtn.classList.remove("hidden");
      emptyState.classList.add("hidden");

      let results: any[];
      if (fuse) {
        results = fuse.search(query).map((r) => r.item);
      } else {
        const q = query.toLowerCase();
        results = searchData.filter(
          (item: any) =>
            item.title.toLowerCase().includes(q) ||
            item.description.toLowerCase().includes(q) ||
            item.tags.some((t: string) => t.toLowerCase().includes(q)) ||
            item.category.some((c: string) => c.toLowerCase().includes(q))
        );
      }

      statusEl.textContent = `تم العثور على ${results.length} نتيجة`;
      statusEl.classList.remove("hidden");

      renderResults(results);
    }

    searchInput.addEventListener("input", function () {
      const query = this.value;
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () {
        performSearch(query);
        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set("q", query);
        } else {
          url.searchParams.delete("q");
        }
        history.replaceState({}, "", url.toString());
      }, 300);
    });

    clearBtn.addEventListener("click", function () {
      searchInput.value = "";
      performSearch("");
      searchInput.focus();
      const url = new URL(window.location.href);
      url.searchParams.delete("q");
      history.replaceState({}, "", url.toString());
    });

    searchInput.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        searchInput.value = "";
        performSearch("");
        clearBtn.classList.add("hidden");
      }
    });

    loadData();
  </script>
</BaseLayout>
