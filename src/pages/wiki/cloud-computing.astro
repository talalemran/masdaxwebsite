const tocItems = [
  { id: "definition", label: "تعريف الحوسبة السحابية" },
  { id: "history", label: "تاريخ الحوسبة السحابية" },
  { id: "how-it-works", label: "كيف تعمل الحوسبة السحابية؟" },
  { id: "service-models", label: "نماذج الخدمات السحابية" },
  { id: "deployment-models", label: "نماذج النشر السحابي" },
  { id: "providers", label: "مزودو الخدمات السحابية الرئيسيون" },
  { id: "benefits", label: "فوائد الحوسبة السحابية" },
  { id: "challenges", label: "تحديات الحوسبة السحابية" },
  { id: "use-cases", label: "استخدامات الحوسبة السحابية" },
  { id: "security", label: "أمن الحوسبة السحابية" },
  { id: "cost", label: "التكاليف والفوائد المالية" },
  { id: "future", label: "مستقبل الحوسبة السحابية" },
  { id: "getting-started", label: "كيف تبدأ مع الحوسبة السحابية؟" },
  { id: "resources", label: "موارد ومقالات ذات صلة" },
];

const page = {
  title: "الحوسبة السحابية: دليل شامل",
  description: "دليل عربي شامل عن الحوسبة السحابية: التعريف، نماذج الخدمات، المزودون الرئيسيون، الفوائد والتحديات، وأمثلة عملية.",
  tags: ["الحوسبة السحابية", "Cloud Computing", "AWS", "Azure", "Google Cloud", "SaaS", "IaaS", "PaaS"],
  category: ["تقنية معلومات", "موسوعة"],
  thumbnail: "/images/cloud-computing.webp",
