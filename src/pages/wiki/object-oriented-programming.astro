---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WikiLayout from "@/components/WikiLayout.astro";

const tocItems = [
  { id: "what-is-oop", label: "ما هي البرمجة الكائنية التوجيهية؟" },
  { id: "why-oop", label: "لماذا نستخدم OOP؟" },
  { id: "classes-objects", label: "الفئات والكائنات" },
  { id: "encapsulation", label: "التغليف (Encapsulation)" },
  { id: "inheritance", label: "الوراثة (Inheritance)" },
  { id: "polymorphism", label: "التعددية (Polymorphism)" },
  { id: "abstraction", label: "التجرد (Abstraction)" },
  { id: "composition", label: "التركيب (Composition)" },
  { id: "solid", label: "مبادئ SOLID" },
  { id: "design-patterns", label: "أنماط التصميم" },
  { id: "examples", label: "أمثلة عملية" },
  { id: "faq", label: "أسئلة شائعة" },
  { id: "resources", label: "موارد ومقالات ذات صلة" },
];

const page = {
  title: "البرمجة الكائنية التوجيهية: دليل شامل",
  description: "شرح مفصل لمفاهيم البرمجة الكائنية التوجيهية (OOP): الفئات، الكائنات، التغليف، الوراثة، التعددية، مبادئ SOLID، وأنماط التصميم.",
  tags: ["البرمجة الكائنية", "OOP", "Object Oriented Programming", "الفئات", "الكائنات", "الوراثة", "التغليف"],
  category: ["برمجة", "موسوعة"],
  thumbnail: "/images/oop-guide.webp",
  parent: { title: "أساسيات البرمجة", href: "/wiki/programming-fundamentals/" },
