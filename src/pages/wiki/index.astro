---
import BaseLayout from "@/layouts/BaseLayout.astro";

const wikiPages = [
  {
    title: "لينكس",
    description: "دليل شامل عن نظام لينكس: تاريخه، التوزيعات، بيئات سطح المكتب، أوامر الأساس، والبدء العملي.",
    href: "/wiki/linux-wiki/",
    icon: "fa-brands fa-linux",
    links: [
      { label: "أشهر توزيعات لينكس", href: "/wiki/linux-distributions/" },
      { label: "أنواع الطرفيات في لينكس", href: "/wiki/linux-terminals/" },
      { label: "بنية نظام ملفات لينكس", href: "/wiki/linux-filesystem/" },
    ],
    articles: [
      { label: "سطر الأوامر في لينكس: دليل شامل", href: "/posts/linux-command-line-complete-guide/" },
      { label: "بيئات سطح المكتب في لينكس", href: "/posts/linux-desktop-environments-guide/" },
      { label: "أنواع توزيعات لينكس حسب الاستخدام", href: "/posts/linux-distros-by-use-case-which-one-suits-you/" },
      { label: "ما هي المشاكل الشائعة في لينكس؟", href: "/posts/common-linux-problems-beginners-guide/" },
      { label: "هل أحتاج إلى معرفة برمجية لاستخدام لينكس؟", href: "/posts/do-you-need-programming-knowledge-for-linux/" },
    ],
  },
  {
    title: "ما هي المصادر المفتوحة؟",
    description: "شرح مفصل لمفهوم المصادر المفتوحة، كيف نشأت، ولماذا غيّرت وجهة صناعة البرمجيات في العالم.",
    href: "/wiki/what-is-open-source/",
    icon: "fa-solid fa-code-branch",
    links: [
      { label: "أشهر مكتبات المصادر المفتوحة", href: "/wiki/open-source-libraries/" },
    ],
    articles: [
      { label: "الفرق بين البرامج مفتوحة المصدر والبرامج المغلقة", href: "/posts/open-source-vs-proprietary-software/" },
      { label: "أفضل محررات الأكواد مفتوحة المصدر", href: "/posts/best-open-source-code-editors/" },
    ],
  },
  {
    title: "الحوسبة السحابية",
    description: "دليل شامل عن الحوسبة السحابية: التعريف، نماذج الخدمات، المزودون الرئيسيون، الفوائد والتحديات، وأمثلة عملية.",
    href: "/wiki/cloud-computing/",
    icon: "fa-solid fa-cloud",
  },
  {
    title: "أساسيات البرمجة",
    description: "دليلك الشامل لبدء رحلتك في عالم البرمجة: المفاهيم الأساسية من المتغيرات والشروط إلى البرمجة الكائنية وقواعد البيانات.",
    href: "/wiki/programming-fundamentals/",
    icon: "fa-solid fa-code",
    links: [
      { label: "البرمجة الكائنية التوجيهية", href: "/wiki/object-oriented-programming/" },
    ],
    articles: [
      { label: "أفضل 10 لغات برمجة مفتوحة المصدر", href: "/posts/best-10-open-source-programming-languages/" },
      { label: "لغة بايثون: دليل شامل", href: "/posts/python-open-source-complete-guide/" },
      { label: "أفضل محررات الأكواد مفتوحة المصدر", href: "/posts/best-open-source-code-editors/" },
      { label: "أفضل منصات تعلم البرمجة بالعربية", href: "/posts/best-arabic-programming-learning-platforms/" },
    ],
  },
];
---

<BaseLayout
  title="الموسوعة — مصدر إكس"
  description="موسوعة مصدر إكس: دليلك الشامل لعالم تقنية المعلومات والبرمجيات والمصادر المفتوحة."
  keywords={["موسوعة", "ويكي", "تقنية معلومات", "برمجيات", "مصادر مفتوحة", "لينكس"]}
  canonical="/wiki/"
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <nav class="mb-6 text-sm font-body text-navy-400 dark:text-zinc-500">
      <a href="/" class="hover:text-accent dark:hover:text-white transition-colors no-underline"
        >الرئيسية</a
      >
      <span class="mx-2">/</span>
      <span class="text-navy dark:text-white">الموسوعة</span>
    </nav>

    <h1
      class="font-heading text-3xl sm:text-4xl font-extrabold text-navy dark:text-white mb-4 leading-snug"
    >
      موسوعة مصدر إكس
    </h1>
    <p>
      موسوعة شاملة عن عالم تقنية المعلومات والبرمجيات والمصادر المفتوحة. هنا تجد
      أدلة مفصّلة وشروحات مبسّطة تساعدك على فهم المفاهيم الأساسية والتعمّق في
      التقنيات الحديثة.
    </p>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        wikiPages.map((page) => (
          <div class="p-6 bg-white dark:bg-zinc-800 border border-navy-100 dark:border-zinc-700 rounded-xl no-underline hover:border-accent dark:hover:border-accent transition-colors group">
            <a href={page.href} class="block no-underline">
              <div class="flex items-center gap-3 mb-3">
                <i class={`${page.icon} text-2xl text-navy dark:text-white`} />
                <h2 class="font-heading text-xl font-bold text-navy dark:text-white group-hover:text-accent transition-colors">
                  {page.title}
                </h2>
              </div>
              <p>
                {page.description}
              </p>
            </a>
            {page.links && page.links.length > 0 && (
              <ul class="mt-4 pt-4 border-t border-navy-100 dark:border-zinc-700 space-y-2">
                {page.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-lg font-body text-navy-600 dark:text-zinc-400 hover:text-accent dark:hover:text-accent transition-colors no-underline flex items-center gap-2"
                    >
                      <i class="fa-solid fa-link text-xs" />
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            {page.articles && page.articles.length > 0 && (
              <div class="mt-4 pt-4 border-t border-navy-100 dark:border-zinc-700">
                <p class="text-base font-heading font-bold text-navy dark:text-white mb-2">مقالات متعلقة</p>
                <ul class="space-y-2">
                  {page.articles.map((article) => (
                    <li>
                      <a
                        href={article.href}
                        class="text-base font-body text-navy-600 dark:text-zinc-400 hover:text-accent dark:hover:text-accent transition-colors no-underline flex items-center gap-2"
                      >
                        <i class="fa-solid fa-file-lines text-sm" />
                        {article.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-12 p-6 bg-navy-50 dark:bg-zinc-800/50 border border-navy-200 dark:border-zinc-700 rounded-xl">
      <h2 class="font-heading text-xl font-bold text-navy dark:text-white mb-3">
        <i class="fa-solid fa-circle-info text-navy dark:text-white ml-2" />
        عن هذه الموسوعة
      </h2>
      <p>
        موسوعة مصدر إكس هي مشروع مفتوح المصدر يهدف إلى تقديم محتوى عربي شامل
        وموثوق في مجالات التقنية والبرمجيات. جميع المقالات مكتوبة بأسلوب مبسّط
        ومناسب للمبتدئين والمحترفين على حد سواء. إذا كنت ترغب في المساهمة أو
        اقتراح موضوع جديد، لا تتردد في التواصل معنا عبر
        <a href="/contact/"><strong>صفحة الاتصال</strong></a>.
      </p>
    </div>
  </article>
</BaseLayout>
