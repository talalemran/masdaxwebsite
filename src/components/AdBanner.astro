---
import { ads } from "@/data/ads";

const randomIndex = Math.floor(Math.random() * ads.length);
const ad = ads[randomIndex];
---

<div class="my-8 flex justify-center">
    <div class="w-full max-w-3xl">
        <h2 class="text-center">فاصل اعلاني</h2>
        <a
            href={ad.link}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="block rounded-xl overflow-hidden transition-colors no-underline group"
        >
            <img
                src={ad.banner}
                alt={ad.title}
                width="728"
                height=auto
                class="w-full h-auto mx-auto"
                loading="lazy"
            />
        </a>
        <div class="p-4 text-center">
            <h3>
                {ad.title}
            </h3>
            <p>
                {ad.description}
            </p>
            <p>
                <a
                    href={ad.link}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                >
                    تصفح العرض
                </a>
            </p>
        </div>
    </div>
</div>
