---
import { ads } from "@/data/ads";

const ad = ads[0];
---

<div class="my-8">
    <h2>فاصل اعلاني</h2>
    <a
        href={ad.link}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block rounded-xl overflow-hidden transition-colors no-underline group"
    >
        <img
            src={ad.banner}
            alt={ad.title}
            width="728"
            height="180"
            class="w-full h-auto"
            loading="lazy"
        />
    </a>
    <div class="p-4">
        <h3>
            {ad.title}
        </h3>
        <p>
            {ad.description}
        </p>
        <p>
            <a
                href={ad.link}
                target="_blank"
                rel="noopener noreferrer sponsored"
            >
                تصفح العرض
            </a>
        </p>
    </div>
</div>
