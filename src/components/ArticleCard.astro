---
import TagBadge from "./TagBadge.astro";

export interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  date: string;
  tags: string[];
  slug: string;
  thumbnail?: string;
}

const {
  title,
  description,
  category,
  author,
  date,
  tags,
  slug,
  thumbnail,
} = Astro.props;

const categories = Array.isArray(category) ? category : [category];
---

<article class="relative bg-white dark:bg-[#0C0C0C] rounded-lg shadow-sm border border-navy-100/50 dark:border-zinc-800 overflow-hidden transition-shadow hover:shadow-glow hover:border-accent/50">
  <a href={`/posts/${slug}/`} class="absolute inset-0 z-0 no-underline" aria-label={title}></a>
  {
    thumbnail && (
      <div class="bg-navy-50 dark:bg-zinc-800 overflow-hidden">
        <img
          src={thumbnail}
          alt={title}
          width="400"
          height="225"
          class="w-full h-auto"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="p-4 sm:p-5 relative z-10">
    <div class="flex flex-wrap gap-2 mb-3">
      {categories.map((cat) => (
        <a
          href={`/category/${cat}/`}
          class="inline-block px-3 py-1 text-xs font-bold font-heading text-white bg-navy rounded-full hover:bg-accent hover:text-navy dark:hover:bg-zinc-600 transition-colors no-underline"
        >
          {cat}
        </a>
      ))}
    </div>

    <a
      href={`/posts/${slug}/`}
      class="block no-underline group/title"
    >
      <h3 class="font-heading text-lg font-bold text-navy dark:text-white mb-2 leading-snug group-hover/title:text-accent dark:group-hover/title:text-zinc-300 transition-colors">
        {title}
      </h3>
    </a>

    <p class="font-body text-sm text-navy-600 dark:text-zinc-400 leading-relaxed mb-3 line-clamp-2">
      {description}
    </p>

    <div class="flex items-center gap-2 text-xs text-navy-400 dark:text-zinc-500 font-body mb-3">
      <a
        href={`/author/${author}/`}
        class="hover:text-navy dark:hover:text-accent transition-colors no-underline text-navy-400 dark:text-zinc-400"
      >
        {author}
      </a>
      <span>•</span>
      <span>{date}</span>
    </div>

    <div class="flex flex-wrap gap-1.5">
      {tags.slice(0, 3).map((tag) => (
        <TagBadge tag={tag} href={`/tags/${tag}/`} />
      ))}
    </div>
  </div>
</article>
