---
export interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      class="inline-block px-3 py-1 text-xs font-medium font-body bg-navy-50 dark:bg-zinc-800 text-navy-600 dark:text-zinc-300 rounded-full hover:bg-accent/20 dark:hover:bg-zinc-700 transition-colors no-underline"
    >
      {tag}
    </a>
  ) : (
    <span class="inline-block px-3 py-1 text-xs font-medium font-body bg-navy-50 dark:bg-zinc-800 text-navy-600 dark:text-zinc-300 rounded-full">
      {tag}
    </span>
  )
}
