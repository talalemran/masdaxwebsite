---
export interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string;
}

const { currentPage, totalPages, basePath = "/page" } = Astro.props;

function href(p: number): string {
  if (p === 1) {
    const parts = basePath.split("/page");
    return parts[0] + "/";
  }
  return `${basePath}/${p}/`;
}
---

<nav class="flex flex-wrap justify-center items-center gap-2 mt-10 overflow-x-auto" aria-label="التصفح">
  <!-- Previous -->
  <a
    href={currentPage > 1 ? href(currentPage - 1) : undefined}
    class={`px-2 py-0.5 text-[0.75rem] font-body font-medium rounded-lg transition-colors no-underline ${
      currentPage <= 1
        ? "text-navy-200 dark:text-zinc-600 pointer-events-none"
        : "text-navy dark:text-zinc-300 hover:bg-navy-50 dark:hover:bg-zinc-800"
    }`}
    aria-disabled={currentPage <= 1}
  >
    &larr; السابق
  </a>

  <!-- Page Numbers -->
  {
    Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
      <a
        href={href(p)}
        class={`px-1 py-0.5 text-[0.75rem] font-body font-medium rounded-lg transition-colors no-underline ${
          p === currentPage
            ? "bg-navy text-white dark:bg-zinc-200 dark:text-zinc-900"
            : "text-navy dark:text-zinc-300 hover:bg-navy-50 dark:hover:bg-zinc-800"
        }`}
      >
        {p}
      </a>
    ))
  }

  <!-- Next -->
  <a
    href={currentPage < totalPages ? href(currentPage + 1) : undefined}
    class={`px-2 py-0.5 text-[0.75rem] font-body font-medium rounded-lg transition-colors no-underline ${
      currentPage >= totalPages
        ? "text-navy-200 dark:text-zinc-600 pointer-events-none"
        : "text-navy dark:text-zinc-300 hover:bg-navy-50 dark:hover:bg-zinc-800"
    }`}
    aria-disabled={currentPage >= totalPages}
  >
    التالي &rarr;
  </a>
</nav>
